-panocularai/following{/other_user}","gists_url":"https://api.github.com/users/branden-panocularai/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/branden-panocularai","id":297978903,"login":"branden-panocularai","node_id":"U_kgDOEcLMFw","organizations_url":"https://api.github.com/users/branden-panocularai/orgs","received_events_url":"https://api.github.com/users/branden-panocularai/received_events","repos_url":"https://api.github.com/users/branden-panocularai/repos","site_admin":false,"starred_url":"https://api.github.com/users/branden-panocularai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/branden-panocularai/subscriptions","type":"User","url":"https://api.github.com/users/branden-panocularai","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-06-30T16:31:09Z","event":"labeled","id":27388725516,"intent":null,"label":{"color":"d73a4a","name":"bug 🐞"},"node_id":"LE_lADODGgK6M8AAAABHNQHyc8AAAAGYH7JDA","performed_via_github_app":null,"url":"https://api.github.com/repos/iree-org/iree/issues/events/27388725516"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/297978903?v=4","events_url":"https://api.github.com/users/branden-panocularai/events{/privacy}","followers_url":"https://api.github.com/users/branden-panocularai/followers","following_url":"https://api.github.com/users/branden-panocularai/following{/other_user}","gists_url":"https://api.github.com/users/branden-panocularai/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/branden-panocularai","id":297978903,"login":"branden-panocularai","node_id":"U_kgDOEcLMFw","organizations_url":"https://api.github.com/users/branden-panocularai/orgs","received_events_url":"https://api.github.com/users/branden-panocularai/received_events","repos_url":"https://api.github.com/users/branden-panocularai/repos","site_admin":false,"starred_url":"https://api.github.com/users/branden-panocularai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/branden-panocularai/subscriptions","type":"User","url":"https://api.github.com/users/branden-panocularai","user_view_type":"public"},"created_at":"2026-07-17T20:28:07Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"NONE","body":"This PR fixes a divergence between the CUDA compiler plugin and the CUDA HAL driver in how export names are stored and looked up. As shown in #24653 the compiler plugin sanitizes the kernel names to match PTX restrictions, while the runtime does a direct string equality check. This PR corrects that divergence by adding a small utility function to perform the same sanitization runtime-side. However, this means there are two different codepaths performing sanitization that may become desynced. Another idea I had was to add some metadata to the flatbuffer mapping export names to kernel names, but I have not yet looked too deep into how that would work.\r\n\r\nAs this is my first PR here, I would appreciate some guidance on how to proceed. I fully intend to add tests for this bug but would like to know whether this solution is good enough or if the IREE developers would prefer a different solution.","closed_at":"2026-09-11T12:14:11Z","comments":5,"comments_url":"https://api.github.com/repos/iree-org/iree/issues/24718/comments","created_at":"2026-07-17T20:28:06Z","draft":true,"events_url":"https://api.github.com/repos/iree-org/iree/issues/24718/events","html_url":"https://github.com/iree-org/iree/pull/24718","id":4914575874,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/iree-org/iree/issues/24718/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDODGgK6M7zJE02","number":24718,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/iree-org/iree/pull/24718.diff","html_url":"https://github.com/iree-org/iree/pull/24718","merged_at":null,"patch_url":"https://github.com/