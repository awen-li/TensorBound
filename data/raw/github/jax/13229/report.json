ke/received_events","repos_url":"https://api.github.com/users/apaszke/repos","site_admin":false,"starred_url":"https://api.github.com/users/apaszke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apaszke/subscriptions","type":"User","url":"https://api.github.com/users/apaszke","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/4583066?v=4","events_url":"https://api.github.com/users/apaszke/events{/privacy}","followers_url":"https://api.github.com/users/apaszke/followers","following_url":"https://api.github.com/users/apaszke/following{/other_user}","gists_url":"https://api.github.com/users/apaszke/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apaszke","id":4583066,"login":"apaszke","node_id":"MDQ6VXNlcjQ1ODMwNjY=","organizations_url":"https://api.github.com/users/apaszke/orgs","received_events_url":"https://api.github.com/users/apaszke/received_events","repos_url":"https://api.github.com/users/apaszke/repos","site_admin":false,"starred_url":"https://api.github.com/users/apaszke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apaszke/subscriptions","type":"User","url":"https://api.github.com/users/apaszke","user_view_type":"public"}],"author_association":"NONE","body":"### Description\n\nI have a simple script below that uses `xmap` to initialize a set of weights, and return them. \r\n\r\nI would expect that it should be `out_axes=('model', ...)` since the input `rng` (which is used to init the weights) is also sharded across the `model` axis, but the code also seems to run smoothly if I set `out_axes=(...,)` and it seems to just return the corresponding weight at index 0 (along the `model` axis) even though the weight is different along each model shard.\r\n\r\nUsually if I set `out_axes=(...,)` incorrectly when the output has not been reduced along an axis (e.g. through `pmean`, `psum`, etc), it throws an error - but it doesn't seem to in this case. Is this on purpose or is this a bug?\r\n\r\nThis was tested on a `v3-8` with `tpu-vm-base`\r\n\r\n```python\r\nimport numpy as np\r\nimport flax.linen as nn\r\nimport jax\r\nimport jax.numpy as jnp\r\nfrom jax.experimental.maps import xmap, Mesh\r\nimport flax\r\n\r\n\r\nclass Model(nn.Module):\r\n    @nn.compact\r\n    def __call__(self, x):\r\n        w = self.param('weight', nn.initializers.normal(), [x.shape[-1], 2], jnp.float32)\r\n        x = x @ w\r\n        return jnp.mean(x ** 2)\r\n\r\nnum_shards = 2\r\ndevices = np.array(jax.devices()).reshape(jax.device_count() // num_shards, num_shards)\r\nmesh = Mesh(devices, ['dp', 'mp'])\r\n\r\nx = np.random.randn(1, 1)\r\nrngs = jax.random.split(jax.random.PRNGKey(0), num_shards)\r\nmodel = Model()\r\n\r\ndef init(rng, x):\r\n    variables = model.init(\r\n        {'params': rng},\r\n        x,\r\n    ).unfreeze()\r\n    params = variables.pop('params')\r\n    return params, params\r\n\r\np_init = xmap(\r\n    init,\r\n    in_axes=(('model', ...), (...,)),\r\n    out_axes=(('model', ...), (...,)),\r\n    axis_resources={'model': 'mp'}\r\n)\r\n\r\nwith mesh:\r\n    params_sharded, params = p_init(rngs, x)\r\nprint('return sharded:', jax.device_get(params_sharded['weight']))\r\nprint('return not sharded:', jax.device_get(params['weight']))\r\n```\r\n\r\nExample output:\r\n```\r\nreturn sharded: [[[-0.01583592 -0.00883907]]\r\n\r\n [[-0.00255863  0.01448902]]\r\n\r\n [[-0.00728441  0.00094846]]\r\n\r\n [[ 0.00259233  0.00254223]]]\r\nreturn not sharded: [[-0.01583592 -0.00883907]]\r\n```\r\nWeights are different along each model index, but the not sharded only selects the 0th index one.\n\n### What jax/jaxlib version are you using?\n\n`jax==0.3.24`, `jaxlib==0.3.24`, `libtpu-nightly==0.1.dev20221103`, `flax==0.6.1`\n\n### Which accelerator(s) are you using?\n\nTPU\n\n### Additional system info\n\n_No response_\n\n### NVIDIA GPU info\n\n_No response_","closed_at":"2024-07-30T11:44:13Z","closed_by":{"avatar_url":"https://av