":"https://api.github.com/users/justinjfu/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/justinjfu","id":5401540,"login":"justinjfu","node_id":"MDQ6VXNlcjU0MDE1NDA=","organizations_url":"https://api.github.com/users/justinjfu/orgs","received_events_url":"https://api.github.com/users/justinjfu/received_events","repos_url":"https://api.github.com/users/justinjfu/repos","site_admin":false,"starred_url":"https://api.github.com/users/justinjfu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinjfu/subscriptions","type":"User","url":"https://api.github.com/users/justinjfu","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2025-08-28T19:31:53Z","event":"assigned","id":19398332693,"intent":null,"node_id":"AE_lADOCTkjjc7IWJatzwAAAASEOxEV","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/19398332693"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/5401540?v=4","events_url":"https://api.github.com/users/justinjfu/events{/privacy}","followers_url":"https://api.github.com/users/justinjfu/followers","following_url":"https://api.github.com/users/justinjfu/following{/other_user}","gists_url":"https://api.github.com/users/justinjfu/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/justinjfu","id":5401540,"login":"justinjfu","node_id":"MDQ6VXNlcjU0MDE1NDA=","organizations_url":"https://api.github.com/users/justinjfu/orgs","received_events_url":"https://api.github.com/users/justinjfu/received_events","repos_url":"https://api.github.com/users/justinjfu/repos","site_admin":false,"starred_url":"https://api.github.com/users/justinjfu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinjfu/subscriptions","type":"User","url":"https://api.github.com/users/justinjfu","user_view_type":"public"},"author_association":"COLLABORATOR","body":"The index map in your kernel is out-of-bounds. It should return `(i, 0)` instead of `(i * bq, 0)`. \n\nThe reason that NaNs are appearing is that when XLA's [DynamicSlice](https://openxla.org/xla/operation_semantics#dynamicslice) out of bounds, it will clamp the slice so that it is in-bounds. Since all of the blocks are out of bounds except for the first iteration, they will all get clamped to the last block, so only the first and last blocks in the output get updated. The remaining blocks in the middle are not written to, so they keep their default uninitialized value (NaN).","created_at":"2025-08-28T19:40:12Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/31395#issuecomment-3234723631","id":3234723631,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/31395","minimized":null,"node_id":"IC_kwDOCTkjjc7Azfcv","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3234723631/reactions"},"updated_at":"2025-08-28T19:40:39Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3234723631","user":{"avatar_url":"https://avatars.githubusercontent.com/u/5401540?v=4","events_url":"https://api.github.com/users/justinjfu/events{/privacy}","followers_url":"https://api.github.com/users/justinjfu/followers","following_url":"https://api.github.com/users/justinjfu/following{/other_user}","gists_url":"https://api.github.com/users/justinjfu/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/justinjfu","id":5401540,"login":"justinjfu","node_id":"MDQ6VXNlcjU0MDE1NDA=","organizations_url":"https://api.github.com/users/justinjfu/orgs","received_events_url":"https://api.github.com/users/justinjfu/received_events","repos_url":"https://api.github.com/users/justinjfu/repos","site_admin":false,"starred_url":"https://api.github.com/users/justinjfu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinjfu/subscriptions","type":"User","url":"