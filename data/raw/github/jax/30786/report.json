with_integer_labels(preds, labels))\n\n\n# 4. 定义优化器\noptimizer = optax.adam(1e-3)\n\n\n# 5. 数据并行训练步骤\n@partial(pmap, axis_name='batch')\ndef train_step(params, opt_state, batch):\n    inputs, labels = batch\n\n    # 计算梯度和损失\n    def step(params, inputs, labels):\n        loss, grads = jax.value_and_grad(loss_fn)(params, (inputs, labels))\n        return loss, grads\n\n    loss, grads = step(params, inputs, labels)\n\n    # 多卡梯度聚合\n    grads = lax.pmean(grads, axis_name='batch')\n\n    # 更新参数\n    updates, opt_state = optimizer.update(grads, opt_state)\n    params = optax.apply_updates(params, updates)\n    return params, opt_state, loss\n\n\n# 6. 主训练流程\ndef train():\n    # 初始化\n    key = random.PRNGKey(0)\n    params = init_model(key)\n\n    # 初始化优化器状态\n    opt_state = optimizer.init(params)\n\n    # JAX 0.7.0 的参数复制方式\n    def replicate(tree):\n        return jax.tree.map(lambda x: jnp.array([x] * num_devices), tree)\n\n    replicated_params = replicate(params)\n    replicated_opt_state = replicate(opt_state)\n\n    # 模拟数据加载\n    def get_batch():\n        batch_size = 32\n        key = random.PRNGKey(0)\n        x = random.normal(key, (num_devices, batch_size, 784))\n        y = random.randint(key, (num_devices, batch_size), 0, 10)\n        return x, y\n\n    # 训练循环\n    for step in range(100):\n        batch = get_batch()\n        replicated_params, replicated_opt_state, loss = train_step(\n            replicated_params, replicated_opt_state, batch\n        )\n        if step % 10 == 0:\n            # JAX 0.7.0 的 device_get 方式\n            print(f\"Step {step}, Loss: {loss[0]:.4f}\")\n\n\nif __name__ == \"__main__\":\n    train()\n```\n\nerror as below:\n```\nE0806 07:42:41.619754    5613 pjrt_stream_executor_client.cc:2939] Execution of replica 0 failed: INTERNAL: NCCL operation ncclGroupEnd() failed: unhandled cuda error (run with NCCL_DEBUG=INFO for details). Last NCCL warning(error) log entry (may be unrelated) 'Cuda failure 'an illegal memory access was encountered''.\nE0806 07:42:41.620149    5622 pjrt_stream_executor_client.cc:2939] Execution of replica 3 failed: INTERNAL: NCCL operation ncclGroupEnd() failed: unhandled cuda error (run with NCCL_DEBUG=INFO for details). Last NCCL warning(error) log entry (may be unrelated) 'Cuda failure 'an illegal memory access was encountered''.\nF0806 07:42:51.619962    5148 pjrt_stream_executor_client.cc:3120] Replicated computation launch failed, but not all replicas terminated. Aborting process to work around deadlock. Failure message (there may have been multiple failures, see the error log for all failures): \n\nNCCL operation ncclGroupEnd() failed: unhandled cuda error (run with NCCL_DEBUG=INFO for details). Last NCCL warning(error) log entry (may be unrelated) 'Cuda failure 'an illegal memory access was encountered''.\n*** Check failure stack trace: ***\n    @     0x742e4c22e5c4  absl::lts_20250127::log_internal::LogMessage::SendToLog()\n    @     0x742e4c22e396  absl::lts_20250127::log_internal::LogMessage::Flush()\n    @     0x742e4c22ea39  absl::lts_20250127::log_internal::LogMessageFatal::~LogMessageFatal()\n    @     0x742e43e1f4cd  xla::PjRtStreamExecutorLoadedExecutable::Execute()\n    @     0x742e43d889e3  pjrt::PJRT_LoadedExecutable_Execute()\n    @     0x74311060c146  xla::PjRtCApiLoadedExecutable::Execute()\n    @     0x7431170b0efb  xla::ifrt::PjRtLoadedExecutable::Execute()\n    @     0x743116b22fe1  xla::PyLoadedExecutable::ExecuteSharded()\n    @     0x74310ff58a95  xla::ValueOrThrowWrapper<>::operator()()\n    @     0x74310ff586ed  nanobind::detail::func_create<>()::{lambda()#1}::__invoke()\n    @     0x74311706dd88  nanobind::detail::nb_func_vectorcall_complex()\n    @           0x51e131  PyObject_Vectorcall\nAborted (core dumped)\n```\n### System info (python version, jaxlib version, accelerator, etc.)\n\n| NVIDIA-SMI 570.153.02             Driver Version: 570.153.02     CUDA Version: 12.8     |\n|-----------------------------------------+-------------------