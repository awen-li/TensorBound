.com/users/powderluv/gists{/gist_id}","starred_url":"https://api.github.com/users/powderluv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/powderluv/subscriptions","organizations_url":"https://api.github.com/users/powderluv/orgs","repos_url":"https://api.github.com/users/powderluv/repos","events_url":"https://api.github.com/users/powderluv/events{/privacy}","received_events_url":"https://api.github.com/users/powderluv/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-02-10T20:38:02Z","updated_at":"2023-02-10T20:38:02Z","body":"One end is unable to recreate the issue with running with iree-benchmark-module. Will keep trying to narrow down. ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1426319133/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1459755795","html_url":"https://github.com/iree-org/iree/issues/12122#issuecomment-1459755795","issue_url":"https://api.github.com/repos/iree-org/iree/issues/12122","id":1459755795,"node_id":"IC_kwDODGgK6M5XAhsT","user":{"login":"paperplanet","id":4402083,"node_id":"MDQ6VXNlcjQ0MDIwODM=","avatar_url":"https://avatars.githubusercontent.com/u/4402083?v=4","gravatar_id":"","url":"https://api.github.com/users/paperplanet","html_url":"https://github.com/paperplanet","followers_url":"https://api.github.com/users/paperplanet/followers","following_url":"https://api.github.com/users/paperplanet/following{/other_user}","gists_url":"https://api.github.com/users/paperplanet/gists{/gist_id}","starred_url":"https://api.github.com/users/paperplanet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/paperplanet/subscriptions","organizations_url":"https://api.github.com/users/paperplanet/orgs","repos_url":"https://api.github.com/users/paperplanet/repos","events_url":"https://api.github.com/users/paperplanet/events{/privacy}","received_events_url":"https://api.github.com/users/paperplanet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-08T08:44:52Z","updated_at":"2023-03-08T08:45:23Z","body":"I have encountered this same semaphore overflow error when running vae model with nvidia rtx3050 through vulkan api on windows. And after some trial, I managed to workround this issue by adding `--vulkan_dedicated_compute_queue=1` parameter in iree-run-module arguments. My final command becomes: `iree-run-module --module=vae77_512_512_fp16_stabilityai_stable_diffusion_2_1_base.vmfb --function=forward --device=vulkan --input=1x4x64x64xf16 --vulkan_dedicated_compute_queue=1 --output=@vae_o0.npy`. Hope that information can help.\r\n`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1459755795/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1460201163","html_url":"https://github.com/iree-org/iree/issues/12122#issuecomment-1460201163","issue_url":"https://api.github.com/repos/iree-org/iree/issues/12122","id":1460201163,"node_id":"IC_kwDODGgK6M5XCObL","user":{"login":"powderluv","id":74956,"node_id":"MDQ6VXNlcjc0OTU2","avatar_url":"https://avatars.githubusercontent.com/u/74956?v=4","gravatar_id":"","url":"https://api.github.com/users/powderluv","html_url":"https://github.com/powderluv","followers_url":"https://api.github.com/users/powderluv/followers","following_url":"https://api.github.com/users/powderluv/following{/other_user}","gists_url":"https://api.github.com/users/powderluv/gists{/gist_id}","starred_url":"https://api.github.com/users/powderluv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/powderluv/subscriptions","organizations_url":"https://api.github.com/users/powderluv/orgs","repos_url":"https://api.github.com/users/powderluv/repos","events_url":"https://api.github.com/users/powderluv/events{/privacy}","received_events_url":"https://api.github.com/users/powderluv/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-08T14:02:17Z","updated_at":"2023-03-08T14:02:17Z","body":"Thank you for the workaround is there any performance impact with that flag?","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1460201163/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1460354528","html_url":"https://github.com/iree-org/iree/issues/12122#issuecomment-1460354528","issue_url":"https://api.github.com/repos/iree-org/iree/issues/12122","id":1460354528,"node_id":"IC_kwDODGgK6M5XCz3g","user":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-08T15:40:09Z","updated_at":"2023-03-08T15:40:09Z","body":"I believe we originally had this on but disabled it and started using the graphics queue due to performance issues on AMD you found. I suspect this is helping here because the compute queue can run longer tasks than the graphics queue (no need for canceling the work in order to avoid the GUI from janking). We'd need someone to do some benchmarking across vendors and device family to see what we should make the default - if only AMD benefits from the graphics queue but not ARM/Nvidia/etc then we could limit it to there. That said, it'd be good to get confirmation from any vendor this is what's happening (compute queue has higher timeout allowances).","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1460354528/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1462259745","html_url":"https://github.com/iree-org/iree/issues/12122#issuecomment-1462259745","issue_url":"https://api.github.com/repos/iree-org/iree/issues/12122","id":1462259745,"node_id":"IC_kwDODGgK6M5XKFAh","user":{"login":"paperplanet","id":4402083,"node_id":"MDQ6VXNlcjQ0MDIwODM=","avatar_url":"https://avatars.githubusercontent.com/u/4402083?v=4","gravatar_id":"","url":"https://api.github.com/users/paperplanet","html_url":"https://github.com/paperplanet","followers_url":"https://api.github.com/users/paperplanet/followers","following_url":"https://api.github.com/users/paperplanet/following{/other_user}","gists_url":"https://api.github.com/users/paperplanet/gists{/gist_id}","starred_url":"https://api.github.com/users/paperplanet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/paperplanet/subscriptions"