b.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-20T17:15:43Z","updated_at":"2022-09-20T17:15:43Z","body":"That's for the inside of command buffers only and only execution barriers - the device queue operations are where fences/semaphores are - ensure your device.c file doesn't have \"// TODO: implement\" in the queue methods and that wait/signal semaphore lists are handled (iree_hal_semaphore_list_wait on waits, iree_hal_semaphore_list_signal on signals).","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252659773/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252678252","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1252678252","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1252678252,"node_id":"IC_kwDODGgK6M5Kqlps","user":{"login":"raikonenfnu","id":68087699,"node_id":"MDQ6VXNlcjY4MDg3Njk5","avatar_url":"https://avatars.githubusercontent.com/u/68087699?v=4","gravatar_id":"","url":"https://api.github.com/users/raikonenfnu","html_url":"https://github.com/raikonenfnu","followers_url":"https://api.github.com/users/raikonenfnu/followers","following_url":"https://api.github.com/users/raikonenfnu/following{/other_user}","gists_url":"https://api.github.com/users/raikonenfnu/gists{/gist_id}","starred_url":"https://api.github.com/users/raikonenfnu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raikonenfnu/subscriptions","organizations_url":"https://api.github.com/users/raikonenfnu/orgs","repos_url":"https://api.github.com/users/raikonenfnu/repos","events_url":"https://api.github.com/users/raikonenfnu/events{/privacy}","received_events_url":"https://api.github.com/users/raikonenfnu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-20T17:26:50Z","updated_at":"2022-09-20T17:26:50Z","body":"@benvanik unfortunately I was able to find iree_hal_semaphore_list_wait on waits, iree_hal_semaphore_list_signal on the queue method. I was wondering if after this change(hiding semaphore), we would need the a device-based semaphore implemented since, since right now it's following cuda's semaphore which seems to be basically from host and using IREE apis such as `iree_hal_semaphore_poll` and `iree_atomic_load_int64`?","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252678252/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252679738","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1252679738","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1252679738,"node_id":"IC_kwDODGgK6M5KqmA6","user":{"login":"raikonenfnu","id":68087699,"node_id":"MDQ6VXNlcjY4MDg3Njk5","avatar_url":"https://avatars.githubusercontent.com/u/68087699?v=4","gravatar_id":"","url":"https://api.github.com/users/raikonenfnu","html_url":"https://github.com/raikonenfnu","followers_url":"https://api.github.com/users/raikonenfnu/followers","following_url":"https://api.github.com/users/raikonenfnu/following{/other_user}","gists_url":"https://api.github.com/users/raikonenfnu/gists{/gist_id}","starred_url":"https://api.github.com/users/raikonenfnu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raikonenfnu/subscriptions","organizations_url":"https://api.github.com/users/raikonenfnu/orgs","repos_url":"https://api.github.com/users/raikonenfnu/repos","events_url":"https://api.github.com/users/raikonenfnu/events{/privacy}","received_events_url":"https://api.github.com/users/raikonenfnu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-20T17:28:13Z","updated_at":"2022-09-20T17:28:13Z","body":"would you also happen to know a good pass to check the dumps/ir after to compare the difference between hiding and no hiding semaphores? :)\r\n","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252679738/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252714355","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1252714355","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1252714355,"node_id":"IC_kwDODGgK6M5Kqudz","user":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-20T17:59:47Z","updated_at":"2022-09-20T17:59:47Z","body":"There should have been no material changes from that change in a correctly operating backend in legacy_sync mode so I'm not sure looking at IR will help much, but if you look before/after createFixupLegacySyncPass (or the canonicalize after it) you'll see the intended execution ordering and the actual one you should see at runtime. Effectively the only difference at runtime is that instead of a single shared semaphore that has its value incremented repeatedly now there's a unique semaphore per submission and it only transitions 0->1.\r\n\r\nCUDA's semaphores were never fully implemented - poll and atomic ints are not the right way to implement them and only work because of the \"TODO: remove me\" host/device synchronization calls that are sprinkled around. I've still got a little reworking to do to simplify HAL synchronization (possibly removing semaphores entirely and just treating fences as events) but what's in the CUDA impl today should be sufficient with legacy_sync. I honestly have no idea how many assumptions the entirety of the backend is making about it not running asynchronously and how to manage that. I expect nearly all of it to be rewritten when it actually migrates to async (and the legacy_sync flag is dropped).\r\n\r\nYour next step is to add printfs or verify your backend matches CUDA with respect to all of the places it synchronizes including those implicit to the CUDA API that are being relied upon. That the CUDA backend wasn't finished and made async to the old way of doing things means it's currently held together by implicit assumptions founded on TODOs and if any of your semantics differ it's unlikely to work.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252714355/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252725546","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1252725546","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1252725546,"node_id":"IC_kwDODGgK6M5KqxMq","user":{"login":"raikonenfnu","id":68087699,"node_id":"MDQ6VXNlcjY4MDg3Njk5","avatar_url":"https://avatars.githubusercontent.com/u/68087699?v=4","gravatar_id":"","url":"https://api.github.com/users/raikonenfnu","html_url":"https://github.com/raikonenfnu","followers_url":"https://api.github.com/users/raikonenfnu/followers","following_url":"https://api.github.com/users/raikonenfnu/following{/other_user}","gists_url":"https://api.github.com/users/raikonenfnu/gists{/gist_id}","starred_url":"https://api.github.com/users/raikonenfnu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raikonenfnu/subscriptions","organizations_url":"https://api.github.com/users/raikonenfnu/orgs","repos_url":"https://api.github.com/users/raikonenfnu/repos","events_url":"https://api.github.com/users/raikonenfnu/events{/privacy}","received_events_url":"https://api.github.com/users/raikonenfnu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-20T18:09:23Z","updated_at":"2022-09-20T18:09:23Z","body":"I see, thanks for the explanation Ben. Also fwiw, to expand upon your mention of semantic and assumptions difference between L0 and cuda, we needed to add the execution_barrier manually for L0. \r\n\r\nI was wondering for\r\n```\r\nYour next step is to add printfs or verify your backend matches CUDA with respect to all of the places it synchronizes including those implicit to the CUDA API that are being relied upon\r\n```\r\ndo I just print in execution_barrier and queue_execute and ensure they give the same print order and quantity? ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252725546/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1255435370","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1255435370","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1255435370,"node_id":"IC_kwDODGgK6M5K1Gxq","user":{"login":"raikonenfnu","id":68087699,"node_id":"MDQ6VXNlcjY4MDg3Njk5","avatar_url":"https://avatars.githubusercontent.com/u/68087699?v=4","gravatar_id":"","url":"https://api.github.com/users/raikonenfnu","html_url":"https://github.com/raikonenfnu","followers_url":"https://api.github.com/users/raikonenfnu/followers","following_url":"https://api.github.com/users/raikonenfnu/following{/other_user}","gists_url":"https://api.github.com/users/raikonenfnu/gists{/gist_id}","starred_url":"https://api.github.com/users/raikonenfnu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raikonenfnu/subscriptions","organizations_url":"https://api.github.com/users/raikonenfnu/orgs","repos_url":"https://api.github.com/users/raikonenfnu/repos","events_url":"https://api.github.com/users/raikonenfnu/events{/privacy}","received_events_url":"https://api.github.com/users/raikonenfnu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-22T19:05:32Z","updated_at":"2022-09-22T19:05:32Z","body":"Hey @benvanik printing out the functions in semaphores.c, it seems to confirm what you mentioned earlier about creating a new semaphore and waiting on that one instead of reusing/sharing the same one.\r\nBefore hiding semaphores:\r\n```bash\r\ncreating 0x560025dfa5c0: 0\r\nquery 0x560025dfa5c0: 0\r\nquery 0x560025dfa5c0: 0\r\nwait 0x560025dfa5c0: 0\r\nEXEC @forward\r\nquery 0x560025dfa5c0: 0\r\nquery 0x560025dfa5c0: 0\r\nwait 0x560025dfa5c0: 0\r\nsignalling 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nwait 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nwait 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nquery 0x560025dfa5c0: 2\r\nwait 0x560025dfa5c0: 2\r\n``` \r\n\r\nAfter hiding semaphores:\r\n```bash\r\ncreating 0x55dc3243f0d0: 0\r\nquery 0x55dc3243f0d0: 0\r\nquery 0x55dc3243f0d0: 0\r\nwait 0x55dc3243f0d0: 0\r\nEXEC @forward\r\ncreating 0x55dc32b766b0: 0\r\nquery 0x55dc3243f0d0: 0\r\nquery 0x55dc3243f0d0: 0\r\nwait 0x55dc3243f0d0: 0\r\nsignalling 0x55dc32b766b0: 1\r\nquery 0x55dc32b766b0: 1\r\nquery 0x55dc32b766b0: 1\r\ncreating 0x55dc32af1e40: 0\r\nquery 0x55dc32b766b0: 1\r\nquery 0x55dc32af1e40: 0\r\nquery 0x55dc32af1e40: 0\r\nwait 0x55dc32af1e40: 0\r\ncreating 0x55dc328a85d0: 0\r\nquery 0x55dc32af1e40: 0\r\nquery 0x55dc32af1e40: 0\r\nwait 0x55dc32af1e40: 0\r\nquery 0x55dc328a85d0: 0\r\nquery 0x55dc328a85d0: 0\r\nwait 0x55dc328a85d0: 0\r\n```\r\n\r\nAlthough I was wondering if it is expected for one of the semaphore that was signalled to not have anything waiting on it?\r\nOr if do you think there is something that looks ridiculously wrong? Thanks in advance for the guidance. 🙂 ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1255435370/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1255655808","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1255655808","issue_url":"https://api.github.co