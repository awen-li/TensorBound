tents/README.md?ref=631b15c4066b01975817f8363fc064387676aa33","deletions":1,"filename":"README.md","patch":"@@ -147,7 +147,12 @@ To run this codebase, you need:\n - CUDA 11.1 or higher (can be installed from [here](https://developer.nvidia.com/cuda-11.1.0-download-archive))  \n \n We recommend running all the code below inside a `Linux screen` or any other terminal multiplexer, since some commands can take hours/days to finish and you don't want them to die when you close your terminal.\n-  \n+\n+### Note:\n+\n+- If you're planning on running the JAX implementation, the installed JAX must use exactly the same CUDA and Cudnn versions installed. Our default [Dockerfile](https://github.com/Rayhane-mamah/Efficient-VDVAE/blob/main/build/Dockerfile) assumes the code will run with CUDA 11.4 or newer and should be changed otherwise. For more details, refer to [JAX\n+ installation](https://github.com/google/jax#installation).\n+\n ## Installation  \n   \n To create the docker image used in both the Pytorch and JAX implementations:  ","raw_url":"https://github.com/Rayhane-mamah/Efficient-VDVAE/raw/631b15c4066b01975817f8363fc064387676aa33/README.md","sha":"be05b868d8264d9b1fae5ab16dd174c88e5e8242","status":"modified"},{"additions":8,"blob_url":"https://github.com/Rayhane-mamah/Efficient-VDVAE/blob/631b15c4066b01975817f8363fc064387676aa33/build%2FDockerfile","changes":10,"contents_url":"https://api.github.com/repos/Rayhane-mamah/Efficient-VDVAE/contents/build%2FDockerfile?ref=631b15c4066b01975817f8363fc064387676aa33","deletions":2,"filename":"build/Dockerfile","patch":"@@ -7,8 +7,14 @@ RUN pip install --upgrade git+https://github.com/Rayhane-mamah/hparams\n \n COPY requirements.txt /tmp/requirements.txt\n RUN pip install -r /tmp/requirements.txt\n-#\n-RUN pip install --upgrade \"jax[cuda]\" -f https://storage.googleapis.com/jax-releases/jax_releases.html\n+\n+# Installs the wheel compatible with Cuda >= 11.1 and cudnn >= 8.0.5\n+#pip install jax[cuda11_cudnn805] -f https://storage.googleapis.com/jax-releases/jax_releases.html\n+\n+# Installs the wheel compatible with Cuda >= 11.4 and cudnn >= 8.2\n+RUN pip install jax[cuda11_cudnn82] -f https://storage.googleapis.com/jax-releases/jax_releases.html\n+\n+# Install JAX extensions\n RUN pip install --upgrade optax flax trax\n \n ENV NUMBA_CACHE_DIR /tmp/","raw_url":"https://github.com/Rayhane-mamah/Efficient-VDVAE/raw/631b15c4066b01975817f8363fc064387676aa33/build%2FDockerfile","sha":"127785843b7dfe5bb2f811e81693372b44c05766","status":"modified"}],"html_url":"https://github.com/Rayhane-mamah/Efficient-VDVAE/commit/631b15c4066b01975817f8363fc064387676aa33","node_id":"C_kwDOHDEAPNoAKDYzMWIxNWM0MDY2YjAxOTc1ODE3ZjgzNjNmYzA2NDM4NzY3NmFhMzM","parents":[{"html_url":"https://github.com/Rayhane-mamah/Efficient-VDVAE/commit/cc7fb9bc9a9c7ef7b6e837149940157be2681b2a","sha":"cc7fb9bc9a9c7ef7b6e837149940157be2681b2a","url":"https://api.github.com/repos/Rayhane-mamah/Efficient-VDVAE/commits/cc7fb9bc9a9c7ef7b6e837149940157be2681b2a"}],"sha":"631b15c4066b01975817f8363fc064387676aa33","stats":{"additions":14,"deletions":4,"total":18},"url":"https://api.github.com/repos/Rayhane-mamah/Efficient-VDVAE/commits/631b15c4066b01975817f8363fc064387676aa33"}}],"schema_version":"1.0.0","source_url":"https://github.com/jax-ml/jax/issues/8475"}
