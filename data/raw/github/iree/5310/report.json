.0345993936, -0.144354567], [-0.275278687, -0.072343111], [-0.281624347, -0.299874336]], [[0.277506769, 0.245634913], [-0.0209748745, -0.0196942091], [0.0836308598, 1.507180e-01], [0.284812868, -0.0930951089], [-0.192198485, 0.067567557], [-0.0643128753, 0.0577070415]], [[0.241745412, 0.208432674], [-0.322542399, -0.169554397], [-0.195777908, -0.300730854], [0.312929451, -0.215913534], [0.129433542, 0.154974908], [0.224668384, 0.154421121]]]> : tensor<7x6x2xf32> attributes {sym_visibility = \"private\"}\r\n  flow.variable @\"__iree_flow___sm_node11__models.0.layer-1.bias\" dense<0.000000e+00> : tensor<7x2xf32> attributes {sym_visibility = \"private\"}\r\n  func @LocallyConnected1D__2x8x3__f32__uniform__filters_2__kernel_size_2__strides_1__padding_valid__implementation_1(%arg0: tensor<2x8x3xf32> {tf._user_specified_name = \"args_0\"}) -> tensor<2x7x2xf32> attributes {iree.module.export, iree.reflection = {abi = \"sip\", abiv = 1 : i32, sip = \"I8!S5!k0_0R3!_0\"}, tf._construction_context = \"kEagerRuntime\", tf._input_shapes = [#tf.shape<2x8x3>, #tf.shape<>, #tf.shape<>], tf.signature.is_stateful} {\r\n    %0 = flow.variable.address @\"__iree_flow___sm_node10__models.0.layer-1.kernel\" : !iree.ptr<tensor<7x6x2xf32>>\r\n    %1 = flow.variable.address @\"__iree_flow___sm_node11__models.0.layer-1.bias\" : !iree.ptr<tensor<7x2xf32>>\r\n    %2 = \"mhlo.slice\"(%arg0) {limit_indices = dense<[2, 2, 3]> : tensor<3xi64>, start_indices = dense<0> : tensor<3xi64>, strides = dense<1> : tensor<3xi64>} : (tensor<2x8x3xf32>) -> tensor<2x2x3xf32>\r\n    %3 = \"mhlo.reshape\"(%2) : (tensor<2x2x3xf32>) -> tensor<1x2x6xf32>\r\n    %4 = \"mhlo.slice\"(%arg0) {limit_indices = dense<[2, 3, 3]> : tensor<3xi64>, start_indices = dense<[0, 1, 0]> : tensor<3xi64>, strides = dense<1> : tensor<3xi64>} : (tensor<2x8x3xf32>) -> tensor<2x2x3xf32>\r\n    %5 = \"mhlo.reshape\"(%4) : (tensor<2x2x3xf32>) -> tensor<1x2x6xf32>\r\n    %6 = \"mhlo.slice\"(%arg0) {limit_indices = dense<[2, 4, 3]> : tensor<3