.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"},"author_association":"COLLABORATOR","body":"Unfortunately, this is expected, and documented. \r\n\r\nOn CPU and GPU, when there is any error in the callback we send to the device a non-matching yet recognizable shape `s8[12345]`. The CPU and GPU runtime contain shape checks for infeed and will abort the computation. We intend to change the code to recognize this error and expand it with a description of the actual error that occurred. \r\n\r\nThe TPU runtime does not have such checks, it just waits until it gets enough bytes and then consumes the bytes it gets. There is no way to abort the TPU computation at that point. So, for TPU the host_callback does not send anything and lets it hang. \r\n\r\nWe have thought of several ways to implement the error handling on TPU. One solution would be to expand the TPU computation semantics with a notion of \"raising an exception\". This could happen by mismatched infeed, or perhaps by a special op. I do not know if this is reasonable or easily implementable. \r\n\r\nAnother solution is to send back to the device some fake data of the proper shape (0s for integers, NaN for floats) and then let the computation finish and throw an error at that point. One complication is that if the infeed is inside a loop we would need a way to abort the loop. We could do this by sending an additional boolean to infeed operations inside a loop. This is all doable and we may implement it. ","created_at":"2021-04-02T05:38:16Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/6301#issuecomment-812330297","id":812330297,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/6301","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDgxMjMzMDI5Nw==","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/812330297/reactions"},"updated_at":"2021-04-02T05:38:16Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/812330297","user":{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/2454281?v=4","events_url":"https://api.github.com/users/aravindhm/events{/privacy}","followers_url":"https://api.github.com/users/aravindhm/followers","following_url":"https://api.github.com/users/aravindhm/following{/other_user}","gists_url":"https://api.github.com/users/aravindhm/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/aravindhm","id":2454281,"login":"aravindhm","node_id":"MDQ6VXNlcjI0NTQyODE=","organizations_url":"https://api.github.com/users/aravindhm/orgs","received_events_url":"https://api.github.com/users/aravindhm/received_events","repos_url":"https://api.github.com/users/aravindhm/repos","site_admin":false,"starred_url":"https://api.github.com/users/aravindhm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aravindhm/subscriptions","type":"User","url":"https://api.github.com/users/aravindhm","user_view_type":"public"},"author_association":"NONE","body":"Hi George,\r\n\r\nThanks for the detailed answer.\r\n\r\n- Is it possible to upgrade the TPU runtime to include shape checks for infeed?\r\n- If not, then expanding the TPU computation semantics would be simpler from a user perspective (mental model) than the fake data solution. But is there an equivalent for this in GPU and CPU computation?","created_at":"2021-04-06T08:54:27Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/6301#issuecomment-813952001","id":813952001,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/6301","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDgxMzk1MjAwMQ==","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/813952001/reactions"},"updated_at":"2021-04-06T08:54:27Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/813952001","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2454281?v=4","events_url":"https://api.github.com/users/aravindhm/events{/privacy}","followers_url":"https://api.github.com/users/aravindhm/followers","following_url":"https://api.github.com/users/aravindhm/following{/other_user}","gists_url":"https://api.github.com/users/aravindhm/gists{/gist_id}",