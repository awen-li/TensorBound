   se::DeviceMemory<Output> output_data(output.data);
 
   if (batch_size != 1) {
@@ -819,8 +819,9 @@ StatusOr<se::cuda::BlasLt::Epilogue> AsBlasLtEpilogue(
 
   TF_ASSIGN_OR_RETURN(se::blas::DataType output_dtype,
