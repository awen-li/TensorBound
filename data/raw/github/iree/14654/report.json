/utils/allocators.c#L23)\r\n\r\n\n\n### Steps to reproduce your issue\n\n```\r\nimport iree.runtime as ireert\r\nhaldriver = ireert.get_driver(\"metal\")\r\nhaldevice = haldriver.create_device_by_uri(device, allocators=\"caching\")\r\n```\n\n### What component(s) does this issue relate to?\n\n_No response_\n\n### Version information\n\n_No response_\n\n### Additional context\n\n_No response_","closed_by":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/14654/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/iree-org/iree/issues/14654/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},"comments":[],"timeline":[{"id":10080704488,"node_id":"LE_lADODGgK6M5uMdtszwAAAAJY21fo","url":"https://api.github.com/repos/iree-org/iree/issues/events/10080704488","actor":{"login":"PhaneeshB","id":22429846,"node_id":"MDQ6VXNlcjIyNDI5ODQ2","avatar_url":"https://avatars.githubusercontent.com/u/22429846?v=4","gravatar_id":"","url":"https://api.github.com/users/PhaneeshB","html_url":"https://github.com/PhaneeshB","followers_url":"https://api.github.com/users/PhaneeshB/followers","following_url":"https://api.github.com/users/PhaneeshB/following{/other_user}","gists_url":"https://api.github.com/users/PhaneeshB/gists{/gist_id}","starred_url":"https://api.github.com/users/PhaneeshB/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhaneeshB/subscriptions","organizations_url":"https://api.github.com/users/PhaneeshB/orgs","repos_url":"https://api.github.com/users/PhaneeshB/repos","events_url":"https://api.github.com/users/PhaneeshB/events{/privacy}","received_events_url":"https://api.github.com/users/PhaneeshB/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-08-13T22:15:30Z","label":{"name":"bug 🐞","color":"d73a4a"