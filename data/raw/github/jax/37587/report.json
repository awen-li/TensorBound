om/users/soraros/subscriptions","type":"User","url":"https://api.github.com/users/soraros","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-05-13T10:35:07Z","event":"unsubscribed","id":25476914684,"node_id":"UE_lADOCTkjjc8AAAABCB2VRc8AAAAF7ord_A","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/25476914684"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/68273313?v=4","events_url":"https://api.github.com/users/pikaxinge/events{/privacy}","followers_url":"https://api.github.com/users/pikaxinge/followers","following_url":"https://api.github.com/users/pikaxinge/following{/other_user}","gists_url":"https://api.github.com/users/pikaxinge/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/pikaxinge","id":68273313,"login":"pikaxinge","node_id":"MDQ6VXNlcjY4MjczMzEz","organizations_url":"https://api.github.com/users/pikaxinge/orgs","received_events_url":"https://api.github.com/users/pikaxinge/received_events","repos_url":"https://api.github.com/users/pikaxinge/repos","site_admin":false,"starred_url":"https://api.github.com/users/pikaxinge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pikaxinge/subscriptions","type":"User","url":"https://api.github.com/users/pikaxinge","user_view_type":"public"},"created_at":"2026-05-25T02:27:57Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}],"author_association":"NONE","body":"## Summary\n- When a Python callback raises inside `shard_map` with ordered IO, the PjRT runtime token state machine is left inconsistent — input tokens are consumed but `_handle_token_bufs` never stores a valid output token\n- Every future ordered IO callback (including in unrelated functions and `atexit`) fails with the same cached error\n- Fix: wrap `execute_sharded` in try/except to reset tokens on synchronous failure; validate the runtime token via `block_until_ready()` after `consume_token()` to surface deferred callback errors\n\n## Test plan\n```bash\npython /tmp/orig_37587.py\n```\n\n## Evidence\nUsing the reporter's own reproducer:\n\n**Before (unmodified):**\n- Step 3: `sharded_f([3,4,5,6])` raises (expected)\n- Step 4: `sharded_f([1,1,1,1])` raises cached `ValueError: No fives.` (BUG)\n- Step 5: `f(7)` raises cached `ValueError: No fives.` (BUG)\n- Step 6: `g(zeros)` (different callback function) raises cached `ValueError: No fives.` (BUG)\n- `atexit` cleanup crashes with the same cached error\n\n**After (with fix):**\n- Steps 4-6 all succeed, token state cleanly reset\n- No `atexit` crashes\n\n## Hardware\nCPU-only — reproducer uses `jax_num_cpu_devices=4`\n\nFixes #37587","closed_at":null,"comments":1,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/37973/comments","created_at":"2026-05-25T02:27:56Z","draft":false,"events_url":"https://api.github.com/repos/jax-ml/jax/issues/37973/events","html_url":"https://github.com/jax-ml/jax/pull/37973","id":4513837274,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/37973/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOCTkjjc7e4irT","number":37973,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/jax-ml/jax/pull/37973.diff","html_url":"https://github.com/jax-ml/jax/pull/37973","merged_at":null,"patch_url":"https://github.com/jax-ml/jax/pull/37973.patch","url":"https://api.github.com/repos/jax-ml/jax/pulls/37973"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":1,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":1,"url":"https://api.github.com/repos/jax-ml/jax/issues/37973/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/jax-ml/jax/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/jax-ml/jax/assignees{/user}","blobs_url":"https://api.github.com/repos/jax-ml/jax/git/blobs{/sha}","branches_url":"https://api.github.com/repos/jax-ml/jax/branches{/branch}","clone_url":"https://github.com/jax-ml/jax.git","collaborators