/followers","following_url":"https://api.github.com/users/apaszke/following{/other_user}","gists_url":"https://api.github.com/users/apaszke/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apaszke","id":4583066,"login":"apaszke","node_id":"MDQ6VXNlcjQ1ODMwNjY=","organizations_url":"https://api.github.com/users/apaszke/orgs","received_events_url":"https://api.github.com/users/apaszke/received_events","repos_url":"https://api.github.com/users/apaszke/repos","site_admin":false,"starred_url":"https://api.github.com/users/apaszke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apaszke/subscriptions","type":"User","url":"https://api.github.com/users/apaszke","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-04-19T19:58:09Z","event":"mentioned","id":24655185554,"node_id":"MEE_lADOCTkjjc7_0KPBzwAAAAW9kEaS","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/24655185554"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/4583066?v=4","events_url":"https://api.github.com/users/apaszke/events{/privacy}","followers_url":"https://api.github.com/users/apaszke/followers","following_url":"https://api.github.com/users/apaszke/following{/other_user}","gists_url":"https://api.github.com/users/apaszke/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apaszke","id":4583066,"login":"apaszke","node_id":"MDQ6VXNlcjQ1ODMwNjY=","organizations_url":"https://api.github.com/users/apaszke/orgs","received_events_url":"https://api.github.com/users/apaszke/received_events","repos_url":"https://api.github.com/users/apaszke/repos","site_admin":false,"starred_url":"https://api.github.com/users/apaszke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apaszke/subscriptions","type":"User","url":"https://api.github.com/users/apaszke","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-04-19T19:58:09Z","event":"subscribed","id":24655185569,"node_id":"SE_lADOCTkjjc7_0KPBzwAAAAW9kEah","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/24655185569"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/16066115?v=4","events_url":"https://api.github.com/users/AmesingFlank/events{/privacy}","followers_url":"https://api.github.com/users/AmesingFlank/followers","following_url":"https://api.github.com/users/AmesingFlank/following{/other_user}","gists_url":"https://api.github.com/users/AmesingFlank/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/AmesingFlank","id":16066115,"login":"AmesingFlank","node_id":"MDQ6VXNlcjE2MDY2MTE1","organizations_url":"https://api.github.com/users/AmesingFlank/orgs","received_events_url":"https://api.github.com/users/AmesingFlank/received_events","repos_url":"https://api.github.com/users/AmesingFlank/repos","site_admin":false,"starred_url":"https://api.github.com/users/AmesingFlank/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AmesingFlank/subscriptions","type":"User","url":"https://api.github.com/users/AmesingFlank","user_view_type":"public"},"created_at":"2026-04-20T14:47:46Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"CONTRIBUTOR","body":"Adjust block size constraints by analyzing subscript exprs on argument tensors, unblock rms_norm_bwd example on TPU\r\n\r\nPreviously, we adjust block size constraint purely by looking at `kernel_tensor_sizes`. However, this is inaccurate when some of the kernel tensors is a result of a reduction. For example, consider a kernel like\r\n```py\r\nx = torch.rand([M, N], dtype=float32)\r\nfor tile in hl.tile(M):\r\n  # `y` is a `kernel_tensor` of shape `(tile.block_size, N)`\r\n  y = x[tile, :] \r\n\r\n  # `z` is a `kernel_tensor` of shape `(tile.block_size,)`\r\n  z = y.mean(-1)\r\n  ...\r\n```\r\nBefore this PR, In this situation, because we observed `z` to be a kernel tensor of size `(tile.block_size,)`, we will treat `tile` as requiring alignment for `dim_from_end == 0`. However this is unnecessary, as we only need to treat it as alignment with  `dim_from_end == 1`.\r\n\r\nThis PR fixes this class of issues by introducing a `ast.Visitor` called `TensorTiledAccessAnalyzer`. We analyze all subscript expressions and use those to extract the correct dim_from_end for each tiled accesses.\r\n\r\nThis fixes the `rms_norm` backward example on TPU, and unblocked a few tests caused by block sizing issues.","closed_at":"2026-04-20T18:35:00Z","comments":0,"comments_url":"https://api.github.com/repos/pytorch/helion/issues/2051/comments","created_at":"2026-04-19T01:01:26Z","draft":false,"events_url":"https://api.github.com/repos/pytorch/helion/issues/2051/events","html_url":"https://github.com/pytorch/helion/pull/2051","id":4289612107,"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"009900","default":false,"description":"This label is managed by the Meta Open Source bot.","id":8498053516,"name":"CLA Signed","node_id":"LA_kwDOOd7BJM8AAAAB-oYBjA","url":"https://api.github.com/repos/pytorch/helion/labels/CLA%20Signed"}],"labels_url":"https://api.github.com/repos/pytorch/helion/issues/2051/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOOd7BJM7TqAxc","number":2051,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/pytorch/helion/pull/2051.diff","html_url":"https://github.com/pytorch/helion/pull/2051","merged_at":"2026-04-20T18:35:00Z","patch_url":"https://github.com/pytorch/helion/pull/2051.patch","url":"https://api.github.com/repos/pytorch/helion/pulls/2051"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/pytorch/helion/issues/2051/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/pytorch/helion/{archive_fo