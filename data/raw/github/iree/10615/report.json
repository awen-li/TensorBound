oux/orgs","repos_url":"https://api.github.com/users/ThomasRaoux/repos","events_url":"https://api.github.com/users/ThomasRaoux/events{/privacy}","received_events_url":"https://api.github.com/users/ThomasRaoux/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/iree-org/iree/milestones/29","html_url":"https://github.com/iree-org/iree/milestone/29","labels_url":"https://api.github.com/repos/iree-org/iree/milestones/29/labels","id":8113342,"node_id":"MI_kwDODGgK6M4Ae8y-","number":29,"title":"Collab: Nod.ai","description":"Milestone to track IREE + Nod.ai bugs and model progress","creator":{"login":"allieculp","id":60522369,"node_id":"MDQ6VXNlcjYwNTIyMzY5","avatar_url":"https://avatars.githubusercontent.com/u/60522369?v=4","gravatar_id":"","url":"https://api.github.com/users/allieculp","html_url":"https://github.com/allieculp","followers_url":"https://api.github.com/users/allieculp/followers","following_url":"https://api.github.com/users/allieculp/following{/other_user}","gists_url":"https://api.github.com/users/allieculp/gists{/gist_id}","starred_url":"https://api.github.com/users/allieculp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allieculp/subscriptions","organizations_url":"https://api.github.com/users/allieculp/orgs","repos_url":"https://api.github.com/users/allieculp/repos","events_url":"https://api.github.com/users/allieculp/events{/privacy}","received_events_url":"https://api.github.com/users/allieculp/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":21,"closed_issues":84,"state":"open","created_at":"2022-06-22T20:21:40Z","updated_at":"2025-07-28T22:53:20Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2022-09-30T19:54:02Z","updated_at":"2022-10-04T16:53:16Z","closed_at":"2022-10-04T16:52:52Z","assignee":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What happened?\n\nThe pass `PackDispatchOperands` creates `arith.index_cast` to cast operations from i32 to index. This gets lowered to a sext operation for 64bits target. This is incorrect as the offset should be unsigned and can be greater than 2G.\r\n\r\nWe should be using a cast with zero extend semantic. This needs to be added upstream so that we can use it.\r\n\r\nHere is an example of wrong code generated causing out of bound access:\r\n```\r\n stream.executable private @forward_dispatch_1 {\r\n    stream.executable.export public @forward_dispatch_1_generic_2x160 workgroups(%arg0: index, %arg1: index) -> (index, index, index) {\r\n      %x, %y, %z = flow.dispatch.workgroup_count_from_dag_root %arg0, %arg1\r\n      stream.return %x, %y, %z : index, index, index\r\n    }\r\n    builtin.module {\r\n      func.func @forward_dispatch_1_generic_2x160(%arg0: !stream.binding, %arg1: !stream.binding, %arg2: !stream.binding, %arg3: i32, %arg4: i32, %arg5: i32) {\r\n        %0 = arith.index_cast %arg3 : i32 to index\r\n        %1 = arith.index_cast %arg4 : i32 to index\r\n        %2 = arith.index_cast %arg5 : i32 to index\r\n        %c160 = arith.constant 160 : index\r\n        %c0 = arith.constant 0 : index\r\n        %3 = arith.addi %c0, %0 : index\r\n        %4 = stream.binding.subspan %arg0[%3] : !stream.binding -> !flow.dispatch.tensor<readonly:f32>\r\n        %5 = arith.addi %c0, %2 : index\r\n        %6 = stream.binding.subspan %arg2[%5] : !stream.binding -> !flow.dispatch.tensor<writeonly:2x160xf32>\r\n        %7 = arith.addi %c0, %1 : index\r\n        %8 = stream.binding.subspan %arg1[%7] : !stream.binding -> !flow.dispatch.tensor<readonly:1x?xf32>{%c160}\r\n        %9 = flow.dispatch.tensor.load %4, offsets = [], sizes = [], strides = [] : !flow.dispatch.tensor<readonly:f32> -> tensor<f32>\r\n        %10 = linalg.init_tensor [2, 160] : tensor<2x160xf32>\r\n        %11 = flow.dispatch.tensor.load %8, offsets = [0, 0], sizes = [1, 160], strides = [1, 1] : !flow.dispatch.tensor<readonly:1x?xf32>{%c160} -> tensor<160xf32>\r\n        %12 = linalg.generic {indexing_maps = [#map1, #map2, #map3], iterator_types = [\"parallel\", \"parallel\"]} ins(%9, %11 : tensor<f32>, tensor<160xf32>) outs(%10 : tensor<2x160xf32>) {\r\n        ^bb0(%arg6: f32, %arg7: f32, %arg8: f32):\r\n          %13 = arith.mulf %arg6, %arg7 : f32\r\n          linalg.yield %13 : f32\r\n        } -> tensor<2x160xf32>\r\n        flow.dispatch.tensor.store %12, %6, offsets = [0, 0], sizes = [2, 160], strides = [1, 1] : tensor<2x160xf32> -> !flow.dispatch.tensor<writeonly:2x160xf32>\r\n        return\r\n      }\r\n    }\r\n  }\r\n```\n\n### Steps to reproduce your issue\n\n_No response_\n\n### What component(s) does this issue relate to?\n\n_No response_\n\n### Version information\n\n_No response_\n\n### Additional context\n\n_No response_","closed_by":{"login":"ThomasRaoux","id":2432