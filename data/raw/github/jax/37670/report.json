ptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"}],"author_association":"NONE","body":"### Description\n\n`jnp.log`, `jnp.log2`, and `jnp.log10` return `-inf` for subnormal `float32` inputs on the CPU backend, while NumPy returns the correct finite negative values.\n\nThis is a downstream consequence of XLA's DAZ (Denormals-Are-Zero) flush: subnormal inputs are flushed to `0.0` before the log operation, resulting in `log(0) = -inf`. While the [Sharp Bits docs](https://docs.jax.dev/en/latest/notebooks/Common_Gotchas_in_JAX.html) mention that subnormal semantics differ from NumPy, the specific `-inf` outcome for log functions is not documented and can silently corrupt computations.\n\n```python\nimport warnings, jax, jax.numpy as jnp, numpy as np\n\ntiny = np.finfo(np.float32).tiny\nxs = np.array([np.nextafter(tiny, np.float32(0)), 1e-38, 5e-39, 1.4e-45], dtype=np.float32)\n\nfor name, np_op, jnp_op in [(\"log\", np.log, jnp.log), (\"log2\", np.log2, jnp.log2), (\"log10\", np.log10, jnp.log10)]:\n    with warnings.catch_warnings():\n        warnings.simplefilter(\"ignore\")\n        expected = np_op(xs)\n    actual = np.asarray(jnp_op(jnp.array(xs)))\n    print(f\"jnp.{name}: expected={expected}  actual={actual}\")\n```\n\nOutput:\n\n`jnp.log:   expected=[ -87.33655  -87.49824  -88.19138 -103.27893]  actual=[-inf -inf -inf -inf]`\n`jnp.log2:  expected=[-126.      -126.23327 -127.23327 -149.     ]  actual=[-inf -inf -inf -inf]`\n`jnp.log10: expected=[-37.92978 -38.      -38.30103 -44.85347]      actual=[-inf -inf -inf -inf]`\n\nThe inputs are valid representable subnormal floats. In gradient-based workflows, a silent `-inf` propagates as `nan` and can crash training with no obvious cause. A documentation clarification — or ideally a runtime warning when a log-family function receives an input flushed to zero — would prevent silent failures.\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\njax        0.10.1.dev20260513+64f6e229b\njaxlib     0.10.0\nPython     3.12.3\nBackend    cpu\n\nNote: tested on a nightly build. Given that this relates to documented DAZ/XLA behavior, it likely reproduces on stable as well.","closed_at":"2026-06-22T12:48:31Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"},"comments":2,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/37670/comments","created_at":"2026-05-14T20:15:56Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/37670/events","html_url":"https://github.com/jax-ml/jax/issues/37670","id":4448972440,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/37670/labels{/name}","locked":false,"milestone":null,"node_id":"I_kwDOCTkjjc8AAAABCS3umA","number":37670,"performed_via_github_app":null,"pinned_comment":null,