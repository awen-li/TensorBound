github.com/users/copybara-service%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/copybara-service%5Bbot%5D/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apps/copybara-service","id":56741989,"login":"copybara-service[bot]","node_id":"MDM6Qm90NTY3NDE5ODk=","organizations_url":"https://api.github.com/users/copybara-service%5Bbot%5D/orgs","received_events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/received_events","repos_url":"https://api.github.com/users/copybara-service%5Bbot%5D/repos","site_admin":false,"starred_url":"https://api.github.com/users/copybara-service%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/copybara-service%5Bbot%5D/subscriptions","type":"Bot","url":"https://api.github.com/users/copybara-service%5Bbot%5D","user_view_type":"public"},"created_at":"2026-09-22T10:53:13Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"NONE","body":"PR #49182: Check scatter carry predicate replication before all-reduce motion\n\nImported from GitHub PR https://github.com/openxla/xla/pull/49182\n\n📝 Summary of Changes\nFixes #49143.\n\nReuse the existing generic buffer-use checker `existing is_buffer_used` and remove the weaker scatter-only helper `IsScatterBufferUsed`. Unsafe scatter patterns keep their all-reduce inside the loop.\n\nAdded eight parameterized minimal-HLO regression cases that check whether the pass hoists the all-reduce or retains it inside the loop. And the tests ran on CPU host.\n\n🎯 Justification\nThe scatter-specific path in `while-loop-all-reduce-code-motion` accepts a select between carry and zero without checking whether its predicate is replicated within the all-reduce group. Hoisting the collective while retaining a select such as `partition_id == 0 ? carry : 0` discards earlier contributions on nonzero partitions.\n\n🚀 Kind of Contribution\n🐛 Bug Fix, 🧪 Tests\n\n🧪 Unit Tests\n```bash\nbazel test \\\n  //xla/hlo/transforms/collectives:while_loop_all_reduce_code_motion_test \\\n  //xla/hlo/transforms/collectives:while_loop_all_reduce_code_motion_setup_test\n```\n\n| Tests | Before fix | After fix |\n|---|---|---|\n| Eight new regression cases | 4 passed, 4 failed | 8 passed |\n\n\nThe four failing cases previously hoisted the collective despite a device-dependent predicate. After the fix, it remains inside the loop; the four positive controls still pass.\n\nCopybara import of the project:\n\n--\nec48eb853b9f8d9d2f4593674bdaebaf755c6be6 by yixiaoer <shin@yixiaoer.sg>:\n\nCheck scatter carry predicate replication before all-reduce motion\n\n--\n1ca2d1850777b2c63641ffa1eed5c766e069d7a6 by yixiaoer <shin@yixiaoer.sg>:\n\nSimplify scatter context condition\n\nMerging this change closes #49182\n\nFUTURE_COPYBARA_INTEGRATE_REVIEW=https://github.com/openxla/xla/pull/49182 from yixiaoer:fix/scatter-carry-all-reduce-motion 1ca2d1850777b2c63641ffa1eed5c766e069d7a6\n","closed_at":"2026-09-22T11:49:32Z","comments":0,"comments_url":"https://api.github.com/repos/openxla/xla/issues/49236/comments","created_at":"2026-09-22T10:53:11Z","draft":false,"events_url":"https://api.github.com/repos/openxla/xla/issues/49236/events","html_url":"https://github.com/openxla/xla/pull/49236","id":5538522393,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/openxla/xla/issues/49236/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOHyx1PM8AAAABEkCQrg","number":49236,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/openxla/xla/pull/49236.diff","html_url":"https://github.com/openxla/xla/pull/49236","merged_at":"2026-09-22T11:49:32Z","patch_url":"https://github.com/openxla/xla/pull/49236.patch","url":"https://api.github.com/repos/openxla/xla/pulls/49236"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/