From 6578551e3ae2d9296f775ab770efaf411f70a8b8 Mon Sep 17 00:00:00 2001
From: Jason Ansel <jansel@meta.com>
Date: Tue, 29 Aug 2023 12:57:13 -0700
Subject: [PATCH] [inductor] Fix inputs with existing offsets

Cherry pick of #108168
---
 test/inductor/test_cpp_wrapper.py    |  2 ++
 test/inductor/test_torchinductor.py  | 10 ++++++++++
 torch/_inductor/codegen/wrapper.py   |  7 +++++--
 torch/_inductor/graph.py             |  2 +-
 torch/_inductor/ir.py                | 10 ++++------
 torch/csrc/inductor/inductor_ops.cpp | 19 +++++++++++++++++++
 torch/csrc/inductor/inductor_ops.h   |  9 +++++++++
 7 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/test/inductor/test_cpp_wrapper.py b/test/inductor/test_cpp_wrapper.py
