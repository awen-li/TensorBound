ub.com/users/1sgtpepper/followers","following_url":"https://api.github.com/users/1sgtpepper/following{/other_user}","gists_url":"https://api.github.com/users/1sgtpepper/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/1sgtpepper","id":165563006,"login":"1sgtpepper","node_id":"U_kgDOCd5Kfg","organizations_url":"https://api.github.com/users/1sgtpepper/orgs","received_events_url":"https://api.github.com/users/1sgtpepper/received_events","repos_url":"https://api.github.com/users/1sgtpepper/repos","site_admin":false,"starred_url":"https://api.github.com/users/1sgtpepper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/1sgtpepper/subscriptions","type":"User","url":"https://api.github.com/users/1sgtpepper","user_view_type":"public"},"created_at":"2026-07-22T09:42:41Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"OWNER","body":"Fixes iree-org/iree#24735.\n\nProvide initialized writable storage for otherwise-unused Sort comparator lanes\nwhen converting dispatch regions to workgroups. Sort reports required lanes\nthrough a default-false `TiedOpInterface` query. A live Sort can gain one tied\noutput per direct, type-identical captured input when it is that input's sole\ndata consumer; `tensor.dim` queries are allowed. Required ties take precedence\nwhen results share an input.\n\nValidation passed at `220f8242250780e5f63e7dfb99737e560117eadd`:\n\n- [Fork CI](https://github.com/1sgtpepper/iree/actions/runs/34023646227): repository\n  lint; LinalgExt canonicalization; Flow dispatch folding; dispatch conversion,\n  formation and scalar formation; executable dynamic argsort; Clang Tidy on\n  the changed C++ lines. The converter target executed; the other five used cached results.\n- New converter tests cover required-tie priority with both results returned and\n  read-only keys shared by two live Sorts. Giving ordinary ties priority and\n  allowing competing in-dispatch consumers each makes the respective test fail.\n- The runtime test checks `[3 1 2]` produces indices `[1 2 0]`. Disabling the\n  Sort requirement reproduced `expected no unbounded stack allocations`.\n\nThis uses Sort's current initialized-`outs` representation. iree-org/iree#24658 changes that\ncontract, so landing order still needs maintainer confirmation.\n\nUpstream CI still requires maintainer approval.\n\nAssisted-by: Codex\n","closed_at":null,"comments":0,"comments_url":"https://api.github.com/repos/1sgtpepper/iree/issues/1/comments","created_at":"2026-07-22T09:42:40Z","draft":true,"events_url":"https://api.github.com/repos/1sgtpepper/iree/issues/1/events","html_url":"https://github.com/1sgtpepper/iree/pull/1","id":4947610882,"labels":[],"labels_url":"https://api.github.com/repos/1sgtpepper/iree/issues/1/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOTf887s70y7Ir","number":1,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/1sgtpepper/iree/pull/1.diff","html_url":"https://github.com/1sgtpepper/iree/pull/1","merged_at":null,"patch_url":"https://github.com/1sgtpepper/iree/pull/1.patch","url":"https://api.github.com/repos/1sgtpepper/iree/pulls/1"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/1sgtpepper/iree/issues/1/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/1sgtpepper/iree/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/1sgtpepper/iree/assignees{/user}","blobs_url":"https://api.github.com/repos/1sgtpepper/iree/git/blobs{/sha}","branches_url":"https://api.github.com/repos/1sgtpepper/iree/branches{/branch}","clone_url":"https://github.com/1sgtpepper/iree.git","collaborators_url":"https://api.github.com/repos/1sgtpepper/iree/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/1sgtpepper/iree/comments{/nu