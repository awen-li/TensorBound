s/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"}],"author_association":"CONTRIBUTOR","body":"### Description\n\nA lot of individual tests in JAX's sparse_test_gpu start to fail when JAX is built w/ cuda-12.2.1.\r\n\r\nHere are a few examples:\r\n```\r\n[ RUN      ] BCOOTest.test_bcoo_dot_general_cusparse29 (lhs_shape=(5,), rhs_shape=(5,), lhs_contracting=[0], rhs_contracting=[0], dtype=<class 'numpy.complex64'>)\r\n ** On entry to cusparseCreateCoo() parameter number 7 (cooValues) had an illegal value: the pointer must be aligned to 8, namely the size of CUDA_C_32F\r\n...\r\n[ RUN      ] SparseObjectTest.test_dense_round_trip15 (Obj=<class 'jax.experimental.sparse.csr.CSR'>, shape=(5, 5), dtype=<class 'numpy.float64'>) \r\n** On entry to cusparseCreateDnMat() parameter number 5 (values) had an illegal value: the pointer must be aligned to 8, namely the size of CUDA_R_64F\r\n...\r\n[ RUN      ] cuSparseTest.test_csr_matmul_ad30 (shape=(5, 8), bshape=(8, 1), dtype=<class 'numpy.float32'>)\r\n ** On entry to cusparseSpMM_bufferSize(): SPMM_CSR_ALG3 is not supported when opA != OPERATION_NON_TRANSPOSE or opB == OPERATION_CONJUGATE_TRANSPOSE\r\n\r\n```\r\n\r\nThere are a lot more.\n\n### What jax/jaxlib version are you using?\n\nHEAD\n\n### Which accelerator(s) are you using?\n\nGPU\n\n### Additional system info\n\nLinux\n\n### NVIDIA GPU info\n\nFailures happen on both GPU variants (sm_60 and sm_70).\r\n```\r\n+-----------------------------------------------------------------------------+\r\n| NVIDIA-SMI 525.125.06   Driver Version: 525.125.06   CUDA Version: 12.0     |\r\n|-------------------------------+----------------------+----------------------+\r\n| GPU  Name        Persistence-M| Bus-Id        Disp.A | Volatile Uncorr. ECC |\r\n| Fan  Temp  Perf  Pwr:Usage/Cap|         Memory-Usage | GPU-Util  Compute M. |\r\n|                               |                      |               MIG M. |\r\n|===============================+======================+======================|\r\n|   0  NVIDIA TITAN V      Off  | 00000000:41:00.0 Off |                  N/A |\r\n| 27%   43C    P0    36W / 250W |      0MiB / 12288MiB |      0%      Default |\r\n|                               |                      |                  N/A |\r\n+-------------------------------+----------------------+----------------------+\r\n|   1  Quadro GP100        Off  | 00000000:42:00.0 Off |                    0 |\r\n| 30%   44C    P0    28W / 235W |      0MiB / 16384MiB |      0%      Default |\r\n|                               |                      |                  N/A |\r\n+-------------------------------+----------------------+----------------------+\r\n\r\n+-----------------------------------------------------------------------------+\r\n| Processes:                                                                  |\r\n|  GPU   GI   CI        PID   Type   Process name                  GPU Memory |\r\n|        ID   ID                                                   Usage      |\r\n|=============================================================================|\r\n|  No running processes found                                                 |\r\n+-----------------------------------------------------------------------------+\r\n```","closed_at":"2023-08-29T18:24:10Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/526795?v=4","events_url":"https://api.github.com/users/Artem-B/events{/privacy}","followers_url":"https://api.github.com/users/Artem-B/followers","following_url":"https://api.github.com/users/Artem-B/following{/other_user}","gists_url":"https://api.github.com/users/Artem-B/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Artem-B","id":526795,"login":"Artem-B","node_id":"MDQ6VXNlcjUyNjc5NQ==","organizations_url":"https://api.github.com/users/Artem-B/orgs","received_events_url":"https://api.github.com/users/Artem-B/received_events","repos_url":"https://api.github.com/users/Artem-B/repos","site_admin":false,"starred_url":"https://api.github.com/users/Artem-B/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artem-B/subscriptions","type":"User","url":"https://api.github.com/users/Artem-B","user_view_type":"public"},"comments":3,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/17118/comments","created_at":"2023-08-14T23:45:35Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/17118/events","html_url":"https://github.com/jax-ml/jax/issues/17118","id":1850717950,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"desc