k2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}],"author_association":"CONTRIBUTOR","body":"### Description\n\nThe following snippet fails:\n\n```python\n\n@jax.grad\ndef f(params, x):\n  @jax.sharding.auto_axes(out_sharding=jax.sharding.PartitionSpec())\n  def model(x):\n    return params * x\n  \n  def body(c, _):\n    return model(c), ()\n\n  y = jax.lax.scan(body, x, length=3)[0]\n  return y\n\n@jax.jit\ndef test(params, x):\n  return f(params, x)\n\nmesh = jax.make_mesh(\n    (jax.device_count(),), (\"data\"), axis_types=(jax.sharding.AxisType.Explicit,))\n\nwith jax.set_mesh(mesh):\n  test(1., 2.)\n```\n\nThis will raise an error:\n```\nValueError: Context mesh AbstractMesh('data': 8, axis_types=(Explicit,), device_kind=TPU v6 lite, num_cores=1) should match the mesh of sharding AbstractMesh('data': 8, axis_types=(Auto,), device_kind=TPU v6 lite, num_cores=1) passed to broadcast_in_dim.\n```\n\nThis bug makes using explicit meshes tricky when using scans in grad. Auto sharded values leak as intermediates for gradient computations which the scan implementation isn't able to handle because it cannot allocate auto-sharded variables for the loop.\n\n\njaxpr trace:\n\n```\n{ lambda ; a:f32[] b:f32[]. let\n    c:f32[] = jit[\n      name=test\n      ctx_mesh=Mesh('data': 8, axis_types=(Explicit,))\n      jaxpr={ lambda ; a:f32[] b:f32[]. let\n          _:f32[] d:f32[3] = scan[\n            _split_transpose=False\n            jaxpr={ lambda ; e:f32[] f:f32[]. let\n                g:f32[] = reshard[\n                  dst_sharding=NamedSharding(mesh=AbstractMesh('data': 8, axis_types=(Auto,), device_kind=TPU v6 lite, num_cores=1), spec=PartitionSpec())\n                ] f\n                h:f32[] = mul e g\n                i:f32[] = reshard[\n                  dst_sharding=NamedSharding(mesh=AbstractMesh('data': 8, axis_types=(Explicit,), device_kind=TPU v6 lite, num_cores=1), spec=PartitionSpec())\n                ] h\n              in (i, g) }\n            length=3\n            linear=(False, False)\n            num_carry=1\n            num_consts=1\n            reverse=False\n            unroll=1\n          ] a b\n          j:f32[] = broadcast_in_dim[\n            broadcast_dimensions=()\n            shape=()\n            sharding=NamedSharding(mesh=AbstractMesh('data': 8, axis_types=(Explicit,), device_kind=TPU v6 lite, num_cores=1), spec=PartitionSpec())\n          ] 1.0:f32[]\n          c:f32[] _:f32[] = scan[\n            _split_transpose=False\n            jaxpr={ lambda ; k:f32[] l:f32[] m:f32[] n:f32[]. let\n                o:f32[] = reshard[\n                  dst_sharding=NamedSharding(mesh=AbstractMesh('data': 8, axis_types=(Auto,), device_kind=TPU v6 lite, num_cores=1), spec=PartitionSpec())\n                ] m\n                p:f32[] = mul k o\n                q:f32[] = mul o n\n                r:f32[] = reduce_sum[axes=() out_sharding=None] q\n                s:f32[] = reshard[\n                  dst_sharding=NamedSharding(mesh=AbstractMesh((), axis_types=()), spec=PartitionSpec())\n                ] p\n                t:f32[] = add_any l r\n              in (t, s) }\n            length=3\n            linear=(False, True, True, False)\n            num_carry=2\n            num_consts=1\n            reverse=True\n            unroll=1\n          ] a 0.0:f32[] j d\n        in (c,) }\n    ] a b\n  in (c,) }\n```\n\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\nNot applicable","closed_at":"2025-11-03T21:51:47Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/in/44061?v=4","events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/events{/privacy}","followers_url":"https://api.github.com/users/copybara-service%5Bbot%5D/followers","following_url":"https://api.github.com/users/copybara-service%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/copybara-service%5Bbot%5D/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apps/copybara-service","id":56741989,"login":"copybara-service[bot]","node_id":"MDM6Qm90NTY3NDE5ODk=","organizations_url":"https://api.github.com/users/copybara-service%5Bbot%5D/orgs","received_events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/received_events","repos_url":"https://api.github.com/users/copybara-service%5Bbot