40Z","html_url":"https://github.com/jax-ml/jax/issues/36970#issuecomment-4287646783","id":4287646783,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/36970","minimized":null,"node_id":"IC_kwDOCTkjjc7_kEw_","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/4287646783/reactions"},"updated_at":"2026-04-21T10:04:40Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/4287646783","user":{"avatar_url":"https://avatars.githubusercontent.com/u/4583066?v=4","events_url":"https://api.github.com/users/apaszke/events{/privacy}","followers_url":"https://api.github.com/users/apaszke/followers","following_url":"https://api.github.com/users/apaszke/following{/other_user}","gists_url":"https://api.github.com/users/apaszke/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apaszke","id":4583066,"login":"apaszke","node_id":"MDQ6VXNlcjQ1ODMwNjY=","organizations_url":"https://api.github.com/users/apaszke/orgs","received_events_url":"https://api.github.com/users/apaszke/received_events","repos_url":"https://api.github.com/users/apaszke/repos","site_admin":false,"starred_url":"https://api.github.com/users/apaszke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apaszke/subscriptions","type":"User","url":"https://api.github.com/users/apaszke","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"NONE","body":"### Description\n\nConsider the following kernel:\n\n```py\nimport jax\nimport jax.numpy as jnp\nfrom jax.experimental import pallas as pl\n\n\ndef kernel(x_ref, out_ref):\n    # x_ref: (1, 4, 8) \n    s1 = jnp.sum(x_ref[...], axis=2)   # (1, 4, 8) -> (1, 4)  \n    s2 = jnp.sum(s1, axis=1)            # (1, 4) -> (1,)        [triggers relayout error]\n    out_ref[...] = jnp.broadcast_to(s2[:, None, None], (1, 4, 8))\n\n\ndef call():\n    x = jax.random.normal(jax.random.PRNGKey(0), (1, 4, 8), dtype=jnp.float32)\n    result = pl.pallas_call(\n        kernel,\n        grid=(),\n        in_specs=[pl.BlockSpec((1, 4, 8), lambda: (0, 0, 0))],\n        out_specs=pl.BlockSpec((1, 4, 8), lambda: (0, 0, 0)),\n        out_shape=jax.ShapeDtypeStruct((1, 4, 8), jnp.float32),\n    )(x)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    call()\n```\nRunning this on TPU triggers the following error:\n\n```\n  File \"/mnt/hyperdisk/dunfanlu_notes/tpu/tpu_nested_loop_accumulator_compiled_new_jax_minimal.py\", line 24, in reduce_sum\"(\"kernel\n    s1 = jnp.sum(x_ref[...], axis=2)   # (1, 4, 8) -> (1, 4)  [replicated layout]\njax._src.pallas.mosaic.error_handling.MosaicError: INTERNAL: Mosaic failed to compile TPU kernel: Invalid relayout: Non-singleton logical dimension is replicated in destination but not in source for 'vector<1x4xf32>': \"32,{0,*},(8,128),-1\" -> \"32,{0,*},(8,128)\"\n\n\nPlease report a bug at: https://github.com/google/jax/issues/new?assignees=apaszke\n```\n\nThis seem to only reproduce when the 0th dimension is of size 1.\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n```\njax:    0.9.2\njaxlib: 0.9.2\nnumpy:  2.3.1\npython: 3.12.12 (main, Jan 13 2026, 03:13:28) [GCC 12.2.0]\ndevice info: TPU7x-8, 8 local devices\"\nprocess_count: 1\nplatform: uname_result(system='Linux', node='dunfanlu-torchtpu', release='6.12.68+', version='#1 SMP Sat Mar 14 01:16:30 UTC 2026', machine='x86_64')\n```\nAlso, I have `libtpu==0.0.40`","closed_at":"2026-05-15T16:39:03Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/4583066?v=4","events_url":"https://api.github.com/users/apaszke/events{/privacy}","followers_url":"https://api.github.com/users/apaszke/followers","following_url":"https://api.github.com/users/apaszke/following{/other_user}","gists_url":"https://api.github.com/users/apaszke/gists{/gist_id}","gravatar_id":"","html