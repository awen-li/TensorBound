s_url":"https://api.github.com/users/mattjj/subscriptions","type":"User","url":"https://api.github.com/users/mattjj","user_view_type":"public"},"created_at":"2019-05-28T20:53:54Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/1458824?v=4","events_url":"https://api.github.com/users/mattjj/events{/privacy}","followers_url":"https://api.github.com/users/mattjj/followers","following_url":"https://api.github.com/users/mattjj/following{/other_user}","gists_url":"https://api.github.com/users/mattjj/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/mattjj","id":1458824,"login":"mattjj","node_id":"MDQ6VXNlcjE0NTg4MjQ=","organizations_url":"https://api.github.com/users/mattjj/orgs","received_events_url":"https://api.github.com/users/mattjj/received_events","repos_url":"https://api.github.com/users/mattjj/repos","site_admin":false,"starred_url":"https://api.github.com/users/mattjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattjj/subscriptions","type":"User","url":"https://api.github.com/users/mattjj","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/1458824?v=4","events_url":"https://api.github.com/users/mattjj/events{/privacy}","followers_url":"https://api.github.com/users/mattjj/followers","following_url":"https://api.github.com/users/mattjj/following{/other_user}","gists_url":"https://api.github.com/users/mattjj/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/mattjj","id":1458824,"login":"mattjj","node_id":"MDQ6VXNlcjE0NTg4MjQ=","organizations_url":"https://api.github.com/users/mattjj/orgs","received_events_url":"https://api.github.com/users/mattjj/received_events","repos_url":"https://api.github.com/users/mattjj/repos","site_admin":false,"starred_url":"https://api.github.com/users/mattjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattjj/subscriptions","type":"User","url":"https://api.github.com/users/mattjj","user_view_type":"public"}],"author_association":"NONE","body":"At the time of writing this, JAX automatically upcasts python values upcast to the highest dtype available. For example, if x64 mode is enabled then the following code will produce a float64, `np.array([1, 2, 3], dtype=np.float32) * 1.0`. In order to guarantee that a calculation is performed at a specific dtype, it is therefore necessary to explicitly cast all values to the desired dtype. \r\n\r\nWhile this is not inherently problematic (it might even be desirable to have some kind of explicit typing), I think the current system could use some improvement. My main issue is that the upcasting is silent. Therefore, suppose you have a long piece of code and have accidentally out of habit included a line line `y = x ** 2.0`. Now, the output of the expression will be upcast silently. This means that unless you are explicitly checking dtype information your calculation might be slower than you expect / not fit into memory as easily. Moreover, to find the errant multiply, you have to proceed by just looking through the code line by line. This is all the worse if you initially wrote code e.g. to operate at float32 and then decide you want to be able to use float16s since code does not preserve type information by default.\r\n\r\nAt the moment I can think of a few possible improvements to the status quo without going as far as numpy's casting which (as Matt points out) is challenging within jit compilation.\r\n\r\n1. Force users to specify the dtype of values and give an error otherwise.\r\n2. Give a warning when a python value gets upcast.\r\n3. Be able to set the default casting type through a flag.\r\n\r\nWhile I'm sure there are better options out there, I think any of these three would be QoL improvements. I might be partial to some combination of 2/3 since I think the common case is that a user wants a consistent dtype across their calculation.  \r\n\r\n","closed_at":"2022-06-21T19:22:47Z","comments":4,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/768/comments","created_at":"2019-05-24T15:23:04Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/768/events","html_url":"https://github.com/jax-ml/jax/issues/768","id":448227301,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/768/labels{/name}","locked":false,"milestone":null,"node_id":"MDU6SXNzdWU0NDgyMjczMDE=","number":768,"performed_via_github_app":null,"pinned_comment":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/768/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/jax-ml/jax/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/jax-ml/jax/assignees{/user}","blobs_url":"https://api.github.com/repos/jax-ml/jax/git/blobs{/sha}","branches_url":"https://api.github.com/repos/jax-ml/jax/branches{/branch}","clone_url":"https://github.com/jax-ml/jax.git","collaborators_url":"https://api.github.com/repos/jax-ml/jax/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/jax-ml/jax/comments{/number}","commits_url":"https://api.github.com/repos/jax-ml/jax/commits{/sha}","compare_url":"https://api.github.com/repos/jax-ml/jax/compare/{base}...{head}","contents_url":"https://api.github.com/repos/jax-ml/jax/contents/{+path}","contributors_url":"https://api.github.com/repos/jax-ml/jax/contributors","created_at":"2018-10-25T21:25:02Z","default_branch":"main","deployments_url":"https://api.github.com/repos/jax-ml/jax/deployments","description":"Composable transformations of Python+NumPy programs: differentiate, vectorize, JIT to GPU/TPU, and more","disabled":false,"downloads_url":"https: