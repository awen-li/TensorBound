rying mesh axes as the output of the function\n\nsee example below:\n\n```python\nimport jax\njax.config.update(\"jax_num_cpu_devices\", 4)\n\nfrom functools import partial\nimport numpy as np\nfrom jax.sharding import Mesh, PartitionSpec as P, NamedSharding, AxisType, set_mesh\nfrom jax.experimental.shard_map import shard_map\n\n\nfrom jax._src.lax import lax as lax_internal\n\nimport jax.numpy as jnp\n\nn = 1024\nm = 5\n\nmesh = Mesh(jax.devices(), 'S', axis_types = (AxisType.Explicit))\nset_mesh(mesh)\n\nk1, k2 = jax.random.split(jax.random.key(123))\nx = jax.random.uniform(k1, shape=(n,m), out_sharding=NamedSharding(mesh, P('S', None)))\np = jax.random.uniform(k2, shape=m, out_sharding=NamedSharding(mesh, P(None)))\n\ndef f(p, x):\n    return jnp.einsum('i, i->', x, p)\n\n@partial(shard_map, mesh=mesh, in_specs=(P(None), P('S', None)), out_specs=P('S'))\ndef g(p, x):\n    def _grad(f, p, x):\n        y, vjp_fun =  jax.vjp(f, p, x)\n\n        y_eval_shape = jax.eval_shape(f, p, x)\n\n        # works\n        # one = lax_internal._one(y)\n\n        one = lax_internal._one(y_eval_shape)\n\n        print('y:', jax.typeof(y).vma)\n        print('y_eval_shape:', jax.typeof(y_eval_shape).vma)\n\n\n        return vjp_fun(one)\n        \n    return jax.lax.map(partial(_grad, f, p), x)\n\ng(p,x)\n```\n\n```\ny: frozenset({'S'})\ny_eval_shape: frozenset()\nValueError: unexpected JAX type (e.g. shape/dtype) for argument to vjp function: got float32[], but expected float32[]{V:S} because the corresponding output of the function f had JAX type float32[]{V:S}\n```\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n```\njax:    0.7.0.dev20250704\njaxlib: 0.7.0.dev20250704\nnumpy:  1.26.4\npython: 3.12.5 (main, Aug  6 2024, 19:08:49) [Clang 15.0.0 (clang-1500.3.9.4)]\ndevice info: cpu-1, 1 local devices\"\nprocess_count: 1\nplatform: uname_result(system='Darwin', node='', release='24.3.0', version='Darwin Kernel Version 24.3.0: Thu Jan  2 20:24:06 PST 2025