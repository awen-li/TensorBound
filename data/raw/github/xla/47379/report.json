ub.com/users/penumallas1261","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-08-17T11:02:13Z","event":"labeled","id":29558420426,"intent":null,"label":{"color":"d73a4a","name":"bug"},"node_id":"LE_lADOHyx1PM8AAAABM7yD7M8AAAAG4dGzyg","performed_via_github_app":null,"url":"https://api.github.com/repos/openxla/xla/issues/events/29558420426"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/194224583?v=4","events_url":"https://api.github.com/users/penumallas1261/events{/privacy}","followers_url":"https://api.github.com/users/penumallas1261/followers","following_url":"https://api.github.com/users/penumallas1261/following{/other_user}","gists_url":"https://api.github.com/users/penumallas1261/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/penumallas1261","id":194224583,"login":"penumallas1261","node_id":"U_kgDOC5Ohxw","organizations_url":"https://api.github.com/users/penumallas1261/orgs","received_events_url":"https://api.github.com/users/penumallas1261/received_events","repos_url":"https://api.github.com/users/penumallas1261/repos","site_admin":false,"starred_url":"https://api.github.com/users/penumallas1261/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/penumallas1261/subscriptions","type":"User","url":"https://api.github.com/users/penumallas1261","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-08-17T11:02:13Z","event":"labeled","id":29558420468,"intent":null,"label":{"color":"0e8a16","name":"CPU"},"node_id":"LE_lADOHyx1PM8AAAABM7yD7M8AAAAG4dGz9A","performed_via_github_app":null,"url":"https://api.github.com/repos/openxla/xla/issues/events/29558420468"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/6258615?v=4","events_url":"https://api.github.com/users/kodlan/events{/privacy}","followers_url":"https://api.github.com/users/kodlan/followers","following_url":"https://api.github.com/users/kodlan/following{/other_user}","gists_url":"https://api.github.com/users/kodlan/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/kodlan","id":6258615,"login":"kodlan","node_id":"MDQ6VXNlcjYyNTg2MTU=","organizations_url":"https://api.github.com/users/kodlan/orgs","received_events_url":"https://api.github.com/users/kodlan/received_events","repos_url":"https://api.github.com/users/kodlan/repos","site_admin":false,"starred_url":"https://api.github.com/users/kodlan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kodlan/subscriptions","type":"User","url":"https://api.github.com/users/kodlan","user_view_type":"public"},"created_at":"2026-08-24T20:41:14Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"CONTRIBUTOR","body":"## 📝 Summary of Changes\r\n\r\nFixes #47379.\r\n\r\nOn CPU, a buffer for a bounded-dynamic shape holds the array data padded to\r\nthe bound followed by one int32 runtime size per dynamic dimension (suffix\r\nmetadata), and `CommonPjRtClient::BufferFromHostLiteral` sizes the allocation\r\naccordingly. But `PjRtCpuClient::LinearizeInto` routes every literal to\r\n`CpuRawBuffer::CopyFromLiteral`, which knows nothing about the metadata: it\r\nbulk-copies with `CHECK(literal.size_bytes() == size)` in `PackOrCopy`, and a\r\nliteral's `size_bytes()` counts only the data. For any dynamic-shaped literal\r\nthe sizes differ by the metadata bytes and the process aborts\r\n(`abstract_cpu_buffer.cc: Check failed: literal.size_bytes() == size\r\n(40 vs. 44)` for the issue's `f32[<=10]` input).\r\n\r\nThe base `CommonPjRtClient::LinearizeInto` already handles this case: it\r\ncollects the literal's dynamic sizes and writes the data and metadata regions\r\nseparately. This change makes the CPU override delegate to the base\r\nimplementation when the device shape requires runtime shape metadata, keeping\r\nthe existing fast path for static shapes untouched.\r\n\r\nNote the D2H direction already works on CPU (dynamic outputs are read via the\r\nshape-metadata helpers), so with this change a dynamic literal round-trips\r\nthrough `BufferFromHostLiteral` + `ToLiteral`.\r\n\r\n## 🎯 Justification\r\n\r\nTransferring a well-formed dynamic-shaped literal must not abort the\r\nprocess. The buffer sizing, the D2H direction, and the generic linearization\r\npath all support dynamic shapes already; the CPU override just bypassed the\r\nsupport.\r\n\r\n## 🚀 Kind of Contribution\r\n\r\n- 🐛 Bug Fix\r\n\r\n## 🧪 Unit Tests:\r\n\r\n`PjRtCpuClientTest.BufferFromHostLiteralDynamicShape`: round-trips an\r\n`f32[<=10]` literal with dynamic size 3 through `BufferFromHostLiteral` and\r\n`ToLiteral`, checking the dynamic size and data survive.\r\n`PjRtCpuClientTest.BufferFromHostLiteralDynamicShapeMixedDims`: `f32[2,<=3]`\r\nwith dynamic size 2, checking the compacted data placement the CPU runtime\r\nexpects. Without the fix both abort on the `PackOrCopy` CHECK exactly like\r\nthe issue; with it the whole `cpu_client_test` suite (48 tests) passes.\r\n\r\n## 🧪 Execution Tests:\r\n\r\nThe issue's module needs one more fix to run end-to-end with `run_hlo_module`:\r\nthe fake-argument generator leaves dynamic-dimension sizes uninitialized\r\n(garbage metadata), which is a separate defect in `MakeFakeLiteral` and will\r\nbe addressed in a follow-up PR. With both changes applied locally, the\r\nissue's module runs cleanly on CPU, Interpreter, and GPU with identical\r\nresults.","closed_at":"2026-09-19T17:54:06Z","comments":1,"comments_url":"https://api.github.com/repos/openxla/xla/issues/47804/comments","created_at":"2026-08-24T20:41:13Z","draft":false,"events_url":"https://api.github.com/repos/openxla/xla/issues/47804/events","html_url":"https://github.com/openxla/xla/pull/47804","id":5239244665,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/openxla/xla/issues/47804/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOHyx1PM8AAAABA2mzOA","num