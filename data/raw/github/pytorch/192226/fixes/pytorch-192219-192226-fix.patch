python test/inductor/test_triton_kernels.py -k test_triton_kernel_mutated_column_slice_of_intermediate
git checkout HEAD -- torch/_higher_order_ops/triton_kernel_wrap.py torch/_prims_common/__init__.py torch/_inductor/lowering.py torch/_inductor/fx_passes/post_grad.py
python test/inductor/test_triton_kernels.py -k test_triton_kernel_mutated_column_slice_of_intermediate
```

