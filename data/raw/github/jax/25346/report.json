   |\r\n|=========================================================================================|\r\n|    0   N/A  N/A   2549129      C   python                                        420MiB |\r\n|    1   N/A  N/A   2549129      C   python                                        416MiB |\r\n+-----------------------------------------------------------------------------------------+\r\n```","closed_at":null,"closed_by":null,"comments":1,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/25346/comments","created_at":"2024-12-09T15:42:07Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/25346/events","html_url":"https://github.com/jax-ml/jax/issues/25346","id":2727485796,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/25346/labels{/name}","locked":false,"milestone":null,"node_id":"I_kwDOCTkjjc6ikiFk","number":25346,"performed_via_github_app":null,"pinned_comment":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/25346/reactions"},"repository_url":"https://api.github.com/repos/jax-ml/jax","state":"open","state_reason":null,"sub_issues_summary":{"completed":0,"percent_completed":0,"total":0},"timeline_url":"https://api.github.com/repos/jax-ml/jax/issues/25346/timeline","title":"Error when donating buffer with under-specified sharding","type":null,"updated_at":"2025-03-26T11:07:54Z","url":"https://api.github.com/repos/jax-ml/jax/issues/25346","user":{"avatar_url":"https://avatars.githubusercontent.com/u/17763629?v=4","events_url":"https://api.github.com/use