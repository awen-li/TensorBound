d}","gravatar_id":"","html_url":"https://github.com/dionhaefner","id":11994217,"login":"dionhaefner","node_id":"MDQ6VXNlcjExOTk0MjE3","organizations_url":"https://api.github.com/users/dionhaefner/orgs","received_events_url":"https://api.github.com/users/dionhaefner/received_events","repos_url":"https://api.github.com/users/dionhaefner/repos","site_admin":false,"starred_url":"https://api.github.com/users/dionhaefner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dionhaefner/subscriptions","type":"User","url":"https://api.github.com/users/dionhaefner","user_view_type":"public"}},"pages":{"comments":[{"page":1,"records":7,"sha256":"35bf346936a3c1637421d6078d0697aa289c4f296108c7b45d33859c686d3943","url":"https://api.github.com/repos/jax-ml/jax/issues/5605/comments?per_page=100&page=1"}],"issue":[{"etag":"\"ab3a64b1fb955f6cbd678744cb13b523accf0c85ed5cb1097c966e34bb4f7c25\"","last_modified":"Sun, 27 Sep 2026 10:53:44 GMT","records":1,"url":"https://api.github.com/repos/jax-ml/jax/issues/5605"}],"timeline":[{"page":1,"records":10,"sha256":"b92508221445b0f2b8950416ff15dfd4d7cd7341754d4442660f3e689d686485","url":"https://api.github.com/repos/jax-ml/jax/issues/5605/timeline?per_page=100&page=1"}]},"record_id":"github-jax-ml-jax-5605","schema_version":"1.0.0","source_url":"https://github.com/jax-ml/jax/issues/5605","timeline":[{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"author_association":"COLLABORATOR","body":"Can you make a self-contained runnable repro? I'd like to debug this.","created_at":"2021-02-02T22:04:39Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/5605#issuecomment-772033485","id":772033485,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/5605","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDc3MjAzMzQ4NQ==","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/772033485/reactions"},"updated_at":"2021-02-02T22:04:39Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/772033485","user":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/11994217?v=4","events_url":"https://api.github.com/users/dionhaefner/events{/privacy}","followers_url":"https://api.github.com/users/dionhaefner/followers","following_url":"https://api.github.com/users/dionhaefner/following{/other_user}","gists_url":"https://api.github.com/users/dionhaefner/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/dionhaefner","id":11994217,"login":"dionhaefner","node_id":"MDQ6VXNlcjExOTk0MjE3","organizations_url":"https://api.github.com/users/dionhaefner/orgs","received_events_url":"https://api.github.com/users/dionhaefner/received_events","repos_url":"https://api.github.com/users/dionhaefner/repos","site_admin":false,"starred_url":"https://api.github.com/users/dionhaefner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dionhaefner/subscriptions","type":"User","url":"https://api.github.com/users/dionhaefner","user_view_type":"public"},"author_association":"NONE","body":"There you go. Turns out this is caused by the interplay of 2 jitted functions (+ grad) and using vanilla NumPy as input.\r\n\r\n```python\r\nimport numpy as np\r\nimport jax\r\nimport jax.numpy as jnp\r\n\r\n@jax.jit\r\ndef loss(observations):\r\n    out = jnp.mean(observations ** 2)\r\n    return out, out, out\r\n\r\n@jax.jit\r\ndef sgd_step(observations):\r\n    total_loss = lambda *args: sum(loss(*args))\r\n    gradients = jax.grad(total_loss)(observations)\r\n    return gradients\r\n\r\nobservations = np.ones([10])\r\n\r\ngradients = sgd_step(observations)\r\n\r\n# watch memory usage climb\r\nwhile True:\r\n    loss_components = loss(observations)\r\n    loss_components = [float(x) for x in loss_components]\r\n```","created_at":"2021-02-02T22:52:04Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/5605#issuecomment-772069173","id":772069173,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/5605","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDc3MjA2OTE3Mw==","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/772069173/reactions"},"updated_at":"2021-02-02T22:53:38Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/772069173","user":{"avatar_url":"https://avatars.githubusercontent.com/u/11994217?v=4","events_url":"https://api.github.com/users/dionhaefner/events{/privacy}","followers_url":"https://api.github.com/users/dionhaefner/followers","following_url":"https://api.github.com/users/dionhaefner/following{/other_user}","gists_url":"https://api.github.com/users/dionhaefner/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/dionhaefner","id":11994217,"login":"dionhaefner","node_id":"MDQ6VXNlcjExOTk0MjE3","organizations_url":"https://api.github.com/users/dionhaefner/orgs","received_events_url":"https://api.github.com/users/dionhaefner/received_events","repos_url":"https://api.github.com/users/dionhaefner/repos","site_admin":false,"starred_url":"https://api.github.com/users/dionhaefner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dionhaefner/subscriptions","type":"User","url":"https://api.github.com/users/dionhaefner","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2021-02-03T14:56:44Z","event":"assigned","id":4285724685,"intent":null,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQ0Mjg1NzI0Njg1","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/4285724685"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"author_association":"COLLABORATOR","body":"It turns out that this problem is already fixed at head (by https://github.com/tensorflow/tensorflow/commit/c7e983d2c43ddc355e565a8a98d4c2dc7540e771#diff-c725219b06d97640433601ea795280b143992eb046c5a79646587546c9395966 ). I don't yet know *why* that is the case. However, you could work around it by building a jaxlib from head for the moment.","created_at":"2021-02-03T15:40:14Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/5605#issuecomment-772603183","id":772603183,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/5605","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDc3MjYwMzE4Mw==","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/772603183/reactions"},"updated_at":"2021-02-03T15:40:14Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/772603183","user":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"author_association":"COLLABORATOR","body":"I'm pretty sure that's the right fix. We were creating cyclic Python garbage (via non-GC able C extension objects) on CPU (only). That refactoring also fixes the bug. Releases 0.1.58 and 0.1.59 are buggy; 0.1.57 should be fine, as is anything built from head.\r\n\r\nThanks for the easy reproduction! It made debugging quick and painless.","created_at":"2021-02-03T16:02:39Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/5605#issuecomment-772619753","id":772619753,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/5605","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDc3MjYxOTc1Mw==","performed_via_git