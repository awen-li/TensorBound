archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":9,"created_at":"2020-07-09T13:23:33Z","updated_at":"2023-04-08T01:33:21Z","closed_at":"2020-07-10T00:13:22Z","assignee":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"At the moment IREE runtime is leaking buffers allocated for unused inputs. A repro case:\r\n\r\n```mlir\r\nfunc @main(%arg0: tensor<4xf32>, %arg1: tensor<4xf32>) -> tensor<4xf32> attributes {iree.module.export} {\r\n  return %arg1 : tensor<4xf32>\r\n}\r\n```\r\n\r\n```shell\r\n$ iree-translate -iree-mlir-to-vm-bytecode-module --iree-hal-target-backends=vulkan-spirv ../unused-input.mlir > unused-input.vmfb \r\n\r\n$ iree-run-module --input_file=unused-input-vmla.vmfb --entry_function=main --inputs=\"4xf32,4xf32\" --driver=vulkan\r\n\r\nF ../third_party/vulkan_memory_allocator/src/vk_mem_alloc.h:11175] Check failed: m_pMetadata->IsEmpty() && \"Some allocations were not freed before destruction of this memory block!\"\r\n```\r\n\r\nThis is made obvious by Vulkan's VMA allocator. But it's not specific to Vulkan HAL backend; the code in the above does not perform any computation at all. It should also be revealed via ASAN for other backends.","closed_by":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/2455/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/iree-org/iree/issues/2455/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}