  "obligation_codebook": {
    "alias independence": "A destructive or reusing action occurs only when observable values do not depend on overlapping storage.",
    "completion and progress": "Required work completes before access, reuse, or release, and the execution retains a path to completion.",
    "happens-before ordering": "Dependencies and synchronization order conflicting operations before the later access or state change.",
    "identity correspondence": "The logical entity, position, or role selects the intended physical entity.",
    "index and offset preservation": "Coordinate, index, stride contribution, or byte offset denotes the same element or region after translation.",
    "initialization before publication": "Required content or runtime state is initialized successfully before it becomes observable or usable.",
    "layout compatibility": "Producer, consumer, view, and interface agree on shape, stride, and physical layout.",
    "ownership and lifetime": "Every object or reference remains owned and live through its last use and is released exactly once.",
    "placement and context consistency": "Device, stream, sharding, backend, or execution context remains consistent at use.",
    "policy and configuration propagation": "A semantic option, copy policy, precision request, or dynamic configuration reaches every decision it governs.",
    "range and alignment safety": "The selected extent, ordinal, allocation, vector width, or address satisfies its bound or alignment requirement.",
    "representation fidelity": "Bit width, signedness, precision, dtype, or packed representation preserves the intended value.",
    "resource and capability agreement": "Compiler assumptions and runtime resources or capabilities agree, or incompatibility is rejected.",
    "transformation equivalence": "A fusion, rewrite, cache reuse, or fast path is selected only when its semantic preconditions hold.",
    "value semantics preservation": "A rewrite or state change preserves the value visible to downstream computation."
  },
