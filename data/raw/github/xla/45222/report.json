://avatars.githubusercontent.com/u/194224583?v=4","events_url":"https://api.github.com/users/penumallas1261/events{/privacy}","followers_url":"https://api.github.com/users/penumallas1261/followers","following_url":"https://api.github.com/users/penumallas1261/following{/other_user}","gists_url":"https://api.github.com/users/penumallas1261/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/penumallas1261","id":194224583,"login":"penumallas1261","node_id":"U_kgDOC5Ohxw","organizations_url":"https://api.github.com/users/penumallas1261/orgs","received_events_url":"https://api.github.com/users/penumallas1261/received_events","repos_url":"https://api.github.com/users/penumallas1261/repos","site_admin":false,"starred_url":"https://api.github.com/users/penumallas1261/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/penumallas1261/subscriptions","type":"User","url":"https://api.github.com/users/penumallas1261","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-07-06T03:45:13Z","event":"assigned","id":27587451165,"intent":null,"node_id":"AE_lADOHyx1PM8AAAABHnpR4c8AAAAGbFcZHQ","performed_via_github_app":null,"url":"https://api.github.com/repos/openxla/xla/issues/events/27587451165"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/194224583?v=4","events_url":"https://api.github.com/users/penumallas1261/events{/privacy}","followers_url":"https://api.github.com/users/penumallas1261/followers","following_url":"https://api.github.com/users/penumallas1261/following{/other_user}","gists_url":"https://api.github.com/users/penumallas1261/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/penumallas1261","id":194224583,"login":"penumallas1261","node_id":"U_kgDOC5Ohxw","organizations_url":"https://api.github.com/users/penumallas1261/orgs","received_events_url":"https://api.github.com/users/penumallas1261/received_events","repos_url":"https://api.github.com/users/penumallas1261/repos","site_admin":false,"starred_url":"https://api.github.com/users/penumallas1261/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/penumallas1261/subscriptions","type":"User","url":"https://api.github.com/users/penumallas1261","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-07-06T03:45:26Z","event":"labeled","id":27587455379,"intent":null,"label":{"color":"d73a4a","name":"bug"},"node_id":"LE_lADOHyx1PM8AAAABHnpR4c8AAAAGbFcpkw","performed_via_github_app":null,"url":"https://api.github.com/repos/openxla/xla/issues/events/27587455379"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/161562995?v=4","events_url":"https://api.github.com/users/Ashutosh0x/events{/privacy}","followers_url":"https://api.github.com/users/Ashutosh0x/followers","following_url":"https://api.github.com/users/Ashutosh0x/following{/other_user}","gists_url":"https://api.github.com/users/Ashutosh0x/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Ashutosh0x","id":161562995,"login":"Ashutosh0x","node_id":"U_kgDOCaFBcw","organizations_url":"https://api.github.com/users/Ashutosh0x/orgs","received_events_url":"https://api.github.com/users/Ashutosh0x/received_events","repos_url":"https://api.github.com/users/Ashutosh0x/repos","site_admin":false,"starred_url":"https://api.github.com/users/Ashutosh0x/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ashutosh0x/subscriptions","type":"User","url":"https://api.github.com/users/Ashutosh0x","user_view_type":"public"},"created_at":"2026-07-27T06:21:31Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"CONTRIBUTOR","body":"### Summary\n\n`DecomposeCollectivePermuteCycle` recombines the backward and forward `collective-permute` with\n\n```\nselect(compare(partition-or-replica-id, bwd_recv_id), back_cp, fwd_cp)\n```\n\nbut `bwd_recv_id` was taken from a single back edge:\n\n```c++\nint64_t bwd_recv_id = back_pairs.back().second;\n```\n\n`GetCycleTypeAndIndices` returns **one back edge per cycle**, and `DecomposeCollectivePermuteCycle` accumulates all of them into `back_pairs`. When `source_target_pairs` describes several disjoint cycles there is therefore more than one back-edge target, and a scalar equality cannot express membership in that set. Every back-edge receiver except the last selects `fwd_cp`, in which it is not a target, and per collective-permute semantics a non-target outputs zeros — so those devices silently receive zeros instead of their permuted data.\n\nFixes #45222. Full credit to the reporter, whose analysis localised this precisely.\n\n### The pass's own test demonstrated it\n\n`ForwardCycleMultipleCycles` uses `{{0,2},{2,4},{4,6},{6,0},{1,3},{3,5},{5,7},{7,1}}` — two disjoint 4-cycles. The back-edge indices are `{3,7}`, so `back_pairs = {{6,0},{7,1}}` and `bwd_recv_id = 1`. Device 0 is the target of back edge `{6,0}` and must receive device 6's value, but `id == 1` is false for device 0, so it selected `fwd_cp` — whose targets are `{2,4,6,3,5,7}` — and received zero.\n\nThe test's FileCheck asserted exactly that shape (`constant(1)`, one compare), so it encoded the bug rather than catching it.\n\n### Fix\n\nOr the per-target comparisons together:\n\n```c++\n  HloInstruction* compare = nullptr;\n  for (const std::pair<int64_t, int64_t>& back_pair : back_pairs) {\n    ...\n    compare = compare == nullptr ? is_bwd_recv\n                                 : /* or(compare, is_bwd_recv) */;\n  }\n```\n\nFor a **single** cycle `back_pairs` has one element, the loop runs once, no `or` is emitted, and the generated HLO is byte-identical to before — so `ForwardCycle`, `ForwardCycleNoChannel`, `BackwardCycle`, `BackwardCycleNoChannel` and `ForwardCycleWithMatmul` are unaffected. Only the multi-cycle expectation changes.\n\n### Verification\n\nI could not build XLA on this machine, so this rests on CI. The reasoning above is from the source and the pass's own test vectors; the emitted-HLO claim for the single-cycle path is by construction (the loop body is the previous code, executed once).\n","closed_at":null,"comments":3,"comments_url":"https://api.github.com/repos/openxla/xla/issues/46248/comments","created_at":"2026-07-27T06:21:29Z","draft":false,"events_url":"https://api.github.com/repos/openxla/xla/issues/46248/events","html_url":"https://github.com/openxla/xla/pull/46248","id":4984991524,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/openxla/xla/issues/46248/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOHyx1PM72wP70","number":46248,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/openxla/xla/pull/46248.diff","html_url":"https://github.com/openxla/xla/pull/46248","merged_at":null,"patch_url":"https://github.com/openxla/xla/pull/46248.patch","url":"https://api.github.com/repos/openxla/xla/pulls/46248"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/openxla/xla/issues/46248/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/openxla/xla/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/openxla/xla/assignees{/user}","blobs_url":"https://api.github.com/repos/openxla/xla/git/blobs{/sha}","branches_url":"https://api.github.com/repos/openxla/xla/branches{/branch}","clone_url":"https://github.com/openxla/xla.git","collaborators_url":"https://api.github.com/repos/openxla/xla/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/openxla/xla/comments{/number}","commits_url":"https://api.github.com/repos/openxla/xla/commits{/sha}","compare_url":"https://api.github.com/repos/openxla/xla/compare/{base}...{head}","contents_url":"https://api.github.com/repos/openxla/xla/contents/{+path}","contributors_url":"https://api.github.com/repos/openxla/x