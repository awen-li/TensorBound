3.13.txt     --test_env=JAX_TEST_NUM_THREADS=30     --test_ou\ntput=errors         --local_test_jobs=10     --test_timeout=3600        --nocache_test_results --runs_per_test=100       //tests:string_array_test_cpu &> bazel_string_a\nrray_test_cpu.log\n```\n\n\n\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\nTSAN 3.13-ft cpython\nLinux\n","closed_at":"2025-05-06T23:14:58Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/in/44061?v=4","events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/events{/privacy}","followers_url":"https://api.github.com/users/copybara-service%5Bbot%5D/followers","following_url":"https://api.github.com/users/copybara-service%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/copybara-service%5Bbot%5D/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apps/copybara-service","id":56741989,"login":"copybara-service[bot]","node_id":"MDM6Qm90NTY3NDE5ODk=","organizations_url":"https://api.github.com/users/copybara-service%5Bbot%5D/orgs","received_events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/received_events","repos_url":"https://api.github.com/users/copybara-service%5Bbot%5D/repos","site_admin":false,"starred_url":"https://api.github.com/users/copybara-service%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/copybara-service%5Bbot%5D/subscriptions","type":"Bot","url":"https://api.github.com/users/copybara-service%5Bbot%5D","user_view_type":"public"},"comments":0,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/28385/comments","created_at":"2025-04-29T12:35:22Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/28385/events","html_url":"https://github.com/jax-ml/jax/issues/28385","id":3028165777,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73