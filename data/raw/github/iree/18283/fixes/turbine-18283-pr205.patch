From 657ec91b03d7b919d177b14d81db871ac58382f0 Mon Sep 17 00:00:00 2001
From: Boian Petkantchin <boian.petkantchin@amd.com>
Date: Tue, 8 Oct 2024 10:44:41 -0500
Subject: [PATCH] Enforce static dimensions in generation of
 flow.tensor.transfer

Signed-off-by: Boian Petkantchin <boian.petkantchin@amd.com>
---
 iree/turbine/ops/iree.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/iree/turbine/ops/iree.py b/iree/turbine/ops/iree.py
index 1609db2bb..b4d79aeec 100644
--- a/iree/turbine/ops/iree.py
+++ b/iree/turbine/ops/iree.py
@@ -83,7 +83,8 @@ class transfer_to_logical_device(CustomOp):
     def select(self, ksel: KernelSelection):
         ksel.attr_str(0)
         ta = ksel.arg_tensor(1)
-        ksel.return_tensor(ta.t)
+        ta.specialize_all_dims()
+        ksel.return_tensor(ta.t).specialize_all_dims()
 
     def eager_execute(self, device_moniker, tensor):
         return tensor
