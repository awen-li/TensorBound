diff --git a/jax/_src/util.py b/jax/_src/util.py
index e506468e6557..b11192ebb3a1 100644
--- a/jax/_src/util.py
+++ b/jax/_src/util.py
@@ -22,7 +22,7 @@
 import numpy as np
 
 import jax
-from jax.config import FLAGS
+from jax.config import config
 
 partial = functools.partial
 
@@ -195,7 +195,7 @@ def wrapper(*args, **kwargs):
       if jax.core.debug_state.check_leaks:
         return f(*args, **kwargs)
       else:
-        return cached(bool(FLAGS.jax_enable_x64), *args, **kwargs)
+        return cached(bool(config.x64_enabled), *args, **kwargs)
 
     wrapper.cache_clear = cached.cache_clear
     wrapper.cache_info = cached.cache_info
@@ -209,7 +209,7 @@ def memoized(_, *args, **kwargs):
 
   @functools.wraps(f)
   def wrapper(*args, **kwargs):
-    return memoized(bool(FLAGS.jax_enable_x64), *args, **kwargs)
