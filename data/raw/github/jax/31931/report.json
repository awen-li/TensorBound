MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}],"author_association":"NONE","body":"### Description\n\nThe unreduced einsum `[f{X}] @ [f{X}] -> []{X}` fails with:\n\n```\nAssertionError: Unexpected XLA sharding override: (XLA) GSPMDSharding({replicated}, memory_kind=device) != NamedSharding(mesh=Mesh('X': 2, 'Y': 2, axis_types=(Explicit, Explicit)), spec=PartitionSpec(unreduced={'X'}), memory_kind=device) (User sharding)\n```\n\nAdding an extra replicated dimension to either side of the einsum, or removing the `unreduced=` makes the problem go away. So possibly the bug specifically affects reductions that return scalars?\n\n```\nimport os\n\nos.environ[\"XLA_FLAGS\"] = \"--xla_force_host_platform_device_count=4\"\n\nimport functools\n\nimport jax\nimport jax.numpy as jnp\nfrom jax.experimental import mesh_utils\nfrom jax.sharding import AxisType, Mesh, NamedSharding, PartitionSpec\n\njax.config.update(\"jax_use_shardy_partitioner\", True)\n\ndevices = mesh_utils.create_device_mesh((2, 2))\nexplicit_mesh = Mesh(\n    devices,\n    axis_names=[\"X\", \"Y\"],\n    axis_types=(AxisType.Explicit, AxisType.Explicit),\n)\n\neinsum_notation = \"f,f->\"\n\n\n@functools.partial(jax.jit, static_argnames=(\"out_sharding\"))\ndef einsum_fn(*args, out_sharding=None):\n    return jnp.einsum(einsum_notation, *args, out_sharding=out_sharding)\n\n\nall_specs_presharded = [\n    PartitionSpec(\"X\"),\n    PartitionSpec(\"X\"),\n]\nexpected_partition_spec = PartitionSpec(unreduced={\"X\"})\n\narrays = [jnp.ones(shape, dtype=jnp.float32) for shape in [(2,), (2,)]]\n\nassert len(arrays) == len(all_specs_presharded)\n\nprint(\n    einsum_fn(\n        *[\n            jax.device_put(arr, NamedSharding(explicit_mesh, spec))\n            for arr, spec in zip(arrays, all_specs_presharded, strict=True)\n        ],\n        out_sharding=NamedSharding(explicit_mesh, expected_partition_spec),\n    )\n)\n```\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n```\njax:    0.7.2\njaxlib: 0.7.2\nnumpy:  2.3.2\npython: 3.11.13 (main, Sep 10 2025, 12:53:42) [GCC 11.4.0]\ndevice info: cpu-1, 1 local devices\"\nprocess_count: 1\nplatform: uname_result(system='Linux', node='coder-maxb-maxb-0', release='6.1.119-129.201.amzn2023.x86_64', version='#1 SMP PREEMPT_DYNAMIC Tue Dec  3 21:07:35 UTC 2024', machine='x86_64')\n```","closed_at":"2025-09-18T23:57:03Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/in/44061?v=4","events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/events{/privacy}","followers_url":"https://api.github.com/users/copybara-service%5Bbot