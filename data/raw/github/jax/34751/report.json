thub.com/repos/jax-ml/jax/issues/events/22445592832"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/230031441?v=4","events_url":"https://api.github.com/users/hrideymarwah15/events{/privacy}","followers_url":"https://api.github.com/users/hrideymarwah15/followers","following_url":"https://api.github.com/users/hrideymarwah15/following{/other_user}","gists_url":"https://api.github.com/users/hrideymarwah15/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hrideymarwah15","id":230031441,"login":"hrideymarwah15","node_id":"U_kgDODbYAUQ","organizations_url":"https://api.github.com/users/hrideymarwah15/orgs","received_events_url":"https://api.github.com/users/hrideymarwah15/received_events","repos_url":"https://api.github.com/users/hrideymarwah15/repos","site_admin":false,"starred_url":"https://api.github.com/users/hrideymarwah15/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hrideymarwah15/subscriptions","type":"User","url":"https://api.github.com/users/hrideymarwah15","user_view_type":"public"},"commit_id":"55cd16d568ab936bc16d0a7cb63b89e5679492f4","commit_url":"https://api.github.com/repos/hrideymarwah15/jax/commits/55cd16d568ab936bc16d0a7cb63b89e5679492f4","created_at":"2026-02-02T11:33:07Z","event":"referenced","id":22462752062,"node_id":"REFE_lADOCTkjjc7naJdezwAAAAU64mU-","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/22462752062"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/230031441?v=4","events_url":"https://api.github.com/users/hrideymarwah15/events{/privacy}","followers_url":"https://api.github.com/users/hrideymarwah15/followers","following_url":"https://api.github.com/users/hrideymarwah15/following{/other_user}","gists_url":"https://api.github.com/users/hrideymarwah15/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hrideymarwah15","id":230031441,"login":"hrideymarwah15","node_id":"U_kgDODbYAUQ","organizations_url":"https://api.github.com/users/hrideymarwah15/orgs","received_events_url":"https://api.github.com/users/hrideymarwah15/received_events","repos_url":"https://api.github.com/users/hrideymarwah15/repos","site_admin":false,"starred_url":"https://api.github.com/users/hrideymarwah15/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hrideymarwah15/subscriptions","type":"User","url":"https://api.github.com/users/hrideymarwah15","user_view_type":"public"},"created_at":"2026-02-02T11:39:15Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"CONTRIBUTOR","body":"## Summary\n\nFixes #34751: Ensures non-canonical boolean values (e.g., 0xff) convert correctly to integers.\n\n## Problem\n\nPreviously, when converting boolean arrays to integers, JAX would directly cast the underlying memory representation. This caused issues with non-canonical boolean values:\n- A boolean value of `0xff` (255) would be sign-extended to `-1` when converting to signed integers\n- Expected behavior: any truthy boolean value should convert to `1`\n\n## Solution\n\nModified `convert_hlo()` in `jax/_src/interpreters/mlir.py` to canonicalize boolean values before conversion:\n- When converting FROM boolean types, use `hlo.select()` to explicitly map `True` to `1` and `False` to `0`\n- This ensures consistent behavior regardless of the underlying memory representation\n\n## Changes\n\n1. **Updated conversion logic**: Added special handling for bool-to-non-bool conversions using `hlo.select()`\n2. **Enhanced documentation**: Updated docstring to explain the canonicalization behavior\n3. **Added comprehensive tests**: New test case `testConvertElementTypeBoolToIntNonCanonical()` that:\n   - Creates non-canonical boolean arrays using `np.frombuffer()`\n   - Tests conversion through multiple code paths (direct array creation, `lax.convert_element_type()`, JIT compilation)\n   - Verifies that `[False, True, True]` converts to `[0, 1, 1]`, not `[0, 1, -1]`\n\n## Testing\n\nThe fix includes thorough testing to ensure:\n- ✅ Non-canonical boolean values convert correctly\n- ✅ Regular boolean conversions continue to work\n- ✅ JIT compilation produces correct results\n- ✅ No regression in existing functionality\n\n## Backward Compatibility\n\nThis change is fully backward compatible and only affects edge cases with non-canonical boolean representations. Normal boolean operations remain unchanged.","closed_at":null,"comments":2,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/34763/comments","created_at":"2026-02-02T11:39:14Z","draft":false,"events_url":"https://api.github.com/repos/jax-ml/jax/issues/34763/events","html_url":"https://github.com/jax-ml/jax/pull/34763","id":3885465047,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/34763/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOCTkjjc7A49jF","number":34763,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/jax-ml/jax/pull/34763.diff","html_url":"https://github.com/jax-ml/jax/pull/34763","merged_at":null,"patch_url":"https://github.com/jax-ml/jax/pull/34763.patch","url":"https://api.github.com/repos/jax-ml/jax/pulls/34763"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/34763/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/jax-ml/jax/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/jax-ml/jax/assignees{/user}","blobs_url":"https://api.github.com/repos/jax-ml/jax/git/blobs{/sha}","branches_url":"https://api.github.com/repos/jax-ml/jax/branches{/branch}","clone_url":"https://github.com/jax-ml/jax.git","collaborators_url":"https://api.github.com/repos/jax-ml/jax/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/jax-ml