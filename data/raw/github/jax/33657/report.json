url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"}],"author_association":"NONE","body":"### Description\n\nWhile exporting a jax function that uses shard_map, memory kind is not respected both on the input and output.\n\nReproducer:\n```python\nimport jax\nfrom jax import export as jax_export\nimport numpy as np\n\nmesh_devices = np.array(jax.devices())\nmesh = jax.sharding.Mesh(mesh_devices, ('x'))\ndef _function_with_shard_map(x):\n  return jax.shard_map(lambda x: x + 1, in_specs=jax.sharding.PartitionSpec(), out_specs=jax.sharding.PartitionSpec(), mesh=mesh.abstract_mesh, check_vma=False)(x)\n\n# A value in host mem.\ninput_shd = jax.sharding.NamedSharding(mesh, jax.sharding.PartitionSpec(), memory_kind='pinned_host')\noutput_shd = jax.sharding.NamedSharding(mesh, jax.sharding.PartitionSpec(), memory_kind='pinned_host')\na = jax.device_put(1, input_shd)\n\n# WORKS\nf = jax.jit(_function_with_shard_map, in_shardings=(input_shd), out_shardings=(output_shd))\n\nb = f(a)\nassert a.sharding == input_shd\nassert b.sharding == output_shd\n\ndo_export = jax_export.export(f)\nexported = do_export(a)\n# FAILS\n# AssertionError: NamedSharding(mesh=Mesh('x': 8, axis_types=(Auto,)), spec=PartitionSpec(), memory_kind=device)\nassert exported.in_shardings_jax(mesh)[0] == input_shd, exported.in_shardings_jax(mesh)[0]\n# AssertionError: NamedSharding(mesh=Mesh('x': 8, axis_types=(Auto,)), spec=PartitionSpec(), memory_kind=device)\nas