icoBruzzone/orgs","received_events_url":"https://api.github.com/users/FedericoBruzzone/received_events","repos_url":"https://api.github.com/users/FedericoBruzzone/repos","site_admin":false,"starred_url":"https://api.github.com/users/FedericoBruzzone/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FedericoBruzzone/subscriptions","type":"User","url":"https://api.github.com/users/FedericoBruzzone","user_view_type":"public"},"created_at":"2026-07-23T08:05:57Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"MEMBER","body":"`HALDispatchABI::loadProcessorData` built its CPU-feature patch buffer with an `alloca` at the ukernel call site instead of the function entry block. `RewriteCallOpABI` materializes this after all MLIR->LLVM conversions are done, so no later pass can hoist it out of a loop if the call happens to sit inside one, causing the stack to grow unboundedly on large matmuls. \r\n\r\nThe computation only depends on the function's `environment` argument and static target attributes, so it can safely move to the entry block.\r\n\r\nFixes #24744","closed_at":"2026-07-24T06:40:34Z","comments":9,"comments_url":"https://api.github.com/repos/iree-org/iree/issues/24749/comments","created_at":"2026-07-23T08:05:56Z","draft":false,"events_url":"https://api.github.com/repos/iree-org/iree/issues/24749/events","html_url":"https://github.com/iree-org/iree/pull/24749","id":4956787579,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/iree-org/iree/issues/24749/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDODGgK6M71Qrig","number":24749,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/iree-org/iree/pull/24749.diff","html_url":"https://github.com/iree-org/iree/pull/24749","merged_at":"2026-07-24T06:40:34Z","patch_url":"https://github.com/iree-org/iree/pull/24749.patch","url":"https://api.github.com/repos