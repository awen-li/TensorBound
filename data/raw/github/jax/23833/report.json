mentation='cudnn')\r\n)\r\n\r\nout = dpsa_cudnn(query, key, value)\r\nprint(out[0,0,0,0])\r\n```\r\n\r\nI'm using cuDNN 9.4 + CUDA 12.6 on Hopper with XLA and JAX at head.","created_at":"2024-10-09T20:52:09Z","html_url":"https://github.com/jax-ml/jax/issues/23833#issuecomment-2403407274","id":2403407274,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/23833","minimized":null,"node_id":"IC_kwDOCTkjjc6PQRWq","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2403407274/reactions"},"updated_at":"2024-10-09T20:52:09Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2403407274","user":{"avatar_url":"https://avatars.githubusercontent.com/u/25362393?v=4","events_url":"https://api.github.com/users/Cjkkkk/events{/privacy}","followers_url":"https://api.github.com/users/Cjkkkk/followers","following_url":"https://api.github.com/users/Cjkkkk/following{/other_user}","gists_url":"https://api.github.com/users/Cjkkkk/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Cjkkkk","id":25362393,"login":"Cjkkkk","node_id":"MDQ6VXNlcjI1MzYyMzkz","organizations_url":"https://api.github.com/users/Cjkkkk/orgs","received_events_url":"https://api.github.com/users/Cjkkkk/received_events","repos_url":"https://api.github.com/users/Cjkkkk/repos","site_admin":false,"starred_url":"https://api.github.com/users/Cjkkkk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cjkkkk/subscriptions","type":"User","url":"https://api.github.com/users/Cjkkkk","user_view_type":"public"}},{"author_association":"NONE","body":"I  use the cudnn 9.5 + CUDA12.6. It may be due to version incompatibility.","created_at":"2024-10-10T02:48:40Z","html_url":"https://github.com/jax-ml/jax/issues/23833#issuecomment-2403832291","id":2403832291,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/23833","m