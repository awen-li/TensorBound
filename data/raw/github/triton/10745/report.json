ithub.com/users/Hughshine/followers","following_url":"https://api.github.com/users/Hughshine/following{/other_user}","gists_url":"https://api.github.com/users/Hughshine/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Hughshine","id":32846078,"login":"Hughshine","node_id":"MDQ6VXNlcjMyODQ2MDc4","organizations_url":"https://api.github.com/users/Hughshine/orgs","received_events_url":"https://api.github.com/users/Hughshine/received_events","repos_url":"https://api.github.com/users/Hughshine/repos","site_admin":false,"starred_url":"https://api.github.com/users/Hughshine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hughshine/subscriptions","type":"User","url":"https://api.github.com/users/Hughshine","user_view_type":"public"}},"type":"issue"},"updated_at":"2026-06-29T07:00:03Z"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/32846078?v=4","events_url":"https://api.github.com/users/Hughshine/events{/privacy}","followers_url":"https://api.github.com/users/Hughshine/followers","following_url":"https://api.github.com/users/Hughshine/following{/other_user}","gists_url":"https://api.github.com/users/Hughshine/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Hughshine","id":32846078,"login":"Hughshine","node_id":"MDQ6VXNlcjMyODQ2MDc4","organizations_url":"https://api.github.com/users/Hughshine/orgs","received_events_url":"https://api.github.com/users/Hughshine/received_events","repos_url":"https://api.github.com/users/Hughshine/repos","site_admin":false,"starred_url":"https://api.github.com/users/Hughshine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hughshine/subscriptions","type":"User","url":"https://api.github.com/users/Hughshine","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-06-29T07:05:22Z","event":"renamed","id":27316243694,"node_id":"RTE_lADOAWaHXs8AAAABHACBPs8AAAAGXCzM7g","performed_via_github_app":null,"rename":{"from":"[BUG][AMD] fp8 e4m3fnuz/e5m2fnuz NaN (byte 0x80) silently decodes to fp16 -0.0 instead of NaN on non-CDNA3 GPUs","to":"[BUG][AMD] fp8 e4m3fnuz/e5m2fnuz NaN (byte 0x80) silently decodes to fp16/bf16 -0.0 instead of NaN on non-CDNA3 GPUs"},"url":"https://api.github.com/repos/triton-lang/triton/issues/events/27316243694"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/91481003?v=4","events_url":"https://api.github.com/users/liminfei-amd/events{/privacy}","followers_url":"https://api.github.com/users/liminfei-amd/followers","following_url":"https://api.github.com/users/liminfei-amd/following{/other_user}","gists_url":"https://api.github.com/users/liminfei-amd/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/liminfei-amd","id":91481003,"login":"liminfei-amd","node_id":"MDQ6VXNlcjkxNDgxMDAz","organizations_url":"https://api.github.com/users/liminfei-amd/orgs","received_events_url":"https://api.github.com/users/liminfei-amd/received_events","repos_url":"https://api.github.com/users/liminfei-amd/repos","site_admin":false,"starred_url":"https://api.github.com/users/liminfei-amd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/liminfei-amd/subscriptions","type":"User","url":"https://api.github.com/users/liminfei-amd","user_view_type":"public"},"created_at":"2026-07-02T04:50:46Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"NONE","body":"## Description\n\nThe FNUZ fp8 formats (`float8_e4m3fnuz` / `float8_e5m2fnuz`) have a **single** NaN encoding, `0x80` — the `-0` slot is repurposed as NaN and there is no Inf. On AMD targets without native FNUZ-fp8 hardware conversion (everything except CDNA3 — CDNA1/gfx908, CDNA2/gfx90a, CDNA4/gfx950, and RDNA) the upcast to fp16/bf16/fp32 is emulated in software, and the software decoders in `ConvertFpCastOpToLLVM.cpp` turned `0x80` into a finite `-0.0`, silently dropping the NaN (#10745).\n\nThree decoders were affected:\n\n- **`Fp8E4M3fnuzToFp16OneValue`** — the `0x80 → 0x7E00` NaN guard ran *before* the denorm/zero LUT. For `0x80`, `vAbs = 0x80 & 0x7F == 0` matched `LUT[0] = 0x0000`, overwriting the NaN, and the trailing sign re-apply produced `0x8000`. Moved the guard to be the **final write** so it yields `0x7E00`.\n- **`Fp8E5M2fnuzToFp16OneValue`** — no NaN guard existed; with `exp == 0` the `e_is_zero` branch produced `sign | (m >> 1) = 0x8000`. Added the `0x80 → 0x7E00` guard as the final write.\n- **`Fp8E4M3fnuzToBf16SW`** — no NaN guard; the abs-mask zeroed the magnitude and the sign was OR'd back, giving bf16 `0x8000`. Guard each unpacked lane to the bf16 NaN `0x7FC0`.\n\nThe other fnuz upcasts (`e5m2fnuz → bf16`, and both `→ fp32`) route through the decoders above, so all six `{e4m3fnuz, e5m2fnuz} × {fp16, bf16, fp32}` upcasts are fixed.\n\n## Validation\n\nBuilt current `main` from source and ran a byte-exhaustive check on **RDNA4 (gfx1201, RX 9070)** comparing every fp8 code against the `torch.float8_e{4m3,5m2}fnuz .to(dtype)` reference:\n\n- **before:** all six combos diverge from the reference at exactly one code, `0x80` (upcast to a finite `-0.0` instead of NaN); the other 255 codes match.\n- **after:** all 256 codes match the reference for all six combos; `0x80` now upcasts to NaN (`0x7E00` fp16/fp32, `0x7FC0` bf16).\n\nAdds `test_typeconvert_upcast_fnuz_nan` (the existing exhaustive upcast test explicitly excludes `0x80`, which is why this slipped through). It passes on the patched build for all six combos.\n\n## New contributor declaration\n\n- [x] I am not making a trivial change, such as fixing a typo in a comment.\n- [x] I have written a PR description following the guidelines above.\n- [x] I have added tests relevant to the changes.\n- [x] I have run pre-commit locally on my changes.\n- AI usage: an AI coding assistant helped with the investigation, the hardware reproduction/validation, and drafting this description; I reviewed the change and can explain every line.\n\nFixes #10745\n","closed_at":"2026-07-02T05:33:53Z","comments":1,"comments_url":"https://api.github.com/repos/triton-lang/triton/issues/10778/comments","created_at":"2026-07-02T04:50:45Z","draft":false,"events_url":"https://api.github.com/repos/triton-lang/triton/issues/10778/events","html_url":"https://github.com/triton-lang/triton/pull/10778","id":4791362249,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/triton-lang/triton/issues/10778/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOAWaHXs7s94Rk","number":10778,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/triton-lang/triton/pull/10778.diff","html_url":"https://github.com/triton-lang/triton/pull/10778","merged_at":null,"patch_url":"https://github.com/triton-lang/triton/pull/10778.patch","url":"https://api.github.com/repos/triton-lang/triton/pulls/10778"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/triton-lang/triton/issues/10778/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/triton-lang/triton/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/triton-lang/triton/assignees{/user}","blobs_url":"https://api.github.com/repos/triton-lang/triton/git/blobs{/sha}","branches_url":"https://api.github.com/repos/triton-lang/triton/branches{/branch}","clone_url":"https://github.com/triton-lang/triton.git","collaborators_url":"https://api.github.com/repos/triton-lang/triton/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/triton-lang/triton/comments{/number}","commits_url":"https://api.github.com/repos/triton-lang/triton/commits{/sha}","compare_url":"https://api.github.com/repos/triton-lang/triton/compare/{base}...{head}","contents_url":"https://api.github.com/repos/triton-lang/triton/contents/{+path}","contributors_url":"https: