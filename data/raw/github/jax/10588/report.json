lucagrementieri/received_events","repos_url":"https://api.github.com/users/lucagrementieri/repos","site_admin":false,"starred_url":"https://api.github.com/users/lucagrementieri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lucagrementieri/subscriptions","type":"User","url":"https://api.github.com/users/lucagrementieri","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2022-05-23T09:00:09Z","event":"closed","id":6659125630,"intent":null,"node_id":"CE_lADOCTkjjc5JHp2kzwAAAAGM6jF-","performed_via_github_app":null,"state_reason":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/6659125630"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"author_association":"COLLABORATOR","body":"This is mostly about the code that generates the HLO. By default, the textual representation of HLO elides large constants. It can be changed not to do that: it's an option when printing the HLO as a string.\r\n\r\nI'm not sure whether that's appropriate in this particular case or not: here the option is explicitly labeled as debug output. But perhaps