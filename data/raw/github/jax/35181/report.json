XNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}],"author_association":"NONE","body":"### Description\n\nExplicit sharding + reverse-mode fails on singleton axis \n\n**Minimal Example:**\n```python\nimport jax, jax.numpy as jnp\nfrom jax.sharding import AxisType, PartitionSpec as P\n\nmesh = jax.make_mesh((1,), (\"data\",), (AxisType.Explicit,))\njax.set_mesh(mesh)\n\nx = jnp.ones((1,), out_sharding=P(\"data\"))\nf = lambda x: jnp.expand_dims(x, -1).sum()\n\nprint(jax.jit(jax.value_and_grad(f))(x))\n```\n\nRaises: `ValueError: Input primal JAX type to VJP function is float32[1@data]. Hence the expected cotangent type is float32[1@data] but got float32[1]`\n\nIf the input shape is `(2,)` instead of `(1,)` this passes. I suspect this is due to the way unit dims are treated in `_broadcast_in_dim_transpose_rule` in `lax.py`. \n\nThis also affects common workflows, e.g. RMSNorm with batch size 1 raises the same ValueError:\n```python\nx = jnp.ones((1, 4), out_sharding=P(\"data\"))\n\ndef norm(x):\n    return x * lax.rsqrt(jnp.mean(x**2, axis=-1, keepdims=True))\n\nf = lambda x: norm(x).sum()\njax.grad(f)(x)\n```\n\nThis fails on JAX 0.8.2 and 0.9.0 but worked on 0.8.1 (although this might just be due to new checks).\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\njax:    0.9.0.1\njaxlib: 0.9.0.1\nnumpy:  2.4.2\npython: 3.11.13 (main, Jul  8 2025, 20:42:09) [Clang 20.1.4 ]\ndevice info: cpu-1, 1 local devices\"\nprocess_count: 1","closed_at":"2026-02-18T17:09:58Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/in/44061?v=4","events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/events{/privacy}","followers_url":"https://api.github.com/users/copybara-service%5Bbot%5D/followers","following_url":"https://api.github.com/users/copybara-service%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/copybara-service%5Bbot%5D/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/apps/copybara-service","id":56741989,"login":"copybara-service[bot]","node_id":"MDM6Qm90NTY3NDE5ODk=","organizations_url":"https://api.github.com/users/copybara-service%5Bbot%5D/orgs","received_events_url":"https://api.github.com/users/copybara-service%5Bbot%5D/received_events","repos_url":"https://api.github.com/users/copybara-service%5Bbot%5D/repos","site_admin":false,"starred_url":"https://api.github.com/users/copybara-service%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/copybara-service%5Bbot%5D/subscriptions","type":"Bot","url":"https://api.github.com/users/copybara-servic