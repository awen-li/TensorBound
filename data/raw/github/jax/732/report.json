ers/mattjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattjj/subscriptions","type":"User","url":"https://api.github.com/users/mattjj","user_view_type":"public"},"commit_id":"42a1ad4307a0664ab514050cc8f58939d3766bdb","commit_url":"https://api.github.com/repos/jax-ml/jax/commits/42a1ad4307a0664ab514050cc8f58939d3766bdb","created_at":"2019-05-20T01:49:44Z","event":"referenced","id":2351775764,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDIzNTE3NzU3NjQ=","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/2351775764"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/1458824?v=4","events_url":"https://api.github.com/users/mattjj/events{/privacy}","followers_url":"https://api.github.com/users/mattjj/followers","following_url":"https://api.github.com/users/mattjj/following{/other_user}","gists_url":"https://api.github.com/users/mattjj/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/mattjj","id":1458824,"login":"mattjj","node_id":"MDQ6VXNlcjE0NTg4MjQ=","organizations_url":"https://api.github.com/users/mattjj/orgs","received_events_url":"https://api.github.com/users/mattjj/received_events","repos_url":"https://api.github.com/users/mattjj/repos","site_admin":false,"starred_url":"https://api.github.com/users/mattjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattjj/subscriptions","type":"User","url":"https://api.github.com/users/mattjj","user_view_type":"public"},"created_at":"2019-05-20T01:50:23Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"COLLABORATOR","body":"Here are two desiderata for jax.numpy dtype promotion behavior:\r\n1. follow what NumPy does (or a cleaned-up version of it)\r\n2. be invariant to `@jit`\r\n\r\nThe latter is much more important, so whenever the two are in tension we prefer the latter.\r\n\r\nIssue #732 showed our code had a special behavior that essentially handled a case of the former desideratum but also broke the latter. #732 also showed us (again) that our tests really should cover Python scalars.\r\n\r\nIn summary, in this commit:\r\n* revise jax.numpy dtype promotion behavior to be invariant to `@jit`, but not to follow NumPy behavior with Python scalars involved\r\n* add Python scalar types to lax_numpy tests\r\n* simplify and update kron implementation to fix dtype issues\r\n* fix #732","closed_at":"2019-05-20T14:08:43Z","comments":1,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/733/comments","created_at":"2019-05-20T01:50:23Z","draft":false,"events_url":"https://api.github.com/repos/jax-ml/jax/issues/733/events","html_url":"https://github.com/jax-ml/jax/pull/733","id":445892564,"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"bfd4f2","default":false,"description":"","id":1151516864,"name":"cla: yes","node_id":"MDU6TGFiZWwxMTUxNTE2ODY0","url":"https://api.github.com/repos/jax-ml/jax/labels/cla:%20yes"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/733/labels{/name}","locked":false,"milestone":null,"node_id":"MDExOlB1bGxSZXF1ZXN0MjgwMjE3MjE3","number":733,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/jax-ml/jax/pull/733.diff","html_url":"https://github.com/jax-ml/jax/pull/733","merged_at":"2019-05-20T14:08:43Z","patch_url":"https://github.com/jax-ml/jax/pull/733.patch","url":"https://api.github.com/repos/jax-ml/jax/pulls/733"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":1,"laugh":0,"rocket":0,"total_count":1,"url":"https://api.github.com/repos/jax-ml/jax/issues/733/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/jax-ml/jax/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/jax-ml/jax/assignees{/user}","blobs_url":"https://api.github.com/repos/jax-ml/jax/git/blobs{/sha}","branches_url":"https://api.github