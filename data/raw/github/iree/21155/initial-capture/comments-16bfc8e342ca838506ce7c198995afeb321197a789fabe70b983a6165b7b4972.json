om/u/9043212?v=4","gravatar_id":"","url":"https://api.github.com/users/AWoloszyn","html_url":"https://github.com/AWoloszyn","followers_url":"https://api.github.com/users/AWoloszyn/followers","following_url":"https://api.github.com/users/AWoloszyn/following{/other_user}","gists_url":"https://api.github.com/users/AWoloszyn/gists{/gist_id}","starred_url":"https://api.github.com/users/AWoloszyn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AWoloszyn/subscriptions","organizations_url":"https://api.github.com/users/AWoloszyn/orgs","repos_url":"https://api.github.com/users/AWoloszyn/repos","events_url":"https://api.github.com/users/AWoloszyn/events{/privacy}","received_events_url":"https://api.github.com/users/AWoloszyn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T17:26:44Z","updated_at":"2025-06-24T17:26:44Z","body":"`gridDimY` must be at MOST `std::numeric_limits<uint16_t>::max() == `65535` ` It is failing to launch the kernel as it has a gridDimY of `75600` ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001296646/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001305806","html_url":"https://github.com/iree-org/iree/issues/21155#issuecomment-3001305806","issue_url":"https://api.github.com/repos/iree-org/iree/issues/21155","id":3001305806,"node_id":"IC_kwDODGgK6M6y5ErO","user":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T17:29:45Z","updated_at":"2025-06-24T17:29:45Z","body":"yep! rocminfo will show you for your particular device, but nowadays the norm is:\n```\n      Grid Max Size:           4294967295(0xffffffff)             \n      Grid Max Size per Dimension:\n        x                        2147483647(0x7fffffff)             \n        y                        65535(0xffff)                      \n        z                        65535(0xffff)      \n```\n\nThe compiler needs to ensure it doesn't produce big Y/Z dims.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001305806/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001347735","html_url":"https://github.com/iree-org/iree/issues/21155#issuecomment-3001347735","issue_url":"https://api.github.com/repos/iree-org/iree/issues/21155","id":3001347735,"node_id":"IC_kwDODGgK6M6y5O6X","user":{"login":"AWoloszyn","id":9043212,"node_id":"MDQ6VXNlcjkwNDMyMTI=","avatar_url":"https://avatars.githubusercontent.com/u/9043212?v=4","gravatar_id":"","url":"https://api.github.com/users/AWoloszyn","html_url":"https://github.com/AWoloszyn","followers_url":"https://api.github.com/users/AWoloszyn/followers","following_url":"https://api.github.com/users/AWoloszyn/following{/other_user}","gists_url":"https://api.github.com/users/AWoloszyn/gists{/gist_id}","starred_url":"https://api.github.com/users/AWoloszyn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AWoloszyn/subscriptions","organizations_url":"https://api.github.com/users/AWoloszyn/orgs","repos_url":"https://api.github.com/users/AWoloszyn/repos","events_url":"https://api.github.com/users/AWoloszyn/events{/privacy}","received_events_url":"https://api.github.com/users/AWoloszyn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T17:43:01Z","updated_at":"2025-06-24T17:43:01Z","body":"@benvanik Is there somewhere we could validate this at compile-time for AMD backends? It has come up a couple times.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001347735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001369250","html_url":"https://github.com/iree-org/iree/issues/21155#issuecomment-3001369250","issue_url":"https://api.github.com/repos/iree-org/iree/issues/21155","id":3001369250,"node_id":"IC_kwDODGgK6M6y5UKi","user":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T17:47:08Z","updated_at":"2025-06-24T17:48:07Z","body":"It's not possible reliably in the compiler (if there are dynamic shapes there's nothing we can do, if the values are derived from runtime queries, etc). The HIP HAL could check and return an error during the HIP command buffer dispatch record - that won't work for indirect dispatches but may be good enough for most uses today. The best \"solution\" is to change codegen to bias towards putting more work in X (failures will still happen, but there are clearly cases today where X is getting fewer work items than YZ). Int range analysis could help codegen decide when to do that (as often we roughly know dimensions. I suppose we could add checks if it's possible for dynamic values to result in larger sizes, but probably only in < O2 or something.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001369250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001732575","html_url":"https://github.com/iree-org/iree/issues/21155#issuecomment-3001732575","issue_url":"https://api.github.com/repos/iree-org/iree/issues/21155","id":3001732575,"node_id":"IC_kwDODGgK6M6y6s3f","user":{"login":"monorimet","id":87458719,"node_id":"MDQ6VXNlcjg3NDU4NzE5","avatar_url":"https://avatars.githubusercontent.com/u/87458719?v=4","gravatar_id":"","url":"https://api.github.com/users/monorimet","html_url":"https://github.com/monorimet","followers_url":"https://api.github.com/users/monorimet/followers","following_url":"https://api.github.com/users/monorimet/following{/other_user}","gists_url":"https://api.github.com/users/monorimet/gists{/gist_id}","starred_url":"https://api.github.com/users/monorimet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/monorimet/subscriptions","organizations_url":"https://api.github.com/users/monorimet/orgs","repos_url":"https://api.github.com/users/monorimet/repos","events_url":"https://api.github.com/users/monorimet/events{/privacy}","received_events_url":"https://api.github.com/users/monorimet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T20:11:42Z","updated_at":"2025-06-24T20:11:42Z","body":"Thank you @AWoloszyn, reducing the sequence length (in this model that means restricting height and width of output) to below 65535 does circumvent the error, though it is obviously not a solution and only corroborates the identification of root cause.\n\n","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3001732575/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]