AAATVzQV-","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/20766852478"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/38662446?v=4","events_url":"https://api.github.com/users/johannahaffner/events{/privacy}","followers_url":"https://api.github.com/users/johannahaffner/followers","following_url":"https://api.github.com/users/johannahaffner/following{/other_user}","gists_url":"https://api.github.com/users/johannahaffner/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/johannahaffner","id":38662446,"login":"johannahaffner","node_id":"MDQ6VXNlcjM4NjYyNDQ2","organizations_url":"https://api.github.com/users/johannahaffner/orgs","received_events_url":"https://api.github.com/users/johannahaffner/received_events","repos_url":"https://api.github.com/users/johannahaffner/repos","site_admin":false,"starred_url":"https://api.github.com/users/johannahaffner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johannahaffner/subscriptions","type":"User","url":"https://api.github.com/users/johannahaffner","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2025-11-06T17:58:43Z","event":"renamed","id":20767119223,"node_id":"RTE_lADOCTkjjc7WY-DNzwAAAATV0Rd3","performed_via_github_app":null,"rename":{"from":"Scan silently broadcasts arrays","to":"Scan suppresses runtime error handled with pure callback"},"url":"https://api.github.com/repos/jax-ml/jax/issues/events/20767119223"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"},"author_association":"COLLABORATOR","body":"Hi, thanks for the question!\n\nUp front, we should recognize that raising an error is a side-effect, and the explicit API contract of `pure_callback` is that the function passed to it should have pure semantics (i.e. no side-effects). Since your example violates this API contract, the expected behavior here is undefined, and we could probably close this issue as \"working as intended\".\n\nThat said, I understand that equinox uses (mis-uses?) `pure_callback` in order to raise value-dependent errors at runtime. This is not something we on the JAX team would recommend (and in fact we've explicitly said this in past discussions with the Equinox team about `error_if`).\n\nI believe what's happening here is that the compiler notices that the callback function always returns None, and since the API contract means the compiler can assume the callback is pure, then there's no reason to actually execute the callback since we know its return value before executing it (note that `scan` will implicitly JIT-compile the `step` function). You can see this by printing the uncompiled HLO and the compiled HLO, and recognizing that the `callback` has been elided in the first example:\n```python\nprint(\"callback\" in jax.jit(f).lower(arr).as_text())  # True\nprint(\"callback\" in jax.jit(f).lower(arr).compile().as_text())  # False\n\nprint(\"callback\" in jax.jit(f).lower(arr2).as_text())  # True\nprint(\"callback\" in jax.jit(f).lower(arr2).compile().as_text())  # True\n```\nThis is a valid optimization for the compiler to make, because the user has specified that the callback function is pure.\n\nI don't have any fix to suggest, beyond the one I've recommended in the past, i.e. that equinox should stop misusing `pure_callback` in this way. You might be able to find a workaround by injecting some data dependence into the callback so that the compiler won't elide it (e.g. something like returning `0` and adding it to the value you're checking), but fundamentally this will continue to be a brittle and unsupported use of JAX APIs.","created_at":"2025-11-06T19:11:41Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/33147#issuecomment-3498997066","id":3498997066,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/33147","minimized":null,"node_id":"IC_kwDOCTkjjc7QjnVK","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":2,"hooray":0,"laugh":0,"rocket":0,"total_count":2,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3498997066/reactions"},"updated_at":"2025-11-06T19:23:08Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3498997066","user":{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":