CTkjjc6gpEgF","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2695120901/reactions"},"updated_at":"2025-03-03T17:43:37Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2695120901","user":{"avatar_url":"https://avatars.githubusercontent.com/u/158801697?v=4","events_url":"https://api.github.com/users/shubhamdagar9854/events{/privacy}","followers_url":"https://api.github.com/users/shubhamdagar9854/followers","following_url":"https://api.github.com/users/shubhamdagar9854/following{/other_user}","gists_url":"https://api.github.com/users/shubhamdagar9854/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/shubhamdagar9854","id":158801697,"login":"shubhamdagar9854","node_id":"U_kgDOCXcfIQ","organizations_url":"https://api.github.com/users/shubhamdagar9854/orgs","received_events_url":"https://api.github.com/users/shubhamdagar9854/received_events","repos_url":"https://api.github.com/users/shubhamdagar9854/repos","site_admin":false,"starred_url":"https://api.github.com/users/shubhamdagar9854/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shubhamdagar9854/subscriptions","type":"User","url":"https://api.github.com/users/shubhamdagar9854","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"COLLABORATOR","body":"### Description\n\nFor token inputs, the np dtype plumbed through from JAX is `bool` (which [converts](https://github.com/openxla/xla/blob/f72c7b80c68d41d05a27b34700fb2c4870810f8b/xla/python/py_array.cc#L213) to IFRT dtype `PRED`), whereas the buffer IFRT dtype is (correctly) `TOKEN`. For arrays with no buffers, there is currently no way to indicate token-ness and differentiate it from bool. For now we [use the buffer dtype](https://github.com/openxla/xla/blob/f72c7b80c68d41d05a27b34700fb2c4870810f8b/xla/python/py_array.cc#L228) if there are buffers, and the converted np dtype if there are no buffers, so tokens are broken in the case of no buffers. Possible solutions are to choose an np dtype other than `bool` to uniquely represent tokens, or plumb through an `is_token` bool from JAX.\n\n\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n.","closed_at":null,"closed_by":null,"comments":3,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/26815/comments","created_at":"2025-02-27T18:31:46Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/26815/events","html_url":"https://github.com/jax-ml/jax/issues/26815","id":2885289035,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/26815/labels{/name}","locked":false,"milestone":null,"node_id":"I_kwDOCTkjjc6r-gRL","number":26815,"parent_issue_url":"https://api.github.com/repos/jax-ml/jax/issues/26645","performed_via_github_app":null,"pinned_comment":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/26815/reactions"},"repository_url":"https://api.github.com/repos/jax-ml/jax","state":"open","state_reason":null,"sub_issues_summary":{"completed":0,"percent_completed":0,"total":0},"timeline_url":"https://api.github.com/repos/jax-ml/jax/issues/26815/timeline","title":"Fix tokens for arrays with no local shards","type":null,"updated_at":"2025-03-03T17:43:38Z","url":"https://api.github.com/repos/jax-ml/jax/issues/26815","user":{"avatar_url":"https://avatars.githubusercontent.com/u/265931