//api.github.com/users/jakevdp","user_view_type":"public"},"author_association":"COLLABORATOR","body":"Thanks for the report! I think the issue is that pickle always places the loaded array on the default device. You'll have to re-replicate your array in the third case if you want it to be identical to the first two cases.\r\n\r\nSee https://jax.readthedocs.io/en/latest/jax.numpy.html#copying-and-serialization for details.","created_at":"2023-11-21T20:52:46Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/18617#issuecomment-1821661681","id":1821661681,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/18617","minimized":null,"node_id":"IC_kwDOCTkjjc5slFnx","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1821661681/reactions"},"updated_at":"2023-11-21T20:52:46Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1821661681","user":{"avatar_url":"https://avatars.githubusercontent.com/u/781659?v=4","events_url":"https://api.github.com/users/jakevdp/events{/privacy}","followers_url":"https://api.github.com/users/jakevdp/followers","following_url":"https://api.github.com/users/jakevdp/following{/other_user}","gists_url":"https://api.github.com/users/jakevdp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/jakevdp","id":781659,"login":"jakevdp","node_id":"MDQ6VXNlcjc4MTY1OQ==","organizations_url":"https://api.github.com/users/jakevdp/orgs","received_events_url":"https://api.github.com/users/jakevdp/received_events","repos_url":"https://api.github.com/users/jakevdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"}},{"actor":{"avatar_url":"https:/