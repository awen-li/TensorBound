ing.deepmind.python import app\r\n# Ensure that Haiku is using dict instead of custom structures.\r\nos.environ['HAIKU_FLATMAPPING'] = '0'\r\n\r\ndef _resnet(x, is_training):\r\n  net = hk.nets.ResNet18(2)\r\n  return net(x, is_training)\r\n\r\ndef _loss_fn(inference_fn, params, states, rng, x, y):\r\n  prediction = inference_fn(params, states, rng, x)[0]\r\n  return jnp.mean((prediction - y)**2)\r\n\r\ndef main(argv):\r\n  del argv\r\n  batch_size = 5\r\n  resnet = hk.transform_with_state(_resnet)\r\n  inputs = np.random.random((batch_size, 64, 64, 3)).astype(np.float32)\r\n  rng = jax.random.PRNGKey(42)\r\n  params, states = resnet.init(rng, inputs, is_training=True)\r\n  _, _ = resnet.apply(params, states, rng, inputs, is_training=True)\r\n  # We need to save the model with is_training=False because of batch_norm\r\n  resnet_apply = functools.partial(resnet.apply, is_training=False)\r\n  # Save the Haiku.apply callable as a tf.SavedModel (and the params and states)\r\n  save_dir = '/tmp/resnet'\r\n  # Jax -> TF\r\n  tf_fn = jax2tf.convert(\r\n      resnet_apply,\r\n      polymorphic_shapes=[None, None, None, '(b, ...)'],\r\n      with_gradient=True)\r\n  # TF -> SavedModel\r\n  model = tf.Module()\r\n  model.fn = tf.function(tf_fn, autograph=False)\r\n  model.fn.get_concrete_function(\r\n      tree.map_structure(tf.zeros_like, params),\r\n      tree.map_structure(tf.zeros_like, states),\r\n      tree.map_structure(tf.zeros_like, rng),\r\n      tf.TensorSpec((None,) + inputs.shape[1:], inputs.dtype))\r\n  options = tf.saved_model.SaveOptions(experimental_custom_gradients=True)\r\n  _ = tf.saved_model.save(model, save_dir, options=options)\r\n  restored_module = tf.saved_model.load(save_dir)\r\n  restored_fn = jax2tf.call_tf(restored_module.fn)\r\n  # Let us try to use the function as part of a bigger model and compute the\r\n  # gradient.\r\n  o_loss_fn = functools.partial(\r\n      _loss_fn,\r\n      functools.partial(resnet.apply, is_training=False))\r\n  r_loss_fn = functools.partial(_loss_fn, restored_fn)\r\n  targets = np.random.randint(2, size=batch_size).reshape([batch_size, 1])\r\n  print('Computing loss for the original model...')\r\n  o_loss = o_loss_fn(params, states, rng, inputs, targets)\r\n  print('Computing gradient for the original model...')\r\n  o_grad = jax.grad(o_loss_fn)(params, states, rng, inputs, targets)\r\n  # This works now!!!\r\n  print('Computing loss for the restored model...')\r\n  r_loss = r_loss_fn(params, states, rng, inputs, targets)\r\n  # Fails when computing the gradient using the reloaded function\r\n  print('Computing gradient for the restored model...')\r\n  r_grad = jax.grad(r_loss_fn)(params, states, rng, inputs, targets)\r\n\r\nif __name__ == '__main__':\r\n  app.run(main)\r\n```\r\n\r\nThe error is\r\n```\r\nTypeError: internal_grad_fn(AddV2_48:0, jax2tf_arg_62:0, jax2tf_arg_63:0, jax2tf_arg_64:0,...): expected argument #2(zero-based) to be a Tensor; got NoneType (None)\r\n```","closed_at":"2021-07-25T07:20:40Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"},"comments":1,"comments_url":"https://api.github.com/rep