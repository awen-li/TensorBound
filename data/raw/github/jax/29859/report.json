s)\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/core.py:582, in Primitive._true_bind(self, *args, **params)\n    580 trace_ctx.set_trace(eval_trace)\n    581 try:\n--> 582   return self.bind_with_trace(prev_trace, args, params)\n    583 finally:\n    584   trace_ctx.set_trace(prev_trace)\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/core.py:592, in Primitive.bind_with_trace(self, trace, args, params)\n    589   with set_current_trace(trace):\n    590     return self.to_lojax(*args, **params)  # type: ignore\n--> 592 return trace.process_primitive(self, args, params)\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/core.py:1100, in EvalTrace.process_primitive(self, primitive, args, params)\n   1098 args = map(full_lower, args)\n   1099 check_eval_args(args)\n-> 1100 return primitive.impl(*args, **params)\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/dispatch.py:91, in apply_primitive(prim, *args, **params)\n     89 prev = lib.jax_jit.swap_thread_local_state_disable_jit(False)\n     90 try:\n---> 91   outs = fun(*args)\n     92 finally:\n     93   lib.jax_jit.swap_thread_local_state_disable_jit(prev)\n\n    [... skipping hidden 28 frame]\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/lax/lax.py:7083, in _split_on_one_axis(op_shape, new_sizes, name)\n   7081   i += 1\n   7082   j += 1\n-> 7083 assert len(op_shape) == len(out)\n   7084 return True, out\n\nAssertionError: \n``\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n```\njax:    0.7.0.dev20250630+0e76f73ab\njaxlib: 0.6.2\nnumpy:  2.2.6\npython: 3.13.3 (main, May 22 2025, 01:38:47) [Clang 20.1.4 ]\ndevice info: cpu-4, 4 local devices\"\nprocess_count: 1\nplatform: uname_result(system='Darwin', node='mbp-10841385', release='24.5.0', version='Darwin Kernel Version 24.5.0: Tue Apr 22 19:54:49 PDT 2025; root: