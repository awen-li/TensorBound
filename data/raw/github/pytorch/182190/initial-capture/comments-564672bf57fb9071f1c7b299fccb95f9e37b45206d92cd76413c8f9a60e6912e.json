cjk1NDc1NjI=","avatar_url":"https://avatars.githubusercontent.com/u/9547562?v=4","gravatar_id":"","url":"https://api.github.com/users/xmfan","html_url":"https://github.com/xmfan","followers_url":"https://api.github.com/users/xmfan/followers","following_url":"https://api.github.com/users/xmfan/following{/other_user}","gists_url":"https://api.github.com/users/xmfan/gists{/gist_id}","starred_url":"https://api.github.com/users/xmfan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xmfan/subscriptions","organizations_url":"https://api.github.com/users/xmfan/orgs","repos_url":"https://api.github.com/users/xmfan/repos","events_url":"https://api.github.com/users/xmfan/events{/privacy}","received_events_url":"https://api.github.com/users/xmfan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-01T22:31:38Z","updated_at":"2026-05-01T22:31:38Z","body":"Note: the example given happens in token dispatch, we can't really bandaid this via graph break","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/4361945134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/4492833500","html_url":"https://github.com/pytorch/pytorch/issues/182190#issuecomment-4492833500","issue_url":"https://api.github.com/repos/pytorch/pytorch/issues/182190","id":4492833500,"node_id":"IC_kwDOA-j9z88AAAABC8sy3A","user":{"login":"shino16","id":40788005,"node_id":"MDQ6VXNlcjQwNzg4MDA1","avatar_url":"https://avatars.githubusercontent.com/u/40788005?v=4","gravatar_id":"","url":"https://api.github.com/users/shino16","html_url":"https://github.com/shino16","followers_url":"https://api.github.com/users/shino16/followers","following_url":"https://api.github.com/users/shino16/following{/other_user}","gists_url":"https://api.github.com/users/shino16/gists{/gist_id}","starred_url":"https://api.github.com/users/shino16/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shino16/subscriptions","organizations_url":"https://api.github.com/users/shino16/orgs","repos_url":"https://api.github.com/users/shino16/repos","events_url":"https://api.github.com/users/shino16/events{/privacy}","received_events_url":"https://api.github.com/users/shino16/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-19T23:04:40Z","updated_at":"2026-05-19T23:04:40Z","body":"Still reproduced on main. The root cause is in Inductor codegen: `DeviceCopy` (ir.py) tracks `non_blocking=True` in `constant_args[0]`, but `DynamicScalar` (which generates `.item()` calls) has no synchronization logic. `DynamicScalar.get_reads()` returns empty `OrderedSet`, so the scheduler sees no explicit read dependency on the destination buffer.\n\nMinimal fix: in `_codegen_dynamic_scalar` (wrapper.py), before emitting `.item()`, check if the input buffer was produced by a non-blocking `DeviceCopy` and emit `torch.cuda.synchronize()`. Since `.item()` blocks on the CPU thread anyway, the overhead should be negligible.\n\nI'm happy to put up a PR for this if it's not in progress.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/4492833500/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/4532930818","html_url":"https://github.com/pytorch/pytorch/issues/182190#issuecomment-4532930818","issue_url":"https://api.github.com/repos/pytorch/pytorch/issues/182190","id":4532930818,"node_id":"IC_kwDOA-j9z88AAAABDi8JAg","user":{"login":"mlazos","id":4105940,"node_id":"MDQ6VXNlcjQxMDU5NDA=","avatar_url":"https://avatars.githubusercontent.com/u/4105940?v=4","gravatar_id":"","url":"https://api.github.com/users/mlazos","html_url":"https://github.com/mlazos","followers_url":"https://api.github.com/users/mlazos/followers","following_url":"https://api.github.com/users/mlazos/following{/other_user}","gists_url":"https://api.github.com/users/mlazos/gists{/gist_id}","starred_url":"https://api.github.com/users/mlazos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mlazos/subscriptions","organizations_url":"https://api.github.com/users/mlazos/orgs","repos_url":"https://api.github.com/users/mlazos/repos","events_url":"https://api.github.com/users/mlazos/events{/privacy}","received_events_url":"https://api.github.com/users/mlazos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-25T08:49:20Z","updated_at":"2026-05-25T08:49:20Z","body":"I'm looking into this, we will likely place an event to not block everything with a full syncrhonize.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/4532930818/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]