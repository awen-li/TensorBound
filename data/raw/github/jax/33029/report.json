s://api.github.com/users/copybara-service%5Bbot%5D","user_view_type":"public"},"created_at":"2025-11-03T18:00:24Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}],"author_association":"NONE","body":"Consider this example:\n\n```\n@jtu.with_explicit_mesh((2,), 'x')\ndef test_auto_axes_inside_scan(self, mesh):\n  def f(params, x):\n    @jax.sharding.auto_axes(out_sharding=jax.P())\n    def model(x):\n      return params * x\n\n    def body(c, _):\n      return model(c), ()\n\n    y = jax.lax.scan(body, x, None, length=3)[0]\n    return y\n\n  jax.jit(jax.grad(f))(1., 2.)  # doesn't crash\n```\n\nThis leads to a jaxpr where scan has 2 outputs:\n  * primal output on Explicit mesh\n  * Residual on Auto mesh (because of the auto_axes)\n\nDuring lowering of scan i.e. in `_scan_impl`, the primitive (scan_p) is running under Explicit mesh (since only the `model` inside the body of scan is under auto mode) but the residual has an Auto mesh. This leads to problem when creating empty array, DS and DUS because the context mesh disagrees with the aval mesh.\n\nHence this change runs those particular operations (creating empty array, DS and DUS) under the context of the mesh of the input aval instead of the context mesh.\n\nFixes https://github.com/jax-ml/jax/issues/33029\n","closed_at":"2025-11-03T21:51:47Z","comments":0,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/33066/comments","created_at":"2025-11-03T18:00:23Z","draft":false,"events_url":"https://api.github.com/repos/jax-ml/jax/issues/33066/events","html_url":"https://github.com/jax-ml/jax/pull/33066","id":3583146063,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/33066/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOCTkjjc6xPn3V","number":33066,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/jax-ml/jax/pull/33066.diff","html_url":"https://github.com/jax-ml/jax/pull/33066","merged_at":"2025-11-03T21:51:47Z","patch_url":"https://github.com/jax-ml/jax/pull/33066.patch","u