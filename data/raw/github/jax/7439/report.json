":"public"},"commit_id":null,"commit_url":null,"created_at":"2021-08-11T14:55:39Z","event":"assigned","id":5142824355,"intent":null,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQ1MTQyODI0MzU1","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/5142824355"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"},"author_association":"COLLABORATOR","body":"The issue comes from the fact that with ` jaxlib 0.1.68` the host_callback module on CPU uses a different implementation mechanism than on GPU and TPU: instead of outfeed it uses by default an XLA CustomCall. This will eventually be rolled out to GPU also, but not TPU. (You can force the use of outfeed even on CPU with `JAX_HOST_CALLBACK_OUTFEED=True`)\r\n\r\nThe proper solution is to get the XLA CustomCall to throw a proper Python exception, not crash. This should be possible. ","created_at":"2021-08-13T08:24:14Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/7439#issuecomment-898280416","id":898280416,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/7439","minimized":null,"node_id":"IC_kwDOCTkjj