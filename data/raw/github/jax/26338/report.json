_src.core import mutable_array\n\n@jax.jit\ndef f(a):\n    jax.debug.visualize_array_sharding(a)\n\n    a_ref = mutable_array(a)\n    jax.debug.visualize_array_sharding(a_ref[...])\n\ndevices = mesh_utils.create_device_mesh((2, 2))\nmesh = Mesh(devices, axis_names=('i', 'j'))\nsharding = NamedSharding(mesh, P('i', 'j'))\n\na = jnp.zeros_like(mesh.device_ids, dtype=jnp.int32)\na = jax.make_array_from_callback(a.shape, sharding, lambda idx: a[idx])\n\nf(a)\n```\n\nOutput:\n\n```\n┌──────────┬──────────┐\n│          │          │\n│  CPU 0   │  CPU 1   │\n│          │          │\n│          │          │\n├──────────┼──────────┤\n│          │          │\n│  CPU 2   │  CPU 3   │\n│          │          │\n│          │          │\n└──────────┴──────────┘\n┌──────────┬──────────┐\n│          │          │\n│  CPU 0   │  CPU 1   │\n│          │          │\n│          │          │\n├──────────┼──────────┤\n│          │          │\n│  CPU 2   │  CPU 3   │\n│          │          │\n│          │          │\n└──────────┴──────────┘\n```","created_at":"2025-02-06T13:19:40Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/26338#issuecomment-2639810381","id":2639810381,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/26338","minimized":null,"node_id":"IC_kwDOCTkjjc6dWE9N","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2639810381/reactions"},"updated_at":"2025-02-06T13:19:40Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2639810381","user":{"avatar_url":"https://avatars.githubusercontent.com/u/68557794?v=4","events_url":"https://api.github.com/users/ayaka14732/events{/privacy}","followers_url":"https://api.github.com/users/ayaka14732/followers","following_url":"https://api.github.com/users/ayaka14732/following{/other_user}","gists_url":"https://api.github.com/users/ayaka147