/events{/privacy}","followers_url":"https://api.github.com/users/kulinseth/followers","following_url":"https://api.github.com/users/kulinseth/following{/other_user}","gists_url":"https://api.github.com/users/kulinseth/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/kulinseth","id":453004,"login":"kulinseth","node_id":"MDQ6VXNlcjQ1MzAwNA==","organizations_url":"https://api.github.com/users/kulinseth/orgs","received_events_url":"https://api.github.com/users/kulinseth/received_events","repos_url":"https://api.github.com/users/kulinseth/repos","site_admin":false,"starred_url":"https://api.github.com/users/kulinseth/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kulinseth/subscriptions","type":"User","url":"https://api.github.com/users/kulinseth","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/453004?v=4","events_url":"https://api.github.com/users/kulinseth/events{/privacy}","followers_url":"https://api.github.com/users/kulinseth/followers","following_url":"https://api.github.com/users/kulinseth/following{/other_user}","gists_url":"https://api.github.com/users/kulinseth/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/kulinseth","id":453004,"login":"kulinseth","node_id":"MDQ6VXNlcjQ1MzAwNA==","organizations_url":"https://api.github.com/users/kulinseth/orgs","received_events_url":"https://api.github.com/users/kulinseth/received_events","repos_url":"https://api.github.com/users/kulinseth/repos","site_admin":false,"starred_url":"https://api.github.com/users/kulinseth/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kulinseth/subscriptions","type":"User","url":"https://api.github.com/users/kulinseth","user_view_type":"public"},{"avatar_url":"https://avatars.githubusercontent.com/u/122648248?v=4","events_url":"https://api.github.com/users/shuhand0/events{/privacy}","followers_url":"https://api.github.com/users/shuhand0/followers","following_url":"https://api.github.com/users/shuhand0/following{/other_user}","gists_url":"https://api.github.com/users/shuhand0/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/shuhand0","id":122648248,"login":"shuhand0","node_id":"U_kgDOB092uA","organizations_url":"https://api.github.com/users/shuhand0/orgs","received_events_url":"https://api.github.com/users/shuhand0/received_events","repos_url":"https://api.github.com/users/shuhand0/repos","site_admin":false,"starred_url":"https://api.github.com/users/shuhand0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shuhand0/subscriptions","type":"User","url":"https://api.github.com/users/shuhand0","user_view_type":"public"}],"author_association":"NONE","body":"### Description\r\n\r\nI have noticed that jnp.take_along_axis() doesn't seem to index correctly when using the Metal backend. \r\n\r\nThe following code works with both the Metal backend and standard CPU:\r\n\r\n```\r\nimport jax.numpy as jnp\r\nimport jax.random as random\r\n\r\n# jax.config.update('jax_platform_name', 'cpu')\r\njax.config.update(\"jax_debug_nans\", True)\r\n\r\nkey = random.PRNGKey(123)\r\narray = random.uniform(key, shape=(3, 4))\r\n\r\nidx = jnp.array([[0, 1, 2],[0, 1, 2],[0, 1, 2]])\r\n# idx = jnp.array([[0],[0],[0]])\r\n\r\njnp.take_along_axis(array, idx, axis=1)\r\n```\r\n\r\nIf you change index to the commented line, it still runs fine on M1 CPU, but the Metal backend gives the following error:\r\n\r\n```\r\nTraceback (most recent call last):\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/IPython/core/interactiveshell.py\", line 3508, in run_code\r\n    exec(code_obj, self.user_global_ns, self.user_ns)\r\n  File \"<ipython-input-10-bb9fdf754383>\", line 1, in <module>\r\n    jnp.take_along_axis(temp, jnp.array([[0],[1],[2]]), axis=1)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/numpy/lax_numpy.py\", line 3999, in take_along_axis\r\n    return lax.gather(arr, gather_indices_arr, dnums, tuple(slice_sizes),\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/lax/slicing.py\", line 287, in gather\r\n    return gather_p.bind(\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/core.py\", line 380, in bind\r\n    return self.bind_with_trace(find_top_trace(args), args, params)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/core.py\", line 383, in bind_with_trace\r\n    out = trace.process_primitive(self, map(trace.full_raise, args), params)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/core.py\", line 790, in process_primitive\r\n    return primitive.impl(*tracers, **params)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/dispatch.py\", line 144, in apply_primitive\r\n    return compiled_fun(*args)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/dispatch.py\", line 227, in <lambda>\r\n    return lambda *args, **kw: compiled(*args, **kw)[0]\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/profiler.py\", line 314, in wrapper\r\n    return func(*args, **kwargs)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/interpreters/pxla.py\", line 1353, in __call__\r\n    dispatch.check_special(self.name, arrays)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/dispatch.py\", line 437, in check_special\r\n    _check_special(name, buf.dtype, buf)\r\n  File \"/opt/homebrew/Caskroom/miniforge/base/envs/IQL/lib/python3.10/site-packages/jax/_src/dispatch.py\", line 442, in _check_special\r\n    raise FloatingPointError(f\"invalid value (nan) encountered in {name}\")\r\nFloatingPointError: invalid value (nan) encountered in jit(gather)\r\n```\r\n\r\nI think I have isolated the problem to line 3999 in jax/_src/numpy/lax_numpy.py: \r\n\r\n`lax.gather(arr, gather_indices_arr, dnums, tuple(slice_sizes),\r\n                    mode=\"fill\" if mode is None else mode)`\r\n\r\nWhich leads to line 287 in jax/_src/lax/slicing.py:\r\n\r\n`gather_p.bind(\r\n      operand, start_indices, dimension_numbers=dimension_numbers,\r\n      slice_sizes=core.canonicalize_shape(slice_sizes),\r\n      unique_indices=bool(unique_indices),\r\n      indices_are_sorted=bool(indices_are_sorted),\r\n      mode=parsed_mode,\r\n      fill_value=fill_value)`\r\n\r\nWhich leads to line 1351 in jax/_src/interpreters/pxla.py:\r\n\r\n`out_arrays = results.disassemble_into_single_device_arrays()`\r\n\r\nwhere `nan` values start to appear. However, presumably the issue itself occurs a couple of lines before this, at `results = self.xla_executable.execute_sharded(input_bufs)`. I think this may be the same issue with sharding as mentioned in issue  #16287. Any advice on how to address this would be super helpful.\r\n\r\n### What jax/jaxlib version are you using?\r\n\r\njax v0.4.11, jaxlib v0.4.10, jax-metal v0.0.3\r\n\r\n### Which accelerator(s) are you using?\r\n\r\nM1 GPU\r\n\r\n### Additional system info\r\n\r\nPython 3.10.12, Mac OS 13.3, M1 Pro 10-core / 16GB\r\n\r\n### NVIDIA GPU info\r\n\r\n_No response_","closed_at":"2024-01-02T18:42:15Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/122648248?v=4","events_url":"https://api.github.com/users/shuhand0/events{/privacy}","followers_url":"https://api.github.com/users/shuhand0/followers","following_url":"https://api.github.com/users/shuhand0/following{/other_user}","gists_url":"https://api.github.com/users/shuhand0/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/shuhand0","id":122648248,"login":"shuhand0","node_id":"U_kgDOB092uA","organizations_url":"https://api.github.com/users/shuhand0/orgs"