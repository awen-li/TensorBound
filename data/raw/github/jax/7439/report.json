m/users/gnecula","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/7541458?v=4","events_url":"https://api.github.com/users/Edenhofer/events{/privacy}","followers_url":"https://api.github.com/users/Edenhofer/followers","following_url":"https://api.github.com/users/Edenhofer/following{/other_user}","gists_url":"https://api.github.com/users/Edenhofer/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Edenhofer","id":7541458,"login":"Edenhofer","node_id":"MDQ6VXNlcjc1NDE0NTg=","organizations_url":"https://api.github.com/users/Edenhofer/orgs","received_events_url":"https://api.github.com/users/Edenhofer/received_events","repos_url":"https://api.github.com/users/Edenhofer/repos","site_admin":false,"starred_url":"https://api.github.com/users/Edenhofer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Edenhofer/subscriptions","type":"User","url":"https://api.github.com/users/Edenhofer","user_view_type":"public"},"author_association":"CONTRIBUTOR","body":"On jaxlib==0.1.73 I again get a `RuntimeError`. Did JAX by chance switch the host callback method because I don't think the CustomCall implementation in XLA was changed for the CPU (https://github.com/tensorflow/tensorflow/commits/master/tensorflow/compiler/xla/service/hlo.proto)?\r\n\r\nAnyways, this bug might potentially be outdated.","created_at":"2021-11-13T10:58:01Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/7439#issuecomment-968050058","id":968050058,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/7439","minimized":null,"node_id":"IC_kwDOCTkjjc45s0WK","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/968050058/reactions"},"updated_at":"2021-11-13T10:58:01Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/968050058","user":{"av