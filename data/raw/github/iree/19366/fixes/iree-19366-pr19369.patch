+  bytes f16s = 11;
+  bytes bf16s = 13;
+  bytes u16s = 16;
+  bytes s16s = 17;
+  bytes f8e5m2s = 19;
+  bytes f8e4m3s = 28;
+  bytes f8e4m3fns = 20;
+  bytes f8e4m3b11fnuzs = 23;
+  bytes f8e5m2fnuzs = 24;
+  bytes f8e4m3fnuzs = 25;
+  bytes f8e3m4s = 29;
+  repeated int64 sparse_indices = 14;
+  // Next = 30
+}
