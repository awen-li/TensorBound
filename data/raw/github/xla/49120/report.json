ents_url":"https://api.github.com/users/copybara-service%5Bbot%5D/received_events","repos_url":"https://api.github.com/users/copybara-service%5Bbot%5D/repos","site_admin":false,"starred_url":"https://api.github.com/users/copybara-service%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/copybara-service%5Bbot%5D/subscriptions","type":"Bot","url":"https://api.github.com/users/copybara-service%5Bbot%5D","user_view_type":"public"},"created_at":"2026-09-23T07:57:31Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/14309772?v=4","events_url":"https://api.github.com/users/akuegel/events{/privacy}","followers_url":"https://api.github.com/users/akuegel/followers","following_url":"https://api.github.com/users/akuegel/following{/other_user}","gists_url":"https://api.github.com/users/akuegel/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/akuegel","id":14309772,"login":"akuegel","node_id":"MDQ6VXNlcjE0MzA5Nzcy","organizations_url":"https://api.github.com/users/akuegel/orgs","received_events_url":"https://api.github.com/users/akuegel/received_events","repos_url":"https://api.github.com/users/akuegel/repos","site_admin":false,"starred_url":"https://api.github.com/users/akuegel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akuegel/subscriptions","type":"User","url":"https://api.github.com/users/akuegel","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14309772?v=4","events_url":"https://api.github.com/users/akuegel/events{/privacy}","followers_url":"https://api.github.com/users/akuegel/followers","following_url":"https://api.github.com/users/akuegel/following{/other_user}","gists_url":"https://api.github.com/users/akuegel/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/akuegel","id":14309772,"login":"akuegel","node_id":"MDQ6VXNlcjE0MzA5Nzcy","organizations_url":"https://api.github.com/users/akuegel/orgs","received_events_url":"https://api.github.com/users/akuegel/received_events","repos_url":"https://api.github.com/users/akuegel/repos","site_admin":false,"starred_url":"https://api.github.com/users/akuegel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akuegel/subscriptions","type":"User","url":"https://api.github.com/users/akuegel","user_view_type":"public"}],"author_association":"NONE","body":"[XLA:GPU] Clamp per-dimension offsets in dynamic-slice analysis\n\nHLO dynamic-slice and dynamic-update-slice clamp each dimension's start index\ni to [0, dim_size[i] - slice_size[i]]. Previously, AnalyzeDynamicSlice and\nVerifySliceOffset computed the 1D byte offset directly from unclamped start\nindices, relying only on runtime 1D buffer clamping to [0, buffer_size -\nslice_size]. When a slice is contiguous because all dimensions major to a\npartially-sliced dimension have slice_size == 1, an out-of-bounds offset on a\nminor dimension or size-1 dimension could stay within the total buffer bounds\nand write or read at the wrong element offset.\n\nClamp constant offset operands per-dimension in AnalyzeDynamicSlice and\nVerifySliceOffset, and for loop-dependent offsets verify that the runtime 1D\nbuffer clamping matches the per-dimension clamped HLO byte offset on every loop\niteration. Also preserve the sliced operand shape before walking through\nbitcasts in DynamicSliceFusion::ResolveParameter so Parameter.shape matches the\nslice rank and strides in ComputeSliceOffset.\n\nFixes #49120\n","closed_at":"2026-09-24T09:35:00Z","comments":0,"comments_url":"https://api.github.com/repos/openxla/xla/issues/49309/comments","created_at":"2026-09-23T07:57:29Z","draft":false,"events_url":"https://api.github.com/repos/openxla/xla/issues/49309/events","html_url":"https://github.com/openxla/xla/pull/49309","id":5550514282,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/openxla/xl