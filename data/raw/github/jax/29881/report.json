E3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}],"author_association":"CONTRIBUTOR","body":"### Description\n\nComposing jax.random.choice with `shard_map` and `vmap` leads to some errors, possibly because `pvary` annotations are missing inside of jax.random.choice.\n\n(As a side note, the code is convoluted because jax/numpy do not provide a batched version of jax random choice)\n\n```python\nfrom functools import partial\n\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.sharding import PartitionSpec as P, AxisType, reshard\nfrom jax.experimental.shard_map import shard_map\n\n# Set up devices and mesh\nif jax.config.jax_num_cpu_devices < 0:\n    jax.config.update(\"jax_num_cpu_devices\", 4)\nmesh = jax.make_mesh((4,), ('S'), axis_types=(AxisType.Explicit,))\njax.sharding.set_mesh(mesh)\n\nB, C = 8, 3\nkey = jax.random.key(0)\n\nkeys = jax.random.split(key, B)\nhoppable_clusters = jax.random.randint(key, (B, C), minval=0, maxval=2) == 1\n\n@jax.vmap\ndef _update_samples(key, hoppable_clusters):\n    return jax.random.choice(\n        key,\n        a=jnp.arange(C),\n        p=hoppable_clusters,\n        replace=True,\n    )\n\n# works\nres = _update_samples(keys, hoppable_clusters)\n\n\nkeys = reshard(keys, P('S'))\nhoppable_clusters = reshard(hoppable_clusters, P('S'))\n\nres2 = shard_map(\n    _update_samples, \n    in_specs=(P('S'), P('S', None)), \n    out_specs=(P('S'),), \n    mesh=mesh,\n)(keys, hoppable_clusters)\n```\n\nand the error is\n\n```python\n---------------------------------------------------------------------------\nTypeError                                 Traceback (most recent call last)\nCell In[1], line 40\n     37 keys = reshard(keys, P('S'))\n     38 hoppable_clusters = reshard(hoppable_clusters, P('S'))\n---> 40 res2 = shard_map(\n     41     _update_samples, \n     42     in_specs=(P('S'), P('S', None)), \n     43     out_specs=(P('S'),), \n     44     mesh=mesh,\n     45 )(keys, hoppable_clusters)\n\n    [... skipping hidden 19 frame]\n\nCell In[1], line 26, in _update_samples(key, hoppable_clusters)\n     22 @jax.vmap\n     23 def _update_samples(key, hoppable_clusters):\n---> 26     return jax.random.choice(\n     27         key,\n     28         a=jnp.arange(C),\n     29         p=hoppable_clusters,\n     30         replace=True,\n     31     )\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/random.py:717, in choice(key, a, shape, replace, p, axis, mode)\n    715   p_cuml = jnp.cumsum(p_arr)\n    716   r = p_cuml[-1] * (1 - uniform(key, shape, dtype=p_cuml.dtype))\n--> 717   ind = jnp.searchsorted(p_cuml, r).astype(int)\n    718 else:\n    719   # Gumbel top-k trick: https://timvieira.github.io/blog/post/2019/09/16/algorithms-for-sampling-without-replacement/\n    720   g = gumbel(key, (n_inputs,), dtype=p_arr.dtype, mode=mode) + jnp.log(p_arr)\n\n    [... skipping hidden 15 frame]\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/numpy/lax_numpy.py:9373, in searchsorted(a, v, side, sorter, method)\n   9366   return array_creation.zeros_like(v, dtype=dtype)\n   9367 impl = {\n   9368     'scan': partial(_searchsorted_via_scan, False),\n   9369     'scan_unrolled': partial(_searchsorted_via_scan, True),\n   9370     'sort': _searchsorted_via_sort,\n   9371     'compare_all': _searchsorted_via_compare_all,\n   9372 }[method]\n-> 9373 return impl(a, v, side, dtype)\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/numpy/vectorize.py:347, in vectorize.<locals>.wrapped(*args, **kwargs)\n    345   else:\n    346     vectorized_func = api.vmap(vectorized_func, in_axes)\n--> 347 result = vectorized_func(*squeezed_args)\n    349 if not dims_to_expand:\n    350   return result\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/numpy/vectorize.py:184, in _apply_excluded.<locals>.new_func(*args, **kwargs)\n    182 for i, arg in static_args:\n    183   args.insert(i, arg)\n--> 184 return func(*args, **kwargs, **static_kwargs)\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/numpy/lax_numpy.py:9262, in _searchsorted_via_scan(unrolled, sorted_arr, query, side, dtype)\n   9260 n_levels = int(np.ceil(np.log2(len(sorted_arr) + 1)))\n   9261 init = (array(0, dtype=dtype), array(len(sorted_arr), dtype=dtype))\n-> 9262 carry, _ = control_flow.scan(body_fun, init, (), length=n_levels,\n   9263                              unroll=n_levels if unrolled else 1)\n   9264 return carry[1]\n\n    [... skipping hidden 2 frame]\n\nFile ~/Nextcloud/Codes/Python/netket/.venv/lib/python3.13/site-packages/jax/_src/lax/control_flow/loops.py:453, in _check_carry_type(name, body_fun, in_carry, out_carry_tree, out_avals)\n    449 if pvary_msg:\n    450   pvary_msg += (\"See https://docs.jax.dev/en/latest/notebooks/shard_map.html#scan-vma \"\n    451                 \"for more information.\\n\\n\")\n--> 453 raise TypeError(\n    454     f\"{name} function carry input and carry output must have equal types, \"\n    455     \"but they differ:\\n\\n\"\n    456     f\"{differences}\\n\"\n    457     f\"{pvary_msg}\"\n    458     \"Revise the function so that all output types match the corresponding \"\n    459     \"input types.\")\n\nTypeError: scan body function carry input and carry output must have equal types, but they differ:\n\n  * the input carry component state[0] has type int32[] but the corresponding output carry component has type int32[]{V:S}, so the varying manual axes do not match;\n  * the input carry component state[1] has type int32[] but the corresponding output carry component has type int32[]{V:S}, so the varying manual axes do not match.\n\nThis might be fixed by:\n  * applying `jax.lax.pvary(..., ('S',))` to the initial carry value corresponding to the input carry component state[0];\n  * applying `jax.lax.pvary(..., ('S',))` to the initial carry value corresponding to the input carry component state[1].\nSee https://docs.jax.dev/en/latest/notebooks/shard_map.html#scan-vma for more information.\n\nRevise the function so that all output types match the corresponding input types.\n```\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n```\njax:    0.7.0.dev20250701+bf45baf51\njaxlib: 0.6.2\nnumpy:  2.2.6\npython: 3.13.3 (main, May 22 2025, 01:38:47) [Clang 20.1.4 ]\ndevice info: cpu-4, 4 local devices\"\nprocess_count: 1\nplatform: uname_result(system='Darwin', node='mbp-10841385', release='24.5.0', version='Darwin Kernel Version 24.5.0: Tue Apr 22 19:54:49 PDT 2025; root:xnu-114