thub.com/sharadmv","id":1142926,"login":"sharadmv","node_id":"MDQ6VXNlcjExNDI5MjY=","organizations_url":"https://api.github.com/users/sharadmv/orgs","received_events_url":"https://api.github.com/users/sharadmv/received_events","repos_url":"https://api.github.com/users/sharadmv/repos","site_admin":false,"starred_url":"https://api.github.com/users/sharadmv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sharadmv/subscriptions","type":"User","url":"https://api.github.com/users/sharadmv","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/1142926?v=4","events_url":"https://api.github.com/users/sharadmv/events{/privacy}","followers_url":"https://api.github.com/users/sharadmv/followers","following_url":"https://api.github.com/users/sharadmv/following{/other_user}","gists_url":"https://api.github.com/users/sharadmv/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sharadmv","id":1142926,"login":"sharadmv","node_id":"MDQ6VXNlcjExNDI5MjY=","organizations_url":"https://api.github.com/users/sharadmv/orgs","received_events_url":"https://api.github.com/users/sharadmv/received_events","repos_url":"https://api.github.com/users/sharadmv/repos","site_admin":false,"starred_url":"https://api.github.com/users/sharadmv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sharadmv/subscriptions","type":"User","url":"https://api.github.com/users/sharadmv","user_view_type":"public"},{"avatar_url":"https://avatars.githubusercontent.com/u/8038595?v=4","events_url":"https://api.github.com/users/IvyZX/events{/privacy}","followers_url":"https://api.github.com/users/IvyZX/followers","following_url":"https://api.github.com/users/IvyZX/following{/other_user}","gists_url":"https://api.github.com/users/IvyZX/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/IvyZX","id":8038595,"login":"IvyZX","node_id":"MDQ6VXNlcjgwMzg1OTU=","organizations_url":"https://api.github.com/users/IvyZX/orgs","received_events_url":"https://api.github.com/users/IvyZX/received_events","repos_url":"https://api.github.com/users/IvyZX/repos","site_admin":false,"starred_url":"https://api.github.com/users/IvyZX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IvyZX/subscriptions","type":"User","url":"https://api.github.com/users/IvyZX","user_view_type":"public"}],"author_association":"NONE","body":"### Description\n\nFollowing the Pallas Core-specific Programming docs (https://docs.jax.dev/en/latest/pallas/tpu/core_map.html), I've been trying to see if I could write some SparseCore Pallas kernels. The examples in the docs use `shard_map` but I wanted to do testing on a single device (`v6e-1`).\n\nFollowing the docs:\n\n```python\nimport jax\nimport jax.numpy as jnp\nimport jax.experimental.pallas as pl\nfrom jax.experimental.pallas import tpu as pltpu\nfrom jax.experimental.pallas import tpu_sc as plsc\n\nprint(f\"JAX version: {jax.__version__}\")\nprint(f\"Device: {jax.devices()[0]}\")\n\nsc_info = pltpu.get_tpu_info().sparse_core\nprint(f\"SparseCores: {sc_info.num_cores} cores × {sc_info.num_subcores} subcores\")\n```\n\n```\nJAX version: 0.9.0\nDevice: TPU_0(process=0,(0,0,0,0))\nSparseCores: 2 cores × 16 subcores\n```\n\n```python\nsc_mesh = plsc.VectorSubcoreMesh(\n    core_axis_name=\"core\",\n    subcore_axis_name=\"subcore\",\n    num_cores=sc_info.num_cores,\n)\nsc_num_cores = sc_info.num_cores\nsc_num_subcores = sc_info.num_subcores\n\ninput_shape = (1024, 128)\nSC_REG_OP_SHAPE = (4, 16)  # SC register op shape\n```\n\n```python\ndef sc_add_one_body(in_vmem, out_vmem):\n    @pl.loop(0, in_vmem.shape[0], step=SC_REG_OP_SHAPE[0])\n    def _reg_loop_0(c0):\n        @pl.loop(0, in_vmem.shape[1], step=SC_REG_OP_SHAPE[1])\n        def _reg_loop_1(c1):\n            slc = (pl.ds(c0, SC_REG_OP_SHAPE[0]), pl.ds(c1, SC_REG_OP_SHAPE[1]))\n            out_vmem[slc] = in_vmem[slc] + 1\n\n\ndef sc_add_one_kernel(x_hbm_ref, o_hbm_ref):\n    in_shape = x_hbm_ref.shape\n    core_idx = jax.lax.axis_index('core')\n    subcore_idx = jax.lax.axis_index('subcore')\n    cm_idx = core_idx * sc_num_subcores + subcore_idx\n    slc_size = in_shape[0] // (sc_num_subcores * sc_num_cores)\n\n    index_map = lambda i, j: (\n        pl.ds(pl.multiple_of(cm_idx * slc_size + i * 8, 8), 8), j)\n\n    pltpu.emit_pipeline(\n        sc_add_one_body,\n        grid=(slc_size // 8, in_shape[1] // 128),\n        in_specs=[pl.BlockSpec(\n            block_shape=(pl.BoundedSlice(8), 128), index_map=index_map,\n        )],\n        out_specs=[pl.BlockSpec(\n            block_shape=(pl.BoundedSlice(8), 128), index_map=index_map,\n        )]\n    )(x_hbm_ref, o_hbm_ref)\n```\n\n```python\n# The docs wrap this with shard_map for multi-device.\n# We just want to use pl.kernel + VectorSubcoreMesh on a single device.\n# Similar results (failure from rank increases) for attempts with pl.core_map\n\nsc_add_one = pl.kernel(\n    sc_add_one_kernel,\n    out_shape=jax.ShapeDtypeStruct(input_shape, jnp.int32),\n    mesh=sc_mesh,\n)\n\nx = jnp.arange(input_shape[0] * input_shape[1], dtype=jnp.int32).reshape(input_shape)\ny = sc_add_one(x)  # This fails\n```\n\n```\nJaxRuntimeError: INTERNAL: Failed to verify lowered MLO module.\nsc_add_one_kernel.5:176:1: error: expected result type to be 'memref<1x?x128xi32, strided<[1024, 128, 1], offset: ?>, 201>' or a rank-reduced version. (mismatch of result layout), but got 'memref<?x128xi32, 201>'\nsc_add_one_kernel.5:176:1: note: see current operation: %183 = \"memref.subview\"(%180, %182) <{operandSegmentSizes = array<i32: 1, 0, 1, 0>, static_offsets = array<i64: 0, 0, 0>, static_sizes = array<i64: 1, -9223372036854775808, 128>, static_strides = array<i64: 1, 1, 1>}> : (memref<1x?x128xi32, strided<[1024, 128, 1], offset: ?>, 201>, index) -> memref<?x128xi32, 201>\n```\n\n---\n\nI spent some time trying to find a work around and the best I could do is to perform explicit manage DMAs to VMEM instead of using `emit_pipeline`. Pretty sure this is not intended usage as docs (https://openxla.org/xla/sparsecore) say that SPMEM is connected directly to HBM, though maybe fine if you're trying to do something like fused MoE kernels which use SC for top-k / dispatch / gather etc?\n\n```python\nnum_workers = sc_mesh.num_cores * sc_mesh.num_subcores\nrows_per_worker = input_shape[0] // num_workers\nblock_shape = (rows_per_worker, input_shape[1])\n\ndef sc_add_one_kernel_manual(x_hbm_ref, o_hbm_ref):\n    core_idx = jax.lax.axis_index(\"core\")\n    subcore_idx = jax.lax.axis_index(\"subcore\")\n    worker_id = core_idx * sc_mesh.num_subcores + subcore_idx\n    start_row = worker_id * rows_per_worker\n\n    def with_scratch(x_vmem, o_vmem, sem_in, sem_out):\n        # Manual DMA: HBM -> VMEM\n        hbm_slice = (pl.ds(start_row, rows_per_worker), pl.ds(0, input_shape[1]))\n        pltpu.async_copy(x_hbm_ref.at[hbm_slice], x_vmem, sem_in).wait()\n\n        # Compute using SC register ops\n        @pl.loop(0, rows_per_worker, step=SC_REG_OP_SHAPE[0])\n        def row_loop(r):\n            @pl.loop(0, input_shape[1], step=SC_REG_OP_SHAPE[1])\n            def col_loop(c):\n                slc = (pl.ds(r, SC_REG_OP_SHAPE[0]), pl.ds(c, SC_REG_OP_SHAPE[1]))\n                o_vmem[slc] = x_vmem[slc] + 1\n\n        # Manual DMA: VMEM -> HBM\n        pltpu.async_copy(o_vmem, o_hbm_ref.at[hbm_slice], sem_out).wait()\n\n    pl.run_scoped(\n        with_scratch,\n        pltpu.VMEM(block_shape, jnp.int32),\n        pltpu.VMEM(block_shape, jnp.int32),\n        pltpu.SemaphoreType.DMA,\n        pltpu.SemaphoreType.DMA,\n    )\n\nsc_add_one_manual = pl.kernel(\n    sc_add_one_kernel_manual,\n    out_shape=jax.ShapeDtypeStruct(input_shape, jnp.int32),\n    mesh=sc_mesh,\n)\n\nx = jnp.arange(input_shape[0] * input_shape[1], dtype=jnp.int32).reshape(input_shape)\ny = sc_add_one_manual(x)\nprint(f\"Workaround \\\"success\\\": {bool(jnp.all(y == x + 1))}\")\n```\n\n```\nWorkaround \"success\": True\n```\n\n---\n\nOne thing I also tried but couldn't get to work was, instead of using `VectorSubcoreMesh`, to directly use `pallas_call` with the `SC_VECTOR_SUBCORE` kernel type flag. Seems like `emit_pipeline` trying to perform unsupported SPMEM-to-SPMEM DMAs?\n\n```python\ndef emit_pipeline_body(in_vmem, out_vmem):\n    @pl.loop(0, in_vmem.shape[0], step=SC_REG_OP_SHAPE[0])\n    def _row_loop(r):\n        @pl.loop(0, in_vmem.shape[1], step=SC_REG_OP_SHAPE[1])\n        def _col_loop(c):\n            slc = (pl.ds(r, SC_REG_OP_SHAPE[0]), pl.ds(c, SC_REG_OP_SHAPE[1]))\n            out_vmem[slc] = in_vmem[slc] + 1\n\ndef emit_pipeline_kernel(x_ref, o_ref):\n    block_shape = (8, 128)\n    grid = (input_shape[0] // block_shape[0], input_shape[1] // block_shape[1])\n\n    pltpu.emit_pipeline(\n        emit_pipeline_body,\n        grid=grid,\n        in_specs=[pl.BlockSpec(block_shape=block_shape, index_map=lambda i, j: (i, j))],\n        out_specs=[pl.BlockSpec(block_shape=block_shape, index_map=lambda i, j: (i, j))],\n    )(x_ref, o_ref)\n\nemit_pipeline_add_one = pl.pallas_call(\n    emit_pipeline_kernel,\n    out_shape=jax.ShapeDtypeStruct(input_shape, jnp.int32),\n    compiler_params=pltpu.CompilerParams(\n        kernel_type=pltpu.KernelType.SC_VECTOR_SUBCORE\n    ),\n)\n\nx = jnp.arange(input_shape[0] * input_shape[1], dtype=jnp.int32).reshape(input_shape)\ny = emit_pipeline_add_one(x)\n```\n\n```\nJaxRuntimeError: INTERNAL: INVALID_ARGUMENT: SparseCore does not support transfers with relaxed ordering from local TileSpmem to local TileSpmem issued from TEC when both memories are on SparseCore.\n\nat location: loc(\"tpu_custom_call.5\":146:1)\n\nThe MLIR operation involved:\n  \"tpu.enqueue_dma\"(%35, %40, %45) <{operandSegmentSizes = array<i32: 1, 0, 1, 1, 0, 0>, priority = 0 : i32, strict_ordering = false}> : (memref<8x128xi32, #tpu.tiled<(8),[16,1]>, #tpu.memory_space<vmem>>, memref<8x128xi32, #tpu.memory_space<vmem>>, memref<!tpu.dma_semaphore, #tpu.memory_space<semaphore_mem>>) -> ()\n... additional diagnostics were skipped.\n\nPlease report a bug at: https://github.com/jax-ml/jax/issues/new?assignees=apaszke\n```\n\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\n```\n  jax:    0.9.0                                                                                                                                    \n  jaxlib: 0.9.0                                                                                                                                    \n  numpy:  2.4.1                                                                                                                                    \n  python: 3.11.14 (main, Oct 21 2025, 18:31:21) [GCC 11.2.0]                                                                                       \n  device info: TPU v6 lite-1, 1 local devices\"                                                                                                     \n  process_count: 1                                                                                                                                 \n  platform: uname_result(system='Linux', node='t1v-n-1e9f9c26-w-0', release='6.8.0-1015-gcp', version='#17~22.04.1-Ubuntu SMP Tue Sep  3           \n  16:11:52 UTC 2024', machine='x86_64') \n```","closed_at":"2026-01-28T22:28:26Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/8038595?v=4","events_url":"https://api.github.com/users/IvyZX/events{/privacy}","followers_url":"https://api.github.com/users/IvyZX/followers","following_url":"https://api.github.com/users/IvyZX/following{/other_user}","gists_url":"https://api.github.com/users/IvyZX/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/IvyZX","id":8038595,"login":"IvyZX","node_id":"MDQ6VXNlcjgwMzg1OTU=","organizations_url":"https://api.github.com/users/IvyZX/orgs","received_events_url":"https://api.github.com/users/IvyZX/received_events","repos_url":"https://api.github.com/user