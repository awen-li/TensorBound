_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1255655808/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1255754965","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1255754965","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1255754965,"node_id":"IC_kwDODGgK6M5K2UzV","user":{"login":"benvanik","id":75337,"node_id":"MDQ6VXNlcjc1MzM3","avatar_url":"https://avatars.githubusercontent.com/u/75337?v=4","gravatar_id":"","url":"https://api.github.com/users/benvanik","html_url":"https://github.com/benvanik","followers_url":"https://api.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-23T03:07:39Z","updated_at":"2022-09-23T03:07:39Z","body":"That won't work for long as it's not retaining the semaphore it's returning - but more importantly you can't share semaphores like that as that would cause timelines to go backwards.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1255754965/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes"