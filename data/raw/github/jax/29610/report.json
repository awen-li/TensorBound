ub.com/repos/jax-ml/jax/issues/29610","minimized":null,"node_id":"IC_kwDOCTkjjc60S_JQ","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3024876112/reactions"},"updated_at":"2025-07-01T17:09:20Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3024876112","user":{"avatar_url":"https://avatars.githubusercontent.com/u/40721229?v=4","events_url":"https://api.github.com/users/markus7800/events{/privacy}","followers_url":"https://api.github.com/users/markus7800/followers","following_url":"https://api.github.com/users/markus7800/following{/other_user}","gists_url":"https://api.github.com/users/markus7800/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/markus7800","id":40721229,"login":"markus7800","node_id":"MDQ6VXNlcjQwNzIxMjI5","organizations_url":"https://api.github.com/users/markus7800/orgs","received_events_url":"https://api.github.com/users/markus7800/received_events","repos_url":"https://api.github.com/users/markus7800/repos","site_admin":false,"starred_url":"https://api.github.com/users/markus7800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markus7800/subscriptions","type":"User","url":"https://api.github.com/users/markus7800","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/40721229?v=4","events_url":"https://api.github.com/users/markus7800/events{/privacy}","followers_url":"https://api.github.com/users/markus7800/followers","following_url":"https://api.github.com/users/markus7800/following{/other_user}","gists_url":"https://api.github.com/users/markus7800/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/markus7800","id":40721229,"login":"markus7800","node_id":"MDQ6VXNlcjQwNzIxMjI5","organizations_url":"https://api.github.com/users/markus7800/orgs","received_events_url":"https://api.github.com/users/markus7800/received_events","repos_url":"https://api.github.com/users/markus7800/repos","site_admin":false,"starred_url":"https://api.github.com/users/markus7800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markus7800/subscriptions","type":"User","url":"https://api.github.com/users/markus7800","user_view_type":"public"},"author_association":"NONE","body":"After some digging I found that `jax.lax.linalg.cholesky` is the culprit.\n\nAfter exporting like\n```python\nimport jax.export\nimport jax\nimport jax.numpy as jnp\n\nchol = jax.jit(jax.lax.linalg.cholesky)\ninput = jnp.eye(1)\nexported_main = jax.export.export(chol)(input)\nwith open(\"tmp.bin\", \"wb\") as file:\n    file.write(exported_main.serialize())\n```\nimporting (in a new process) causes a segmentation fault (on CPU)\n```python\nwith open(\"tmp.bin\", \"rb\") as file:\n    exported_fn = bytearray(file.read())\n    rehydrated_fn = jax.export.deserialize(exported_fn)\n    out = rehydrated_fn.call(input)  # seg-fault\n    print(out)\n```\nAdding `chol.trace(input).lower()` before importing makes the segfault go away.\nAgain, this bug occurs only in my CPU installation and not in my CUDA JAX installation.","created_at":"2025-07-17T06:23:52Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29610#issuecomment-3082737099","id":3082737099,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29610","minimized":null,"node_id":"IC_kwDOCTkjjc63vtXL","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3082737099/reactions"},"updated_at":"2025-07-18T13:35:01Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/3082737099","user":{"avatar_url":"https://avatars.githubusercontent.com/u/40721229?v=4","events_url":"https://api.github.com/users/markus7800/events{/privacy}","followers_url":"https://api.github.com/users/markus7800/followers","following_url":"https://api.github.com/users/markus7800/following{/other_user}","gists_url":"https://api.github.com/users/markus7800/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/markus7800","id":40721229,"login":"markus7800","node_id":"MDQ6VXNlcjQwNzIxMjI5","organizations_url":"https://api.github.com/users/markus7800/orgs","received_events_url":"https://api.github.com/users/markus7800/received_events","repos_url":"https://api.github.com/users/markus7800/repos","site_admin":false,"starred_url":"https://api.github.com/users/markus7800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markus7800/subscriptions","type":"User","url":"https://api.github.com/users/markus7800","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/40721229?v=4","events_url":"https://api.github.com/users/markus7800/events{/privacy}","followers_url":"https://api.github.com/users/markus7800/followers","following_url":"https://api.github.com/users/markus7800/following{/other_user}","gists_url":"https://api.github.com/users/markus7800/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/markus7800","id":40721229,"login":"markus7800","node_id":"MDQ6VXNlcjQwNzIxMjI5","organizations_url":"https://api.github.com/users/markus7800/orgs","received_events_url":"https://api.github.com/users/markus7800/received_events","repos_url":"https://api.github.com/users/markus7800/repos","site_admin":false,"starred_url":"https://api.github.com/users/markus7800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markus7800/subscriptions","type":"User","url":"https://api.github.com/users/markus7800","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2025-07-17T06:24:03Z","event":"renamed","id":18673090577,"node_id":"RTE_lADOCTkjjc68jkNIzwAAAARZAMAR","performed_via_github_app":null,"rename":{"from":"Segmentation fault when calling exported function on CPU","to":"Segmentation fault when calling exported choleksy on CPU"},"url":"https://api.github.com/repos/jax-ml/jax/issues/events/18673090577"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/142375774?v=4","events_url":"https://api.github.com/users/Ma-gi-cian/events{/privacy}","followers_url":"https://api.github.com/users/Ma-gi-cian/followers","following_url":"https://api.github.com/users/Ma-gi-cian/following{/other_user}","gists_url":"https://api.github.com/users/Ma-gi-cian/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/Ma-gi-cian","id":142375774,"login":"Ma-gi-cian","node_id":"U_kgDOCHx7Xg","organizations_url":"https://api.github.com/users/Ma-gi-cian/orgs","received_events_url":"https://api.github.com/users/Ma-gi-cian/received_events","repos_url":"https://api.github.com/users/Ma-gi-cian/repos","site_admin":false,"starred_url":"https://api.github.com/users/Ma-gi-cian/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ma-gi-cian/subscriptions","type":"User","url":"https://api.github.com/users/Ma-gi-cian","user_view_type":"public"},"created_at":"2025-11-25T11:25:43Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hawkinsp/subscriptions","type":"User","url":"https://api.github.com/users/hawkinsp","user_view_type":"public"}],"author_association":"CONTRIBUTOR","body":"Closes #29610 - Fixes segfault when exporting choleksy and svd functions\r\n\r\n### **Example Code**\r\n\r\n**test.py**\r\n```python\r\nimport jax\r\nimport jax.numpy as jnp\r\n\r\nwith open(\"tmp.bin\", \"rb\") as file:\r\n    exported_fn = bytearray(file.read())\r\n    rehydrated_fn = jax.export.deserialize(exported_fn)\r\n    data = jnp.array([[2.0, 1.0], [1.0, 2.0]])\r\n    out = rehydrated_fn.call(data)  # seg-fault\r\n    print(out)\r\n```\r\n\r\n**main.py**\r\n```python\r\nimport jax.export\r\nimport jax\r\nimport jax.numpy as jnp\r\n\r\nchol = jax.jit(jax.lax.linalg.cholesky)\r\ndata = jnp.array([[2.0, 1.0], [1.0, 2.0]])\r\nexported_main = jax.export.export(chol)(data)\r\nwith open(\"tmp.bin\", \"wb\") as file:\r\n    file.write(exported_main.serialize())\r\n```\r\n\r\n**Working Output**\r\n```bash\r\n(jax-dev) jha@MAGICIAN:~/workspace/opensource/reports/jax-bug-choskley$ python test.py\r\nWARNING:2025-11-25 10:56:18,160:jax._src.xla_bridge:854: An NVIDIA GPU may be present on this machine, but a CUDA-enabled jaxlib is not installed. Falling back to cpu.\r\n[[1.4142135  0.        ]\r\n [0.70710677 1.2247449 ]]\r\n(jax-dev) jha@MAGICIAN:~/workspace/opensource/reports/jax-bug-choskley$ \r\n```\r\n\r\n## Reason behind the error:\r\n\r\n- These functions ( choleksy , svd , and about in total 15 functions in that particular file where they are defined ) use ffi handlers to get the kernels to perform the operation.\r\n- These kernel functions are initialized as nullptr and are statically loaded when calling these functions - during normal computation, hence no error.\r\n- When we export we also correctly embeed the information regarding where they should be.\r\n- But when we deseralize them again - like load them from the tmp.bin file - the mlir script ( subscript of mlir ) - we do not initialize the lapack kernels ( backends )  and they keep on pointing at the nullptr and hence fail.\r\n- This does not happen in GPU because they are not statically linked but dynamically so they are always initialized at runtime.\r\n- The trace also causes them to be initialized hence running the trace functions on them causes them to not give segfault ","closed_at":"2026-04-01T20:54:16Z","comments":6,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/33522/comments","created_at":"2025-11-25T11:25:42Z","draft":false,"events_url":"https://api.github.com/repos/jax-ml/jax/issues/33522/events","html_url":"https://github.com/jax-ml/jax/pull/33522","id":3662665292,"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"5B293D","default":false,"description":"","id":2130364640,"name":"kokoro:force-run","node_id":"MDU6TGFiZWwyMTMwMzY0NjQw","url":"https://api.github.com/repos/jax-ml/jax/labels/kokoro:force-run"},{"archived_at":null,"archived_by":null,"color":"d4c5f