i.github.com/users/benvanik/followers","following_url":"https://api.github.com/users/benvanik/following{/other_user}","gists_url":"https://api.github.com/users/benvanik/gists{/gist_id}","starred_url":"https://api.github.com/users/benvanik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benvanik/subscriptions","organizations_url":"https://api.github.com/users/benvanik/orgs","repos_url":"https://api.github.com/users/benvanik/repos","events_url":"https://api.github.com/users/benvanik/events{/privacy}","received_events_url":"https://api.github.com/users/benvanik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-20T16:59:29Z","updated_at":"2022-09-20T16:59:29Z","body":"there's no known issues with barriers within command buffers - vulkan and cpu both take advantage of them - so I'd check your usage of the API or try to build a reproducer?","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252641378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1252650434","html_url":"https://github.com/iree-org/iree/issues/10483#issuecomment-1252650434","issue_url":"https://api.github.com/repos/iree-org/iree/issues/10483","id":1252650434,"node_id":"IC_kwDODGgK6M5Kqe3C","user":{"login":"raikonenfnu","id":68087699,"node_id":"MDQ6VXNlcjY4MDg3Njk5","avatar_url":"https://avatars.githubusercontent.com/u/68087699?v=4","gravatar_id":"","url":"https://api.github.com/users/raikonenfnu","html_url":"https://github.com/raikonenfnu","followers_url":"https://api.github.com/users/raikonenfnu/followers","following_url":"https://api.github.com/users/raikonenfnu/following{/other_user}","gists_url":"https://api.github.com/users/raikonenfnu/gists{/gist_id}","starred_url":"https://api.g