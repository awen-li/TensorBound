Subject: [PATCH 2/6] [AMD] Address review: drop dead NaN comment, use i16_val
 helper

Per review on #10747:
- e4m3fnuz -> f16: remove the stale 'Check NaN' comment left behind when
  the NaN guard moved to the last write.
- e5m2fnuz -> f16: use b.i16_val(0x7E00) instead of b.int_val(16, 0x7E00)
  for consistency with the surrounding code.
---
 .../amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp     | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp b/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp
index f4263127fa59..586e1025be81 100644
--- a/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp
+++ b/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp
@@ -968,9 +968,6 @@ class CvtFp8E4M3ToFp16 : public ConverterInterface {
 
     Value v8 = b.bitcast(v, i8_ty);
     Value vAbs = b.and_(v8, b.i8_val(0x7F));
-    // Check NaN (1.0000.000 in E4M3FNUZ)
-    // Pick an arbitrary number which represents NaN in fp16 (exp=11111 and mant
-    // != 0)
 
     // Check denorms and zero
     // Here we use a LUT to map S.0000.000 ~ S.0000.111 to its corresponding
@@ -1159,7 +1156,7 @@ class CvtFp8E5M2ToFp16 : public ConverterInterface {
 
     // 0x80 is the single NaN encoding in E5M2FNUZ (no -0); map it to an fp16
     // NaN.
-    o = b.select(b.icmp_eq(v, b.i8_val(0x80)), b.int_val(16, 0x7E00), o);
+    o = b.select(b.icmp_eq(v, b.i8_val(0x80)), b.i16_val(0x7E00), o);
 
     return b.bitcast(o, f16_ty);
   }

