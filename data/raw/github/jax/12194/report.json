 PRNGKey I am using in the jax function in order to have deterministic RNG across the Python/jax boundary.\n\nUnfortunately, `default_rng` fails with jax arrays. (It's probably a bug on their end, but still, as you documented the callback to always return numpy arrays...)","created_at":"2022-09-02T10:24:33Z","html_url":"https://github.com/jax-ml/jax/issues/12194#issuecomment-1235330789","id":1235330789,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/12194","minimized":null,"node_id":"IC_kwDOCTkjjc5Joabl","performed_via_github_app":null,"pin":null,"reactions":{"+1":1,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":1,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1235330789/reactions"},"updated_at":"2022-09-02T10:24:53Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1235330789","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/1142926?v=4","events_url":"https://api.github.com/users/sharadmv/