type=np.float32,\n                 device=jax.NamedSharding(mesh, jax.P(\"a\")))\n\n    def np_func(x):\n      x = np.array(x)\n      x[::2] = 0.0\n      return x\n\n    def f(x):\n      y = jax.pure_callback(\n          np_func,\n          jax.ShapeDtypeStruct(x.shape, x.dtype),\n          jax.device_put(x, device=jax.devices(\"cpu\")[0]),\n          sharding=jax.sharding.SingleDeviceSharding(jax.devices(\"cpu\")[0]))\n      return jax.device_put(y, jax.NamedSharding(mesh, jax.P(\"a\")))\n\n    f(x)  # doesn't crash\n    jax.jit(f)(x)  # doesn't crash\n```\n\nand it seems to work for me. Can you try running with jax nightly?","created_at":"2026-06-03T19:57:16Z","html_url":"https://github.com/jax-ml/jax/issues/38164#issuecomment-4616212289","id":4616212289,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/38164","minimized":null,"node_id":"IC_kwDOCTkjjc8AAAABEyXPQQ","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/4616212289/reactions"},"updated_at":"2026-06-03T19:57:16Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/4616212289","user":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk281