ng.NamedSharding(\n    mesh, jax.P('S')\n    )\n\n# works\njax.numpy.ones((4,), device=sharding)\n\n# fails\njax.numpy.ones((4,), out_sharding=sharding)\n```\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\njax 0.7.1","closed_at":"2025-09-12T10:37:57Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"},"comments":4,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/31753/comments","created_at":"2025-09-11T16:04:12Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/31753/events","html_url":"https://github.com/jax-ml/jax/issues/31753","id":3407196140,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/31753/labels{/name}","locked":false,"milestone"