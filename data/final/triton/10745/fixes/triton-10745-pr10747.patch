From 7b8b3ff7131c734d6cd63042e3f22d5eb4e3a36e Mon Sep 17 00:00:00 2001
From: Xuyang Li <li5274@purdue.edu>
Date: Mon, 29 Jun 2026 06:39:31 +0000
Subject: [PATCH 1/6] [AMD] Fix fp8 e4m3fnuz/e5m2fnuz NaN (0x80) silently
 decoding to a finite value

The fnuz fp8 formats (e4m3fnuz / e5m2fnuz) have no -0 and no Inf; the byte
0x80 is their single NaN encoding. On AMD targets without native fnuz fp8
conversion (everything except CDNA3), the upcast is done in software, and the
software decoders turn 0x80 into a finite signed value instead of NaN -- a
silent miscompile of the one input the exhaustive conversion test masks out.

Three software decoders are affected:

- Fp8E4M3fnuzToFp16OneValue had a 0x80 -> fp16 NaN (0x7E00) guard, but the
  denorm/zero LUT (vAbs==0 -> 0x0000) and the trailing sign-applying `or` ran
  after it and clobbered the NaN back to -0.0 (0x8000). Move the guard to be
  the last write so neither can overwrite it.

- Fp8E5M2fnuzToFp16OneValue had no 0x80 case at all (exp==0 produced 0x8000).
  Add the 0x80 -> 0x7E00 guard before the final bitcast.

- Fp8E4M3fnuzToBf16SW has its own bit-trick decoder that turns 0x80 into bf16
  -0.0; add a per-lane 0x80 -> bf16 NaN (0x7FC0) guard.

The two remaining fnuz upcasts route through these: e5m2fnuz -> bf16 calls
Fp8E5M2fnuzToFp16SW, and both -> fp32 go fp8 -> fp16 -> fp32, so all fnuz
upcasts now preserve NaN. The OCP (non-fnuz) e4m3fn / e5m2 decoders are
unchanged: e4m3fn has a signed zero, so its 0x80 -> -0.0 is correct.

The exhaustive upcast test replaces 0x80 with 0 before converting, so it never
exercised this byte; add test_typeconvert_upcast_fnuz_nan to cover it directly
for fp16/bf16/fp32.
---
 python/test/unit/language/test_conversions.py | 31 +++++++++++++++++++
 .../ConvertFpCastOpToLLVM.cpp                 | 19 ++++++++++--
 2 files changed, 47 insertions(+), 3 deletions(-)

diff --git a/python/test/unit/language/test_conversions.py b/python/test/unit/language/test_conversions.py
index 6375d6a90918..9d75ae5787e7 100644
--- a/python/test/unit/language/test_conversions.py
+++ b/python/test/unit/language/test_conversions.py
@@ -433,3 +433,34 @@ def test_typeconvert_downcast_clamping(src_dtype, dst_dtype, mode, device, round
         assert(torch.all(torch.isnan(dst)))
     else:
         torch.testing.assert_close(dst, torch.full_like(dst, expected_result))
+
+
+@pytest.mark.parametrize("src_dtype", ['float8e4b8', 'float8e5b16'])
+@pytest.mark.parametrize("dst_dtype", ['float16', 'bfloat16', 'float32'])
+def test_typeconvert_upcast_fnuz_nan(src_dtype, dst_dtype, device):
+    # The fnuz fp8 formats (float8e4b8 / float8e5b16) have no -0 and no inf; the
+    # byte 0x80 is their single NaN encoding. Upcasting 0x80 must yield a NaN.
+    # This is the one input the exhaustive upcast test masks out (it replaces
+    # 0x80 with 0 before converting), so it is tested explicitly here for every
+    # destination type. The software decode path (where 0x80 was mishandled) is
+    # exercised on every non-CDNA3 arch; CDNA3 uses the hardware path. The skips
+    # below mirror test_typeconvert_upcast (fnuz is unsupported on RDNA3/CDNA2).
+    if not is_hip():
+        pytest.skip("fnuz fp8 is an AMD format")
+    if is_hip_rdna3():
+        pytest.skip(f"{src_dtype} is not supported on AMDGPU RDNA3")
+    if is_hip_cdna2():
+        pytest.skip(f"{src_dtype} is not supported on current AMD GPU")
+
+    tl_src = getattr(tl, src_dtype)
+    tl_dst = getattr(tl, dst_dtype)
+
+    # A buffer of the single NaN byte 0x80 (-128 as a signed int8 has the 0x80 bit pattern).
+    BLOCK_SIZE = 4096
+    src = torch.full((BLOCK_SIZE,), -128, dtype=torch.int8, device=device)
+    dst = launch_type_convert_triton(src, tl_src, tl_dst, device=device, BLOCK_SIZE=BLOCK_SIZE)
+
+    torch_dst = {tl.float16: torch.float16, tl.bfloat16: torch.bfloat16,
+                 tl.float32: torch.float32}[tl_dst]
+    assert torch.all(torch.isnan(dst.view(torch_dst))), \
+        f"fnuz {src_dtype} NaN byte 0x80 -> {dst_dtype} should be NaN, got {dst[0].item():#x}"
diff --git a/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp b/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp
index 9d6b17a7ce25..f4263127fa59 100644
--- a/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp
+++ b/third_party/amd/lib/TritonAMDGPUToLLVM/ConvertFpCastOpToLLVM.cpp
@@ -971,7 +971,6 @@ class CvtFp8E4M3ToFp16 : public ConverterInterface {
     // Check NaN (1.0000.000 in E4M3FNUZ)
     // Pick an arbitrary number which represents NaN in fp16 (exp=11111 and mant
     // != 0)
-    a = b.select(b.icmp_eq(v8, b.i8_val(0x80)), b.i16_val(0x7E00), a);
 
     // Check denorms and zero
     // Here we use a LUT to map S.0000.000 ~ S.0000.111 to its corresponding
@@ -993,6 +992,10 @@ class CvtFp8E4M3ToFp16 : public ConverterInterface {
 
     // Set sign
     a = b.or_(a, sign);
+    // NaN guard must be the LAST write: the denorm/zero LUT (vAbs==0 -> 0) and
+    // this sign-or would otherwise clobber the NaN for the 0x80 (FNUZ NaN)
+    // byte.
+    a = b.select(b.icmp_eq(v8, b.i8_val(0x80)), b.i16_val(0x7E00), a);
     a = b.bitcast(a, f16_ty);
 
     return a;
@@ -1154,6 +1157,10 @@ class CvtFp8E5M2ToFp16 : public ConverterInterface {
     auto o12 = b.select(e_is_one, o2, o1);
     auto o = b.select(e_is_zero, o0, o12);
 
+    // 0x80 is the single NaN encoding in E5M2FNUZ (no -0); map it to an fp16
+    // NaN.
+    o = b.select(b.icmp_eq(v, b.i8_val(0x80)), b.int_val(16, 0x7E00), o);
+
     return b.bitcast(o, f16_ty);
   }
 
@@ -1302,8 +1309,14 @@ class CvtFp8E4M3ToBf16 : public ConverterInterface {
     // Unpack the 2 bfloat16 values and return them
     auto bf16x2VecTy = vec_ty(bf16_ty, 2);
     out0 = b.bitcast(out0, bf16x2VecTy);
-    return {b.extract_element(bf16_ty, out0, b.i32_val(0)),
-            b.extract_element(bf16_ty, out0, b.i32_val(1))};
+    Value r0 = b.extract_element(bf16_ty, out0, b.i32_val(0));
+    Value r1 = b.extract_element(bf16_ty, out0, b.i32_val(1));
+    // 0x80 is the single NaN encoding in E4M3FNUZ (no -0); the bit-trick above
+    // turns it into -0.0, so map it to a bf16 NaN (0x7FC0) per lane.
+    Value bf16Nan = b.bitcast(b.i16_val(0x7FC0), bf16_ty);
+    Value isNan0 = b.icmp_eq(v[0], b.i8_val(0x80));
+    Value isNan1 = b.icmp_eq(v[1], b.i8_val(0x80));
+    return {b.select(isNan0, bf16Nan, r0), b.select(isNan1, bf16Nan, r1)};
   }
 
 private:

From 36b6f43cb1d0edcd4000eaf0ec8f8711760e8f2a Mon Sep 17 00:00:00 2001
