iree-org/iree/issues/comments/1969987781/reactions"},"updated_at":"2024-02-28T21:57:06Z","url":"https://api.github.com/repos/iree-org/iree/issues/comments/1969987781","user":{"avatar_url":"https://avatars.githubusercontent.com/u/79535?v=4","events_url":"https://api.github.com/users/bjacob/events{/privacy}","followers_url":"https://api.github.com/users/bjacob/followers","following_url":"https://api.github.com/users/bjacob/following{/other_user}","gists_url":"https://api.github.com/users/bjacob/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/bjacob","id":79535,"login":"bjacob","node_id":"MDQ6VXNlcjc5NTM1","organizations_url":"https://api.github.com/users/bjacob/orgs","received_events_url":"https://api.github.com/users/bjacob/received_events","repos_url":"https://api.github.com/users/bjacob/repos","site_admin":false,"starred_url":"https://api.github.com/users/bjacob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bjacob/subscriptions","type":"User","url":"https://api.github.com/users/bjacob","user_view_type":"public"}},{"author_association":"MEMBER","body":"Unrelated to whether we should act on the errors: Is it expected behavior that these errors don't fail the tests? ","created_at":"2024-02-28T22:31:39Z","html_url":"https://github.com/iree-org/iree/issues/16608#issuecomment-1970030930","id":1970030930,"issue_url":"https://api.github.com/repos/iree-org/iree/issues/16608","minimized":null,"node_id":"IC_kwDODGgK6M51bElS","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1970030930/reactions"},"updated_at":"2024-02-28T22:31:39Z","url":"https://api.github.com/repos/iree-org/iree/issues/comments/1970030930","user":{"avatar_url":"https://avatars.githubusercontent.com/u/309732?v=4","events_url":"https://api.github.com/users/julianwa/events{/privacy}","followers_url":"https://api.github.com/users/julianwa/followers","following_url":"https://api.github.com/users/julianwa/following{/other_user}","gists_url":"https://api.github.com/users/julianwa/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/julianwa","id":309732,"login":"julianwa","node_id":"MDQ6VXNlcjMwOTczMg==","organizations_url":"https://api.github.com/users/julianwa/orgs","received_events_url":"https://api.github.com/users/julianwa/received_events","repos_url":"https://api.github.com/users/julianwa/repos","site_admin":false,"starred_url":"https://api.github.com/users/julianwa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/julianwa/subscriptions","type":"User","url":"https://api.github.com/users/julianwa","user_view_type":"public"}},{"author_association":"COLLABORATOR","body":"yes, typical. this undefined behavior could translate into anything in theory, but when the target load/store instructions don't have any alignment requirement, that would \"just work\". When the target load/store instructions do have an alignment requirement, the observed behavior would be a crash. On some target architectures, both kinds of instructions exist so it can be a matter of luck that determines in which cases you fall. And when the compiler can tell at compile time that the address is going to be misaligned, some wilder things can happen, such as, simply omitting the load/store on the basis that \"it would be undefined behavior anyway if it happened\".","created_at":"2024-02-29T02:56:54Z","html_url":"https://github.com/iree-org/iree/issues/16608#issuecomment-1970307499","id":1970307499,"issue_url":"https://api.github.com/repos/iree-org/iree/issues/16608","minimized":null,"node_id":"IC_kwDODGgK6M51cIGr","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/iree-org/iree/issues/comments/1970307499/reactions"},"updated_at":"2024-02-29T02:56:54Z","url":"https://api.github.com/repos/iree-org/iree/issues/comments/1970307499","user":{"avatar_url":"https://avatars.githubusercontent.com/u/79535?v=4","events_url":"https://api.github.com/users/bjacob/events{/privacy}","followers_url":"https://api.github.com/users/bjacob/followers","following_url":"https://api.github.com/users/bjacob/following{/other_user}","gists_url":"https://api.github.com/users/bjacob/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/bjacob","id":79535,"login":"bjacob","node_id":"MDQ6VXNlcjc5NTM1","organizations_url":"https://api.github.com/users/bjacob/orgs","received_events_url":"https://api.github.com/users/bjacob/received_events","repos_url":"https://api.github.com/users/bjacob/repos","site_admin":false,"starred_url":"https://api.github.com/users/bjacob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bjacob/subscriptions","type":"User","url":"https://api.github.com/users/bjacob","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"CONTRIBUTOR","body":"### What happened?\n\nWas running asan tests memory_stream_test and gguf_parser_test downstream, and got illegal instructions errors.  Turned on ubsan and got more detailed errors.\r\n\r\nThen tried it with a copy of github/openxla/iree @ head, compiled with ubsan.  ctest don't fail but the LastLog shows the runtime error messages.  Also see it in raw test output when test binaries are run directly.\r\n\r\n[ RUN      ] MemoryStreamTest.Fill\r\n/opt/work/iree/github-head/openxla/iree/runtime/src/iree/io/memory_stream.c:267:9: runtime error: store to misaligned address 0x7ffdba454351 for type 'uint16_t' (aka 'unsigned short'), which requires 2 byte alignment\r\n0x7ffdba454351: note: pointer points here\r\n 56 00 00  dd dd dd dd dd dd dd dd  dd dd dd dd dd dd dd dd  50 81 45 8d 54 56 00 00  a8 53 45 ba fd\r\n              ^ \r\nSUMMARY: UndefinedBehaviorSanitizer: undefined-behavior /opt/work/iree/github-head/openxla/iree/runtime/src/iree/io/memory_stream.c:267:9 in \r\n\r\n[ RUN      ] GgufFormatTest.SingleTensor\r\n/opt/work/iree/github-head/openxla/iree/runtime/src/iree/io/formats/gguf/gguf_parser.c:417:22: runtime error: load of misaligned address 0x558d6855052e for type 'const uint64_t' (aka 'const unsigned long'), which requires 8 byte alignment\r\n0x558d6855052e: note: pointer points here\r\n 02 00 00 00 02 00  00 00 00 00 00 00 02 00  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  00 00\r\n             ^ \r\nSUMMARY: UndefinedBehaviorSanitizer: undefined-behavior /opt/work/iree/github-head/openxla/iree/runtime/src/iree/io/formats/gguf/gguf_parser.c:417:22 in \r\n\r\nMore detailed output at memory_stream_test: https://gist.github.com/yuennancy/e0ad695cc2d5097ccbd4a16872d13382\r\nand gguf_parser_test: https://gist.github.com/yuennancy/77d268f08721b5dc72fe3bce8f7525ae\n\n### Steps to reproduce your issue\n\n1. Configure cmake with ubsan:\r\n```cmake -G Ninja -B ../iree-build/ -S .     -DCMAKE_BUILD_TYPE=Debug     -DIREE_ENABLE_ASSERTIONS=ON     -DIREE_ENABLE_SPLIT_DWARF=ON     -DIREE_ENABLE_THIN_ARCHIVES=ON     -DCMAKE_C_COMPILER=clang     -DCMAKE_CXX_COMPILER=clang++     -DIREE_ENABLE_LLD=ON -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DIREE_ENABLE_UBSAN=ON```\r\n\r\n2. Build memory_stream_test and gguf_parser_test:\r\n```cmake --build ../iree-build/ --target runtime/src/iree/io/memory_stream_test --target runtime/src/iree/io/formats/gguf/gguf_parser_test```\r\n\r\n3. Run ctest and view Lastlog output.  ctest passes, but errors will show up in Lastlog:\r\n```ctest --test-dir ../iree-build/  -R memory_stream_test; cat ../iree-build/Testing/Temporary/LastTest.log```\r\n\r\n```ctest --test-dir ../iree-build/  -R gguf_parser_test; cat ../iree-build/Testing/Temporary/LastTest.log```\r\n\r\n4. Run tests directly.  Tests pass, but errors are in the test output:\r\n```../iree-build/runtime/src/iree/io/memory_stream_test```\r\n\r\n```../iree-build/runtime/src/iree/io/gguf_parser_test```\r\n\n\n### What component(s) does this issue relate to?\n\nRuntime\n\n### Version information\n\nChecked out IREE @ head\n\n### Additional context\n\n_No response_","closed_at":null,"closed_by":null,"comments":5,"comments_url":"https://api.github.com/repos/iree-org/iree/issues/16608/comments","created_at":"2024-02-28T20:54:42Z","events_url":"https://api.github.com/repos/iree-org/iree/issues/16608/events","html_url":"https://github.com/iree-org/iree/issues/16608","id":2159852296,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":false,"description":"Something isn't working","id":1553038945,"name":"bug 🐞","node_id":"MDU6TGFiZWwxNTUzMDM4OTQ1","url":"https://api.github.com/repos/iree-org/iree/labels/bug%20%F0%9F%90%9E"}],"labels_url":"https://api.github.com/repos/iree-org/iree/issues/16608/labels{/name}","locked":false,"milestone":null,"node_id":"I_kwDODGgK6M6AvLsI","number":16608,"performed_via_github_app":null,"pinned_comment":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/iree-org/iree/issues/16608/reactions"},"repository_url":"https://api.github.com/repos/iree-org/iree","state":"open","state_reason":null,"sub_issues_summary":{"completed":0,"percent_completed":0,"total":0},"timeline_url":"https://api.github.com/repos/iree-org/iree/issues/16608/timeline","title":"ubsan load/store misaligned address errors from memory_stream_test and gguf_parser_test","type":null,"updated_at":"2024-02-29T02:56:54Z","url":"https://api.github.com/repos/iree-org/iree/issues/16608","user":{"avatar_url":"https://avatars.githubusercontent.com/u/21227477?v=4","events_url":"https://api.github.com/users/yuennancy/events{/privacy}","followers_url":"https://api.github.c