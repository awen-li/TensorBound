08?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2025-06-23T12:02:40Z","event":"labeled","id":18272315884,"intent":null,"label":{"color":"d73a4a","name":"bug"},"node_id":"LE_lADOCTkjjc680uZWzwAAAARBHWns","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/18272315884"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"author_association":"COLLABORATOR","body":"Yes, seems reasonable to interpret single-device axis as replicated but that would require systemic changes throughout the sharding-in-types system.\n\nOne thing I worry about though is that if you change the axis-size of the mesh, the same program will just stop working. Is that okay? It also makes some decisions in sharding rules like reshape a bit complicated.\n\nWhy can't you just do `(None, None, None)`?","created_at":"2025-06-23T13:17:54Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29647#issuecomment-2996472696","id":2996472696,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29647","minimized":null,"node_id":"IC_kwDOCTkjjc6ymot4","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2996472696/reactions"},"updated_at":"2025-06-23T13:17:54Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2996472696","user":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"},"author_association":"CONTRIBUTOR","body":"I wrote a wrapper of `jax.lax.map` that supports having the axis-0 sharded (see https://gist.github.com/PhilipVinc/f789421a5fcba02cc4211748ee2db3ee ) and I am writing a set of tests for it.\n\nThe way it works is that it reshapes the inputs XS from `f[N@S, ...]` to `f[N/d, d@S, ...]` (d number of devices on the axis S).\nThe way I do this is to reshape then transpose as follows: `f[N@S, ...] reshape-> f[d@S, N/d, ...] transpose-> f[N/d, d@S, ...]`.\n(See also the code below).\n\nThis works fine if there is n>2 devices along that axis, but when there is a single device the behaviour is completely different and the same order of reshapes and transposes yields `f[N@S, 1, ...]`. \nTrying to `reshard` to get `f[N, 1@S, ...]` then hits other issues in `jax.lax.map` which will insert the sharded axis in the wrong place...\n\n\nIf you have a suggestion on how to implement this in a better way, I'd be open to suggestions.\n\n```python\n        specs0 = [s.spec[0] for s in xs_shardings]\n        axis_name = specs0[0]\n        n_devs = xs_shardings[0].mesh.shape[axis_name]\n\n        def peel_and_move(leaf, sh):\n            # leaf.shape = (B, *rest), where B = n_devs * local_batch\n            local_shape = sh.shard_shape(leaf.shape)\n\n            # first reshape → (n_devs, local_batch, *rest)\n            y = jnp.reshape(leaf, (n_devs,) + tuple(local_shape))\n            # then bring the local_batch in front → (local_batch, n_devs, *rest)\n            y = jnp.transpose(y, (1, 0) + tuple(range(2, y.ndim)))\n            return y\n\n        # apply to every leaf\n        xs_peeled = [peel_and_move(leaf, sh) for leaf, sh in zip(xs_flat, xs_shardings)]\n```\n","created_at":"2025-06-23T13:29:19Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29647#issuecomment-2996511139","id":2996511139,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29647","minimized":null,"node_id":"IC_kwDOCTkjjc6ymyGj","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2996511139/reactions"},"updated_at":"2025-06-23T13:29:19Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2996511139","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"},"author_association":"CONTRIBUTOR","body":"> One thing I worry about though is that if you change the axis-size of the mesh, the same program will just stop working. Is that okay? It also makes some decisions in sharding rules like reshape a bit complicated.\n\nI now understand better what you meant.\nIn principle I would be ok with treating 1-device axis as not replicated, but things must be consistent.\nIf you look at the example below, you will see that rank-1 axes are treated differently in different cases.\n\n```python\nimport jax\nimport jax.numpy as jnp\nfrom jax.sharding import PartitionSpec as P, AxisType\nfrom jax.experimental.shard import reshard\n\njax.config.update('jax_num_cpu_devices', 2)\n\n\ndef fun(mesh):\n    jax.sharding.set_mesh(mesh)\n    n_dev = mesh.axis_sizes[0]\n    print(\"Mesh:\", mesh)\n    x = jnp.ones((8, 4))\n    x = reshard(x, P('s'))\n    y = jnp.reshape(x, (8//n_dev, n_dev, 4))\n    z = jnp.transpose(y, (1, 0, 2))\n    xt, yt, zt = jax.tree.map(jax.typeof, (x, y, z))\n    print(f\"{xt} -> {yt} -> {zt}\")\n\n\nmesh = jax.make_mesh((2, ), ('s', ), axis_types=(AxisType.Explicit,))\nfun(mesh)\n# Mesh: Mesh('s': 2, axis_types=(Explicit,))\n# float32[8@s,4] -> float32[4@s,2,4] -> float32[2,4@s,4]\n\nmesh = jax.make_mesh((1, ), ('s', ), axis_types=(AxisType.Explicit,))\nfun(mesh)\n# Mesh: Mesh('s': 1, axis_types=(Explicit,))\n# float32[8@s,4] -> float32[8,1,4] -> float32[1,8,4]\n\nmesh = jax.make_mesh((1, 2), ('s','p'), axis_types=(AxisType.Explicit,AxisType.Explicit))\nfun(mesh)\n# Mesh: Mesh('s': 1, 'p': 2, axis_types=(Explicit, Explicit))\n# float32[8@s,4] -> float32[8@s,1,4] -> float32[1,8@s,4]\n```","created_at":"2025-06-23T16:16:21Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29647#issuecomment-2997094313","id":2997094313,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29647","minimized":null,"node_id":"IC_kwDOCTkjjc6ypAep","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997094313/reactions"},"updated_at":"2025-06-23T16:16:21Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997094313","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"author_association":"COLLABORATOR","body":"Yeah I agree that it should be consistent. The second case seems to be dropping `@s` when you split. I'll fix that.","created_at":"2025-06-23T16:56:20Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29647#issuecomment-2997204262","id":2997204262,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29647","minimized":null,"node_id":"IC_kwDOCTkjjc6ypbUm","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997204262/reactions"},"updated_at":"2025-06-23T16:56:20Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997204262","user":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"},"author_association":"CONTRIBUTOR","body":"Yes, thanks.\nBut I just realised the example I want to bring forth was different. \nLook at the example below. In those two 'equivalent' code paths, the axis being reported as sharded differs.\nIf it was the same it would be easier to handle.\n\n```python\ndef fun(mesh):\n    jax.sharding.set_mesh(mesh)\n    n_dev = mesh.axis_sizes[0]\n    print(\"Mesh:\", mesh)\n    x = jnp.ones((8, 4))\n    x = reshard(x, P('s'))\n    y = jnp.reshape(x, (n_dev, 8//n_dev, 4))\n    xt, yt = jax.tree.map(jax.typeof, (x, y))\n    print(f\"{xt} -> {yt}\")\n\n\nmesh = jax.make_mesh((2, ), ('s', ), axis_types=(AxisType.Explicit,))\nfun(mesh)\n# Mesh: Mesh('s': 2, axis_types=(Explicit,))\n# float32[8@s,4] -> float32[2@s,4,4]\n\nmesh = jax.make_mesh((1, 2), ('s','p'), axis_types=(AxisType.Explicit,AxisType.Explicit))\nfun(mesh)\n# Mesh: Mesh('s': 1, 'p': 2, axis_types=(Explicit, Explicit))\n# float32[8@s,4] -> float32[1,8@s,4]\n```","created_at":"2025-06-23T17:04:28Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29647#issuecomment-2997225819","id":2997225819,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29647","minimized":null,"node_id":"IC_kwDOCTkjjc6ypglb","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997225819/reactions"},"updated_at":"2025-06-23T17:16:13Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997225819","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/privacy}","followers_url":"https://api.github.com/users/PhilipVinc/followers","following_url":"https://api.github.com/users/PhilipVinc/following{/other_user}","gists_url":"https://api.github.com/users/PhilipVinc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/PhilipVinc","id":2407108,"login":"PhilipVinc","node_id":"MDQ6VXNlcjI0MDcxMDg=","organizations_url":"https://api.github.com/users/PhilipVinc/orgs","received_events_url":"https://api.github.com/users/PhilipVinc/received_events","repos_url":"https://api.github.com/users/PhilipVinc/repos","site_admin":false,"starred_url":"https://api.github.com/users/PhilipVinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhilipVinc/subscriptions","type":"User","url":"https://api.github.com/users/PhilipVinc","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"},"author_association":"COLLABORATOR","body":"I think these 2 cases are different.\n\nThe second one can be considered as adding a singleton dimension to an existing shape. So you don't really need to assign a sharding to the singleton dim and just carry forward the current sharded dims.\n\nWhile the first one is actually splitting a dim instead of adding a singleton dim.\n\nI can see how this is confusing though. Let me think on it a bit on how we can make this more consistent.","created_at":"2025-06-23T17:16:59Z","event":"commented","html_url":"https://github.com/jax-ml/jax/issues/29647#issuecomment-2997256575","id":2997256575,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/29647","minimized":null,"node_id":"IC_kwDOCTkjjc6ypoF_","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997256575/reactions"},"updated_at":"2025-06-23T17:16:59Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/2997256575","user":{"avatar_url":"https://avatars.githubusercontent.com/u/14262417?v=4","events_url":"https://api.github.com/users/yashk2810/events{/privacy}","followers_url":"https://api.github.com/users/yashk2810/followers","following_url":"https://api.github.com/users/yashk2810/following{/other_user}","gists_url":"https://api.github.com/users/yashk2810/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/yashk2810","id":14262417,"login":"yashk2810","node_id":"MDQ6VXNlcjE0MjYyNDE3","organizations_url":"https://api.github.com/users/yashk2810/orgs","received_events_url":"https://api.github.com/users/yashk2810/received_events","repos_url":"https://api.github.com/users/yashk2810/repos","site_admin":false,"starred_url":"https://api.github.com/users/yashk2810/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yashk2810/subscriptions","type":"User","url":"https://api.github.com/users/yashk2810","user_view_type":"public"}},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/2407108?v=4","events_url":"https://api.github.com/users/PhilipVinc/events{/pr