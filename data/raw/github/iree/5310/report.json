64>}} : (tensor<7x2x6xf32>, tensor<7x6x2xf32>) -> tensor<7x2x2xf32>\r\n    %19 = \"mhlo.transpose\"(%18) {permutation = dense<[1, 0, 2]> : tensor<3xi64>} : (tensor<7x2x2xf32>) -> tensor<2x7x2xf32>\r\n    %20 = flow.variable.load.indirect %1 : !iree.ptr<tensor<7x2xf32>> -> tensor<7x2xf32>\r\n    %21 = \"mhlo.reshape\"(%20) : (tensor<7x2xf32>) -> tensor<1x7x2xf32>\r\n    %22 = \"mhlo.broadcast_in_dim\"(%21) {broadcast_dimensions = dense<[0, 1, 2]> : tensor<3xi64>} : (tensor<1x7x2xf32>) -> tensor<2x7x2xf32>\r\n    %23 = mhlo.add %19, %22 : tensor<2x7x2xf32>\r\n    return %23 : tensor<2x7x2xf32>\r\n  }\r\n}\r\n```\r\n\r\nRun `iree-translate --iree-mlir-to-vm-bytecode-module --iree-hal-target-backends=vulkan-spirv -iree-flow-dispatch-linalg-on-tensors=true -iree-codegen-spirv-experimental-linalg-on-tensors=true LocallyConnected1D.mlir`","closed_at":"2021-04-27T17:07:21Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/1663364?v=4","events_url":"https://api.github.com/users/MaheshRavishankar/events{/privacy}","followers_url":"https://api.github.com/users/MaheshRavishankar/followers","following_url":"https://api.github.com/users/MaheshRavishankar/following{/other_user}","gists_url":"https://api.github.com/users/MaheshRavishankar/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/MaheshRavishankar","id":1663364,"login":"MaheshRavishankar","node_id":"MDQ6VXNlcjE2NjMzNjQ=","organizations_url":"https://api.github.com/users/MaheshRavishankar/orgs","received_events_url":"https://api.github.com/users/MaheshRavishankar/received_events","repos_url":"https://api.github.com/users/MaheshRavishankar/repos","site_admin":false,"starred_url":"https://api.github.com/users/MaheshRavishankar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaheshRavishankar/subscriptions","type":"User","url":"https://api.github.com/users/MaheshRavishankar","user_view_type":"public"},"comments":3,"comments_url":"https://api.github.com/repos/iree-org/ir