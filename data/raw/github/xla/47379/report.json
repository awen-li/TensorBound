/received_events","repos_url":"https://api.github.com/users/openxla/repos","site_admin":false,"starred_url":"https://api.github.com/users/openxla/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openxla/subscriptions","type":"Organization","url":"https://api.github.com/users/openxla","user_view_type":"public"},"permissions":{"admin":false,"maintain":false,"pull":true,"push":false,"triage":false},"private":false,"pull_request_creation_policy":"all","pulls_url":"https://api.github.com/repos/openxla/xla/pulls{/number}","pushed_at":"2026-09-27T21:18:39Z","releases_url":"https://api.github.com/repos/openxla/xla/releases{/id}","size":420572,"ssh_url":"git@github.com:openxla/xla.git","stargazers_count":4564,"stargazers_url":"https://api.github.com/repos/openxla/xla/stargazers","statuses_url":"https://api.github.com/repos/openxla/xla/statuses/{sha}","subscribers_url":"https://api.github.com/repos/openxla/xla/subscribers","subscription_url":"https://api.github.com/repos/openxla/xla/subscription","svn_url":"https://github.com/openxla/xla","tags_url":"https://api.github.com/repos/openxla/xla/tags","teams_url":"https://api.github.com/repos/openxla/xla/teams","topics":[],"trees_url":"https://api.github.com/repos/openxla/xla/git/trees{/sha}","updated_at":"2026-09-27T19:54:17Z","url":"https://api.github.com/repos/openxla/xla","visibility":"public","watchers":4564,"watchers_count":4564,"web_commit_signoff_required":false},"repository_url":"https://api.github.com/repos/openxla/xla","state":"closed","state_reason":null,"timeline_url":"https://api.github.com/repos/openxla/xla/issues/47804/timeline","title":"[PJRT:CPU] Support dynamic-shaped literals in BufferFromHostLiteral","type":null,"updated_at":"2026-09-19T17:54:06Z","url":"https://api.github.com/repos/openxla/xla/issues/47804","user":{"avatar_url":"https://avatars.githubusercontent.com/u/6258615?v=4","events_url":"https://api.github.com/users/kodlan/events{/privacy}","followers_url":"https://api.github.com/users/kodlan/followers","following_url":"https://api.github.com/users/kodlan/following{/other_user}","gists_url":"https://api.github.com/users/kodlan/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/kodlan","id":6258615,"login":"kodlan","node_id":"MDQ6VXNlcjYyNTg2MTU=","organizations_url":"https://api.github.com/users/kodlan/orgs","received_events_url":"https://api.github.com/users/kodlan/received_events","repos_url":"https://api.github.com/users/kodlan/repos","site_admin":false,"starred_url":"https://api.github.com/users/kodlan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kodlan/subscriptions","type":"User","url":"https://api.github.com/users/kodlan","user_view_type":"public"}},"type":"issue"},"updated_at":"2026-08-24T20:41:14Z"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/6258615?v=4","events_url":"https://api.github.com/users/kodlan/events{/privacy}","followers_url":"https://api.github.com/users/kodlan/followers","following_url":"https://api.github.com/users/kodlan/following{/other_user}","gists_url":"https://api.github.com/users/kodlan/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/kodlan","id":6258615,"login":"kodlan","node_id":"MDQ6VXNlcjYyNTg2MTU=","organizations_url":"https://api.github.com/users/kodlan/orgs","received_events_url":"https://api.github.com/users/kodlan/received_events","repos_url":"https://api.github.com/users/kodlan/repos","site_admin":false,"starred_url":"https://api.github.com/users/kodlan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kodlan/subscriptions","type":"User","url":"https://api.github.com/users/kodlan","user_view_type":"public"},"created_at":"2026-08-24T21:06:51Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"CONTRIBUTOR","body":"## 📝 Summary of Changes\r\n\r\nFollow-up to PR #47804  for issue #47379.\r\n\r\n`MakeFakeLiteral` constructs dynamic-shaped literals without ever setting\r\ntheir dynamic-dimension sizes, and literal construction leaves those metadata\r\nslots uninitialized - so every fake argument generated for a dynamic-shaped\r\nparameter (e.g. by `run_hlo_module`) carries an uninitialized-memory \"runtime\r\nsize\" (values like -1969319720 observed). Depending on what the garbage\r\nhappens to be, the same module then runs, produces nonsense, or crashes: at\r\ncurrent HEAD the module from #47379 segfaults on GPU during the host-to-device\r\ntransfer because the garbage size drives the linearization transpose out of\r\nbounds, and the Interpreter silently carries the garbage size.\r\n\r\nTwo changes:\r\n\r\n- `MakeFakeLiteral` now initializes every dynamic dimension's size to its\r\n  bound (in both the random and the non-random paths), so generated literals\r\n  are always well-formed.\r\n- `CommonPjRtClient::Linearize` now rejects a dynamic size above its\r\n  dimension bound with `InvalidArgument` before writing anything. The sizes\r\n  arrive as `uint32`, so negative garbage from corrupted literals is caught\r\n  by the same comparison. This turns what was an unchecked out-of-bounds\r\n  write into a clean error on every platform that uses the common\r\n  linearization path.\r\n\r\nWith this change alone, the module from #47379 runs cleanly on the\r\nInterpreter and on GPU with a well-formed input (the remaining CPU crash is\r\nthe separate transfer defect fixed by #47804; with both changes, CPU, GPU,\r\nand Interpreter all agree on the output).\r\n\r\n## 🎯 Justification\r\n\r\nFuzzed and test-generated modules with bounded-dynamic parameters currently\r\nexercise undefined behavior on every platform, which makes crash reports\r\nagainst dynamic shapes hard to trust (platform-dependent, run-dependent). A\r\ngenerated argument must be in-contract, and the transfer layer must not turn\r\na corrupted size into memory corruption.\r\n\r\n## 🚀 Kind of Contribution\r\n\r\n- 🐛 Bug Fix\r\n\r\n## 🧪 Unit Tests:\r\n\r\n`LiteralUtilTest.MakeFakeLiteralInitializesDynamicSizes`: a `f32[2,<=10]`\r\nfake literal reports dynamic size 10 through both the seeded and the\r\nnon-random overloads, and a token shape passes through untouched. Note the\r\n\"fails before\" property of this test is probabilistic in a plain build (it\r\nreads uninitialized memory before the fix; deterministic under MSan) - it\r\nfailed in the observed runs.\r\n`PjRtCpuClientTest.LinearizeRejectsOutOfBoundDynamicSize`: calling\r\n`Linearize` with a dynamic size of 11 for `f32[<=10]` returns\r\n`InvalidArgument` instead of writing out of bounds (fails before the fix);\r\na size equal to the bound and a mixed static/dynamic shape are accepted.\r\nSuites: `//xla:literal_test`, `//xla/pjrt/cpu:cpu_client_test`,\r\n`//xla/tests:test_utils_test` all pass.\r\n\r\nNote: this PR touches the same test file region as #47804, so whichever\r\nlands second needs a trivial rebase (keep both tests).\r\n\r\n## 🧪 Execution Tests:\r\n\r\nThe #47379 module under `run_hlo_module` (StableHLO input): before, GPU\r\nSIGSEGV and Interpreter ran with a garbage input size; with this change both\r\nrun cleanly with input `f32[<=10](10)` and agree on the result.","closed_at":null,"comments":0,"comments_url":"https://api.github.com/repos/openxla/xla/issues/47805/comments","created_at":"2026-08-24T21:06:50Z","draft":false,"events_url":"https://api.github.com/repos/openxla/xla/issues/47805/events","html_url":"https://github.com/openxla/xla/pull/47805","id":5239444566,"issue_field_values":[],"labels":[],"labels_url":"https://api.github.com/repos/openxla/xla/issues/47805/labels{/name}","locked":false,"milestone":null,"node_id":"PR_kwDOHyx1PM8AAAABA2xAUg","number":47805,"performed_via_github_app":null,"pull_request":{"diff_url":"https://github.com/openxla/xla/pull/47805.diff","html_url":"https://github.com/openxla/xla/pull/47805","merged_at":null,"patch_url":"https://github.com/openxla/xla/pull/47805.patch","url":"https://api.github.com/repos/openxla/xla/pulls/47805"},"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/openxla/xla/issues/47805/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/openxla/xla/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/openxla/xla/assignees{/user}","blobs_url":"https://api.github.com/repos/openxla/xla/git/blobs{/sha}","branches_url":"https://api.github.com/repos/openxla/xla/branches{/branch}","clone_url":"https://github.com/openxla/xla.git","collaborators_url":"https://api.github.com/repos/openxla/xla/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/openxla/xla/comments{/number}","commits_url":"https://api.github.com/repos/openxla/xla/commits{/sha}","compare_url":"https://api.github.com/repos/openxla/xla/compare/{base}...{head}","contents_url":"https://api.github.com/repos/openxla/xla/contents/{+path}","contributors_url":"https://api.github.com/repos/openxla/xla/contributors","created_at":"2022-08-09T15:30:01Z","default_branch":"main","deployments_url":"https://api.github.com/repos/openxla/xla/deployments","description":"A machine learning compiler for GPUs, CPUs, and ML accelerators","disabled":false,"downloads_url":"https://api.github.com/repos/openxla/xla/downloads","events_url":"https://api.github.com/repos/openxla/xla/events","fork":false,"forks":952,"forks_count":952,"forks_url":"https://api.github.com/repos/openxla/xla/forks","full_name":"openxla/xla","git_commits_url":"https://api.github.com/repos/openxla/xla/git/commits{/sha}","git_refs_url":"https://api.github.com/repos/openxla/xla/git/refs{/sha}","git_tags_url":"https://api.github.com/repos/openxla/xla/git/tags{/sha}","git_url":"git://github.com/openxla/xla.git","has_discussions":true,"has_downloads":false,"has_issues":true,"has_pages":false,"has_projects":true,"has_pull_requests":true,"has_wiki":fals