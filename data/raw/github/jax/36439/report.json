int(f\"y sharding: {y.sharding}\")\nprint(f\"y sum: {y.sum()}\")\n```\nwhich results in the error\n```python\nJaxRuntimeError                           Traceback (most recent call last)\nCell In[1], line 22\n     20 print(f\"x sharding: {x.sharding}\")\n     21 print(f\"y sharding: {y.sharding}\")\n---> 22 print(f\"y sum: {y.sum()}\")\n\nFile ~/conda/miniconda3/envs/py312/lib/python3.12/site-packages/jax/_src/array.py:333, in ArrayImpl.__format__(self, format_spec)\n    329   return repr(self)\n    330 elif (self.is_fully_addressable or self.is_fully_replicated and\n    331       self.sharding.has_addressable_devices):\n    332   # Simulates behavior of https://github.com/numpy/numpy/pull/9883\n--> 333   return format(self._value if self.ndim else self._value[()], format_spec)\n    334 else:\n    335   return repr(self)\n\nFile ~/conda/miniconda3/envs/py312/lib/python3.12/site-packages/jax/_src/profiler.py:384, in annotate_function.<locals>.wrapper(*args, **kwargs)\n    381 @wraps(func)\n    382 def wrapper(*args, **kwargs):\n    383   with TraceAnnotation(name, **decorator_kwargs):\n--> 384     return func(*args, **kwargs)\n\nFile ~/conda/miniconda3/envs/py312/lib/python3.12/site-packages/jax/_src/array.py:641, in ArrayImpl._value(self)\n    638 if self._npy_value is None:\n    639   # addressable_device_list can be empty. If it's empty, we will error below\n    640   if self.is_fully_replicated and self.sharding.has_addressable_devices:\n--> 641     npy_value, did_copy = self._single_device_array_to_np_array_did_copy()\n    642     npy_value.flags.writeable = False\n    643     if did_copy:\n\nJaxRuntimeError: INTERNAL: NCCL operation ncclAlltoAll( send_contiguous->opaque(), recv_contiguous->opaque(), ToNcclCount(dtype, count), nccl_dtype, comm_, AsCudaStream(stream)) failed: unhandled system error (run with NCCL_DEBUG=INFO for details). Last NCCL warning(error) log entry (may be unrelated) ''.\n```\n\n\n\n### System info (python version, jaxlib version, accelerat