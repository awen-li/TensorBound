=1, process_index=1), GpuDevice(id=2, process_index=2), GpuDevice(id=3, process_index=3), GpuDevice(id=4, process_index=4), GpuDevice(id=5, process_index=5), GpuDevice(id=6, process_index=6), GpuDevice(id=7, process_index=7)]\r\n\r\n#Run 2: \r\nDevice count: 8, Local device count: 1, Devices: [GpuDevice(id=0, process_index=0), GpuDevice(id=1, process_index=1), GpuDevice(id=2, process_index=2), GpuDevice(id=3, process_index=3), GpuDevice(id=4, process_index=4), GpuDevice(id=5, process_index=5), GpuDevice(id=6, process_index=6), GpuDevice(id=7, process_index=7)]\r\n```\r\nThanks folks! :) ","created_at":"2022-09-30T20:30:28Z","html_url":"https://github.com/jax-ml/jax/issues/12570#issuecomment-1263995537","id":1263995537,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/12570","minimized":null,"node_id":"IC_kwDOCTkjjc5LVwqR","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1263995537/reactions"},"updated_at":"2022-09-30T20:30:28Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1263995537","user":{"avatar_url":"https://avatars.githubusercontent.com/u/4879686?v=4","events_url":"https://api.github.com/users/sudhakarsingh27/events{/privacy}","followers_url":"https://api.github.com/users/sudhakarsingh27/followers","following_url":"https://api.github.com/users/sudhakarsingh27/following{/other_user}","gists_url":"https://api.github.com/users/sudhakarsingh27/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sudhakarsingh27","id":4879686,"login":"sudhakarsingh27","node_id":"MDQ6VXNlcjQ4Nzk2ODY=","organizations_url":"https://api.github.com/users/sudhakarsingh27/orgs","received_events_url":"https://api.github.com/users/sudhakarsingh27/received_events","repos_url":"https://api.github.com/users/sudhakarsingh27/repos","site_admin":false,"starred_url":"https://api.github.com/users/sudhakarsingh27/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sudhakarsingh27/subscriptions","type":"User","url":"https://api.github.com/users/sudhakarsingh27","user_view_type":"public"}},{"author_association":"COLLABORATOR","body":"> @sudhakarsingh27 id should be stable, how do you intend to use process_index ?\r\n\r\n@zhangqiaorjc There was some confusion when we're looking at how shards are assigned to GPUs with GDAs since the process-GPU mapping was random (so to fix that, we need to do pass the mesh of devices sorted by their GPU ids instead of `process_index`).\r\n\r\nThe other potential problem is that if process-GPU mapping is random, then it's possible that some array might get sharded across hosts (nodes) instead of within the node. Having deterministic 1:1 mapping might prevent that from happening? ","created_at":"2022-09-30T20:35:22Z","html_url":"https://github.com/jax-ml/jax/issues/12570#issuecomment-1263999876","id":1263999876,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/12570","minimized":null,"node_id":"IC_kwDOCTkjjc5LVxuE","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1263999876/reactions"},"updated_at":"2022-09-30T20:35:38Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/1263999876","user":{"avatar_url":"https://avatars.githubusercontent.com/u/4879686?v=4","events_url":"https://api.github.com/users/sudhakarsingh27/events{/privacy}","followers_url":"https://api.github.com/users/sudhakarsingh27/followers","following_url":"https://api.github.com/users/sudhakarsingh27/following{/other_user}","gists_url":"https://api.github.com/users/sudhakarsingh27/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sudhakarsingh27","id":4879686,"login":"sudhakarsingh27","node_id":"MDQ6VXNlcjQ4Nzk2ODY=","organizations_url":"https://api.github.com/users/sudhakarsingh27/orgs","received_events_url":"https://api.github.com/users/sudhakarsingh27/received_events","repos_url":"https://api.github.com/users/sudhakarsingh27/repos","site_admin":false,"starred_url":"https://api.github.com/users/sudhakarsingh27/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sudhakarsingh27/subscriptions","type":"User","url":"https://api.github.com/users/sudhakarsingh27","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"COLLABORATOR","body":"### Description\r\n\r\nWhen processes are launched with 1 GPU per process config, the Process-GPU mapping after `jax.distributed.initialize()` is not 1:1 and secondly it's random. \r\n\r\nInstructions to repro issue: https://gist.github.com/sudhakarsingh27/e2d38a82d390945801ebde4ed3aa91cc\r\n\r\nExample output across runs:\r\n```\r\n# Run 1\r\nDevice count: 8, Local device count: 1, Devices: [GpuDevice(id=0, process_index=3), GpuDevice(id=1, process_index=6), GpuDevice(id=2, process_index=0), GpuDevice(id=3, process_index=5), GpuDevice(id=4, process_index=2), GpuDevice(id=5, process_index=1), GpuDevice(id=6, process_index=4), GpuDevice(id=7, process_index=7)]\r\n\r\n# Run 2\r\nDevice count: 8, Local device count: 1, Devices: [GpuDevice(id=0, process_index=0), GpuDevice(id=1, process_index=1), GpuDevice(id=2, process_index=7), GpuDevice(id=3, process_index=6), GpuDevice(id=4, process_index=5), GpuDevice(id=5, process_index=2), GpuDevice(id=6, process_index=3), GpuDevice(id=7, process_index=4)]\r\n\r\n# Run 3\r\nDevice count: 8, Local device count: 1, Devices: [GpuDevice(id=0, process_index=6), GpuDevice(id=1, process_index=3), GpuDevice(id=2, process_index=2), GpuDevice(id=3, process_index=0), GpuDevice(id=4, process_index=4), GpuDevice(id=5, process_index=7), GpuDevice(id=6, process_index=1), GpuDevice(id=7, process_index=5)]\r\n\r\n```\r\n\r\n### What jax/jaxlib version are you using?\r\n\r\njax 0.3.20, jaxlib 0.3.20+cuda11.cudnn82\r\n\r\n### Which accelerator(s) are you using?\r\n\r\nGPU\r\n\r\n### Additional system info\r\n\r\nLinux\r\n\r\n### NVIDIA GPU info\r\n\r\n```\r\n+-----------------------------------------------------------------------------+\r\n| NVIDIA-SMI 510.47.03    Driver Version: 510.47.03    CUDA Version: 11.6     |\r\n|-------------------------------+----------------------+----------------------+\r\n| GPU  Name        Persistence-M| Bus-Id        Disp.A | Volatile Uncorr. ECC |\r\n| Fan  Temp  Perf  Pwr:Usage/Cap|         Memory-Usage | GPU-Util  Compute M. |\r\n|                               |                      |               MIG M. |\r\n|===============================+======================+======================|\r\n|   0  NVIDIA A100-SXM...  On   | 00000000:0F:00.0 Off |                    0 |\r\n| N/A   36C    P0    59W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   1  NVIDIA A100-SXM...  On   | 00000000:15:00.0 Off |                    0 |\r\n| N/A   35C    P0    57W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   2  NVIDIA A100-SXM...  On   | 00000000:51:00.0 Off |                    0 |\r\n| N/A   35C    P0    57W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   3  NVIDIA A100-SXM...  On   | 00000000:54:00.0 Off |                    0 |\r\n| N/A   35C    P0    57W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   4  NVIDIA A100-SXM...  On   | 00000000:8D:00.0 Off |                    0 |\r\n| N/A   34C    P0    56W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   5  NVIDIA A100-SXM...  On   | 00000000:92:00.0 Off |                    0 |\r\n| N/A   34C    P0    58W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   6  NVIDIA A100-SXM...  On   | 00000000:D6:00.0 Off |                    0 |\r\n| N/A   33C    P0    59W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n|   7  NVIDIA A100-SXM...  On   | 00000000:DA:00.0 Off |                    0 |\r\n| N/A   35C    P0    52W / 400W |      0MiB / 40960MiB |      0%      Default |\r\n|                               |                      |             Disabled |\r\n+-------------------------------+----------------------+----------------------+\r\n\r\n```","closed_at":"2022-09-30T20:30:28Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/4879686?v=4","events_url":"https://api.github.com/users/sudhakarsingh27/events{/privacy}","followers_url":"https://api.github.com/users/sudhakarsingh27/followers","following_url":"https://api.github.com/users/sudhakarsingh27/following{/other_user}","gists_url":"https://api.github.com/users/sudhakarsingh27/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sudhakarsingh27","id":4879686,"login":"sudhakarsingh27","node_id":"MDQ6VXNlcjQ4Nzk2ODY=","organiz