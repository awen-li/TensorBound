vdp/repos","site_admin":false,"starred_url":"https://api.github.com/users/jakevdp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jakevdp/subscriptions","type":"User","url":"https://api.github.com/users/jakevdp","user_view_type":"public"},"commit_id":null,"commit_url":null,"created_at":"2026-05-18T22:41:31Z","event":"assigned","id":25680447487,"intent":null,"node_id":"AE_lADOCTkjjc8AAAABCpT79M8AAAAF-qyH_w","performed_via_github_app":null,"url":"https://api.github.com/repos/jax-ml/jax/issues/events/25680447487"},{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/53819558?v=4","events_url":"https://api.github.com/users/lihe07/events{/privacy}","followers_url":"https://api.github.com/users/lihe07/followers","following_url":"https://api.github.com/users/lihe07/following{/other_user}","gists_url":"https://api.github.com/users/lihe07/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/lihe07","id":53819558,"login":"lihe07","node_id":"MDQ6VXNlcjUzODE5NTU4","organizations_url":"https://api.github.com/users/lihe07/orgs","received_events_url":"https://api.github.com/users/lihe07/received_events","repos_url":"https://api.github.com/users/lihe07/repos","site_admin":false,"starred_url":"https://api.github.com/users/lihe07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lihe07/subscriptions","type":"User","url":"https://api.github.com/users/lihe07","user_view_type":"public"},"created_at":"2026-08-11T18:46:57Z","event":"cross-referenced","source":{"issue":{"active_lock_reason":null,"assignee":null,"assignees":[],"author_association":"NONE","body":"### Description\n\n`jax.nn.silu` appears to return an incorrect zero gradient for a large negative finite `float64` input.\n\nFor SiLU / Swish,\n\n```\nsilu(x) = x * sigmoid(x)\n```\n\nIts derivative is:\n\n```\nsilu'(x) = sigmoid(x) + x * sigmoid(x) * (1 - sigmoid(x))\n```\n\nAt `x = -709.0`, the true derivative is approximately `-8.614807714413836e-306`, which is finite and representable in `float64`. However, JAX returns `0.0`.\n\n### Minimal reproducible example\n\n```\n#!/usr/bin/env python3\nimport os\nimport sys\nimport math\n\nos.environ.setdefault(\"CUDA_VISIBLE_DEVICES\", \"-1\")\nos.environ.setdefault(\"JAX_PLATFORMS\", \"cpu\")\nos.environ.setdefault(\"TF_CPP_MIN_LOG_LEVEL\", \"3\")\n\ntry:\n    import jax\n    import jax.numpy as jnp\nexcept ImportError as e:\n    print(f\"missing dep: {e}\")\n    sys.exit(2)\n\njax.config.update(\"jax_enable_x64\", True)\n\nx = -709.0\nexpected = -8.614807714413836e-306\n\nout = float(jax.grad(lambda z: jax.nn.silu(z))(jnp.asarray(x, dtype=jnp.float64)))\n\nprint(\"jax:\", out)\nprint(\"expected:\", expected)\n\nif not (math.isfinite(out) and abs(out - expected) <= 1e-6 * abs(expected)):\n    sys.exit(0)\nsys.exit(1)\n```\n\n### Actual result\n\n```\njax: 0.0\nexpected: -8.614807714413836e-306\n```\n\n### Expected result\n\n```\n-8.614807714413836e-306\n```\n\nThe expected derivative is finite and representable in `float64`. JAX instead returns `0.0`, suggesting that the backward pass flushes or loses the tiny but nonzero derivative for large negative inputs.\n\n### System info (python version, jaxlib version, accelerator, etc.)\n\njax: 0.10.1\njaxlib: 0.10.1\nnumpy: 2.4.6\npython: 3.13.13\nplatform: Ubuntu 24.04.3 LTS, Linux x86_64\naccelerator: CPU backend\n\nNote: GPU is present, but CUDA-enabled jaxlib is not installed, so JAX falls back to CPU.","closed_at":null,"comments":3,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/39798/comments","created_at":"2026-08-06T22:06:35Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/39798/events","html_url":"https://github.com/jax-ml/jax/issues/39798","id":5085044415,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/39798/labels{/name}","locked":false,"milestone":null,"node_id":"I_kwDOCTkjjc8AAAABLxeevw","number":39798,"performed_via_github_app":null,"pinned_comment":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/39798/reactions"},"repository":{"allow_forking":true,"archive_url":"https://api.github.com/repos/jax-ml/jax/{archive_format}{/ref}","archived":false,"assignees_url":"https://api.github.com/repos/jax-ml/jax/assignees{/user}","blobs_url":"https://api.github.com/repos/jax-ml/jax/git/blobs{/sha}","branches_url":"https://api.github.com/repos/jax-ml/jax/branches{/branch}","clone_url":"https://github.com/jax-ml/jax.git","collaborators_url":"https://api.github.com/repos/jax-ml/jax/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/jax-ml/jax/comments{/number}","commits_url":"https://api.github.com/repos/jax-ml/jax/commits{/sha}","compare_url":"https://api.github.com/repos/jax-ml/jax/compare/{base}...{head}","contents_url":"https://api.github.com/repos/jax-ml/jax/contents/{+path}","contributors_url":"https://api.github.com/repos/jax-ml/jax/contributors","created_at":"2018-10-25T21:25:02Z","default_branch":"main","deployments_url":"https://api.github.com/repos/jax-ml/jax/deployments","description":"Composable transformations of Python+NumPy programs: differentiate, vectorize, JIT to GPU/TPU, and more","disabled":false,"downloads_url":"https://api.github.com/repos/jax-ml/jax/downloads","events_url":"https://api.github.com/repos/jax-ml/jax/events","fork":false,"forks":3814,"forks_count":3814,"forks_url":"https://api.github.com/repos/jax-ml/jax/forks","full_name":"jax-ml/jax","git_commits_url":"https://api.github.com/repos/jax-ml/jax/git/commits{/sha}","g