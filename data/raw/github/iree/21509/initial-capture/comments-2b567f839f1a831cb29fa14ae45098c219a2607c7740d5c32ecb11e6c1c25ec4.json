p4_2.vmfb \\\n    --device=hip://0 \\\n    --function=mm_repro \\\n    --input=@repro_input.npy \\\n    --input=@weight.npy \\\n    --output=@repro_output_1.npy\n```\n\nwith `repro_input.npy` same as above and `weight.npy` created by \n\n```\n>>> import numpy as np\n>>> weight = np.random.rand(128256, 16384).astype('float16')\n>>> np.save(\"weight.npy\", weight)\n```\n\nRunning the command many times produces different result everytime.\n\nAlso these tensors are greater than 2GB. Hope it isnt some 32-bit indexing issue.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3129540370/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/iree-org/iree/issues/comments/3129882492","html_url":"https://github.com/iree-org/iree/issues/21509#issuecomment-3129882492","issue_url":"https://api.github.com/repos/iree-org/iree/issues/21509","id":3129882492,"node_id":"IC_kwDODGgK6M66jjd8","user":{"login":"nirvedhmeshram","id":96096277,"node_id":"U_kgDOBbpQFQ","avatar_url":"https://avatars.githubusercontent.com/u/96096277?v=4","gravatar_id":"","url":"https://api.github.com/users/nirvedhmeshram","html_url":"https://github.com/nirvedhmeshram","followers_url":"https://api.github.com/users/nirvedhmeshram/followers","following_url":"https://api.github.com/users/nirvedhmeshram/following{/other_user}","gists_url":"https://api.github.com/users/nirvedhmeshram/gists{/gist_id}","starred_url":"https://api.github.com/users/nirvedhmeshram/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nirvedhmeshram/subscriptions","organizations_url":"https://api.github.com/users/nirvedhmeshram/orgs","repos_url":"https://api.github.com/users/nirvedhmeshram/repos","events_url":"https://api.github.com/users/nirvedhmeshram/events{/privacy}","received_events_url":"https://api.gith