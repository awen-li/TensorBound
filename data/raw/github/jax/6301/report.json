s://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"}],"author_association":"NONE","body":"The following code segment results in any jax operations hanging indefinitely on a TPU colab.\r\n\r\nNote that the expected shape is incorrect in the host_callback. It does not report an error. But subsequent jax operations do not return.\r\n\r\n```\r\nimport flax\r\nimport flax.linen as nn\r\n\r\nfrom colabtools import googlelog\r\n\r\nimport jax\r\nimport jax.numpy as jnp\r\nfrom jax.experimental import host_callback as hcb\r\n\r\nimport numpy as np\r\n\r\ndef host_fn(x):\r\n  return 2.0 * x\r\n\r\nclass MyModel(nn.Module):\r\n\r\n  @nn.compact\r\n  def __call__(self, x):\r\n    x = nn.Conv(32, (3, 3))(x)\r\n    x = hcb.call(host_fn, x,\r\n                 result_shape=jax.ShapeDtypeStruct([5, 64, 128, 31], x.dtype))\r\n    return x\r\n\r\nmodel = MyModel()\r\n\r\nrng = jax.random.PRNGKey(0)\r\nrng, init_rng, model_rng = jax.random.split(rng, num=3)\r\ninit_inputs = jnp.ones([5, 64, 128, 3], jnp.float32)\r\n\r\nwith googlelog.CaptureLog():\r\n  initial_variables = model.init(\r\n      {\"params\": model_rng, \"state_init\": init_rng},\r\n      init_inputs)\r\n\r\njax.random.PRNGKey(0)  # Hangs indefinitely here. The same would happen for jnp.zeros(5).\r\n```\r\n\r\nOn single GPU things work as expected. It returns a \r\n```\r\nRuntimeError: Internal: RET_CHECK failure (third_party/tensorflow/compiler/xla/service/gpu/infeed_thunk.cc:53) ShapeUtil::Equal(dest_slices_[index].shape, source_shape) Mismatch between infeed source buffer shape s8[12345]{0} and infeed dest buffer shape f32[5,64,128,31]{3,2,1,0}\r\n```","closed_at":"2025-04-07T08:07:54Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/3890983?v=4","events_url":"https://api.github.com/users/gnecula/events{/privacy}","followers_url":"https://api.github.com/users/gnecula/followers","following_url":"https://api.github.com/users/gnecula/following{/other_user}","gists_url":"https://api.github.com/users/gnecula/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/gnecula","id":3890983,"login":"gnecula","node_id":"MDQ6VXNlcjM4OTA5ODM=","organizations_url":"https://api.github.com/users/gnecula/orgs","received_events_url":"https://api.github.com/users/gnecula/received_events","repos_url":"https://api.github.com/users/gnecula/repos","site_admin":false,"starred_url":"https://api.github.com/users/gnecula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gnecula/subscriptions","type":"User","url":"https://api.github.com/users/gnecula","user_view_type":"public"},"comments":3,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/6301/comments","created_at":"2021-03-31T14:11:47Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/6301/events","html_url":"https://github.com/jax-ml/jax/issues/6301","id":846744557,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/6301/labels{/name}","locked":false,"milestone":null,"node_id":"MDU6SXNzdWU4NDY3NDQ1NTc=","number":6301,"performed_via_github_app":null,"pinned_comment":null,