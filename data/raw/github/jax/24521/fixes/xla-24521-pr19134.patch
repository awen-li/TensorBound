   friend H AbslHashValue(H h, const BatchedCopyToDeviceWithShardingKey& key) {
     return H::combine(std::move(h), key.src_devices, key.src_memory_kind,
-                      key.dst_devices, key.dst_memory_kind);
+                      key.dst_devices, key.dst_memory_kind,
+                      key.array_copy_semantics);
   }
 };
 
