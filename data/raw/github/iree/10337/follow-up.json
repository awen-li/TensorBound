fication_commit_wait does return false if the\nfutex syscall returns an expected error code, so we need to handle the\nexhaustive list of return codes that might come out of this syscall. The\nmanual page lists only very few possible return codes for the particular\nFUTEX_WAIT op we're doing here (there are plenty of error cases, but few\napply to FUTEX_WAIT). EINTR is the only one that I could see us missing\nhere.","tree":{"sha":"240789d961f8bcdd6f6e36242c7316f8606b3b77","url":"https://api.github.com/repos/bjacob/iree/git/trees/240789d961f8bcdd6f6e36242c7316f8606b3b77"},"url":"https://api.github.com/repos/bjacob/iree/git/commits/5f6457876bf676c1180f4529cb8f0985daa88e75","verification":{"payload":null,"reason":"unsigned","signature":null,"verified":false,"verified_at":null}},"committer":{"avatar_url":"https://avatars.githubusercontent.com/u/79535?v=4","events_url":"https://api.github.com/users/bjacob/events{/privacy}","followers_url":"https://api.github.com/users/bjacob/followers","following_url":"https://api.github.com/users/bjacob/following{/other_user}","gists_url":"https://api.github.com/users/bjacob/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/bjacob","id":79535,"login":"bjacob","node_id":"MDQ6VXNlcjc5NTM1","organizations_url":"https://api.github.com/users/bjacob/orgs","received_events_url":"https://api.github.com/users/bjacob/received_events","repos_url":"https://api.github.com/users/bjacob/repos","site_admin":false,"starred_url":"https://api.github.com/users/bjacob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bjacob/subscriptions","type":"User","url":"https://api.github.com/users/bjacob","user_view_type":"public"},"files":[{"additions":1,"blob_url":"https://github.com/bjacob/iree/blob/5f6457876bf676c1180f4529cb8f0985daa88e75/runtime%2Fsrc%2Firee%2Fbase%2Finternal%2Fsynchronization.c","changes":2,"contents_url":"https://api.github.com/repos/bjacob/iree/contents/runtime%2Fsrc%2Firee%2Fbase%2Finternal%2Fsynchroni