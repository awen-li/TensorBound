reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/860917549/reactions"},"updated_at":"2021-06-14T18:56:37Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/860917549","user":{"avatar_url":"https://avatars.githubusercontent.com/u/20912915?v=4","events_url":"https://api.github.com/users/mganahl/events{/privacy}","followers_url":"https://api.github.com/users/mganahl/followers","following_url":"https://api.github.com/users/mganahl/following{/other_user}","gists_url":"https://api.github.com/users/mganahl/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/mganahl","id":20912915,"login":"mganahl","node_id":"MDQ6VXNlcjIwOTEyOTE1","organizations_url":"https://api.github.com/users/mganahl/orgs","received_events_url":"https://api.github.com/users/mganahl/received_events","repos_url":"https://api.github.com/users/mganahl/repos","site_admin":false,"starred_url":"https://api.github.com/users/mganahl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mganahl/subscriptions","type":"User","url":"https://api.github.com/users/mganahl","user_view_type":"public"}},{"author_association":"NONE","body":"Here is a minimal example that demonstrates the OOM issues we are seeing. \r\n\r\n``` python \r\nfrom cloud_tpu_client import Client                                                  \r\nimport jax\r\nimport numpy as np\r\n\r\ntpu_name = 'fill me in'   # name of the tpu in the 2VM setup\r\nc = Client(tpu_name)                                                                           \r\nc.configure_tpu_version('tpu_driver0.1-dev20210603') # code below crashes with OOM error with this driver\r\n# c.configure_tpu_version('tpu_driver0.1-dev20200911') #code below works with this drivers\r\ntpu_address = \"fill me in\" #network endpoint in the 2VM setup\r\njax.config.update(\"jax_backend_target\", 'grpc://' + tpu_address)\r\njax.config.update(\"jax_xla_backend\", 'tpu_driver')\r\n\r\n@jax.partial(jax.pmap, static_broadcasted_argnums = (1,2))\r\ndef random_contract(gate, nsteps, N):\r\n    np.random.seed(0)\r\n    shape = (2,)*(N-13) + (8,128)\r\n    state = jnp.ones(shape)\r\n    for n in range(nsteps):\r\n       # pick random axes to contract\r\n        axes = tuple(np.random.choice(np.arange(len(shape) - 2), size=7, replace=False))\r\n        other = tuple(sorted(set(range(len(shape))) - set(axes)))\r\n        perm = axes + other\r\n        new_shape = (128,) + (2,) * (len(shape) - 2 - 7) + (8,128)\r\n\r\n       # move contracted axes to the front of the array\r\n        state = state.transpose(perm).reshape(new_shape)\r\n\r\n       # contract and reshape\r\n        state = jnp.tensordot(gate, state, (1,0))\r\n        state = state.reshape(shape)\r\n    return state\r\n\r\n# this may or may not crash depending on the driver\r\nfinal_state = random_contract(np.random.rand(8,128,128), 100,32) \r\n```\r\nI'm wondering if the OOM errors are related to the compilation. The compilation times here are quite substantial (around 15 min).","created_at":"2021-06-15T09:13:00Z","html_url":"https://github.com/jax-ml/jax/issues/6935#issuecomment-861331699","id":861331699,"issue_url":"https://api.github.com/repos/jax-ml/jax/issues/6935","minimized":null,"node_id":"MDEyOklzc3VlQ29tbWVudDg2MTMzMTY5OQ==","performed_via_github_app":null,"pin":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/comments/861331699/reactions"},"updated_at":"2021-06-15T09:13:33Z","url":"https://api.github.com/repos/jax-ml/jax/issues/comments/861331699","user":{"avatar_url":"https://avatars.githubusercontent.com/u/20912915?v=4","events_url":"https://api.github.com/users/mganahl/events{/privacy}","followers_url":"https://api.github.com/users/mganahl/followers","following_url":"https://api.github.com/users/mganahl/following{/other_user}","gists_url":"https://api.github.com/users/mganahl/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/mganahl","id":20912915,"login":"mganahl","node_id":"MDQ6VXNlcjIwOTEyOTE1","organizations_url":"https://api.github.com/users/mganahl/orgs","received_events_url":"https://api.github.com/users/mganahl/received_events","repos_url":"https://api.github.com/users/mganahl/repos","site_admin":false,"starred_url":"https://api.github.com/users/mganahl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mganahl/subscriptions","type":"User","url":"https://api.github.com/users/mganahl","user_view_type":"public"}}],"issue":{"active_lock_reason":null,"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/88808?v=4","events_url":"https://api.github.com/users/skye/events{/privacy}","followers_url":"https://api.github.com/users/skye/followers","following_url":"https://api.github.com/users/skye/following{/other_user}","gists_url":"https://api.github.com/users/skye/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/skye","id":88808,"login":"skye","node_id":"MDQ6VXNlcjg4ODA4","organizations_url":"https://api.github.com/users/skye/orgs","received_events_url":"https://api.github.com/users/skye/received_events","repos_url":"https://api.github.com/users/skye/repos","site_admin":false,"starred_url":"https://api.github.com/users/skye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/skye/subscriptions","type":"User","url":"https://api.github.com/users/skye","user_view_type":"public"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/88808?v=4","events_url":"https://api.github.com/users/skye/events{/privacy}","followers_url":"https://api.github.com/users/skye/followers","following_url":"https://api.github.com/users/skye/following{/other_user}","gists_url":"https://api.github.com/users/skye/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/skye","id":88808,"login":"skye","node_id":"MDQ6VXNlcjg4ODA4","organizations_url":"https://api.github.com/users/skye/orgs","received_events_url":"https://api.github.com/users/skye/received_events","repos_url":"https://api.github.com/users/skye/repos","site_admin":false,"starred_url":"https://api.github.com/users/skye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/skye/subscriptions","type":"User","url":"https://api.github.com/users/skye","user_view_type":"public"}],"author_association":"NONE","body":"Hi!\r\n\r\nWe are hitting an issue when using `pswapaxes` (same issue persist when using `all_to_all`) in the 2VM setup with  particular drivers (see below). The call to `pswapaxes` hangs indefinitely if the number of indices of the core-local array is 2. \r\n\r\nThe issue only arises for certain software versions of the tpu-driver. In particular, `'tpu_driver_nightly'` works, but we can't use that driver in our application because it has other issues.\r\n\r\nThe behaviour seems to first appear with `jaxlib==0.1.60` and `jax==0.2.8` and is persisting since.\r\n\r\nThanks!\r\n\r\n```python\r\nfrom cloud_tpu_client import Client                                                  \r\nimport jax\r\nimport numpy as np\r\n\r\ntpu_name = 'fill me in'   # name of the tpu in the 2VM setup\r\nc = Client(tpu_name)                                                                           \r\nc.configure_tpu_version('tpu_driver0.1-dev20200911')\r\n#c.configure_tpu_version('tpu_driver0.1-dev20200320') #has the same issue\r\n# tpu_driver_nightly works, but we can't use it because of it has other issues\r\n\r\ntpu_address = \"fill me in\" #network endpoint in the 2VM setup\r\njax.config.update(\"jax_backend_target\", 'grpc://' + tpu_address)\r\njax.config.update(\"jax_xla_backend\", 'tpu_driver')\r\n\r\nswap = jax.pmap(lambda x: jax.lax.pswapaxes(x, \"i\", 0), axis_name='i')\r\nres = swap(np.random.rand(8,8,2,5)) # works fine\r\nres = swap(np.random.rand(8,8,10)) # hangs indefinitely\r\n```","closed_at":null,"closed_by":null,"comments":5,"comments_url":"https://api.github.com/repos/jax-ml/jax/issues/6935/comments","created_at":"2021-06-10T07:39:18Z","events_url":"https://api.github.com/repos/jax-ml/jax/issues/6935/events","html_url":"https://github.com/jax-ml/jax/issues/6935","id":917018495,"issue_dependencies_summary":{"blocked_by":0,"blocking":0,"total_blocked_by":0,"total_blocking":0},"issue_field_values":[],"labels":[{"archived_at":null,"archived_by":null,"color":"d73a4a","default":true,"description":"Something isn't working","id":1104782284,"name":"bug","node_id":"MDU6TGFiZWwxMTA0NzgyMjg0","url":"https://api.github.com/repos/jax-ml/jax/labels/bug"},{"archived_at":null,"archived_by":null,"color":"2A9ECB","default":false,"description":"This ought to be addressed, but has no schedule at the moment. (Assignee optional)","id":2995429402,"name":"P2 (eventual)","node_id":"MDU6TGFiZWwyOTk1NDI5NDAy","url":"https://api.github.com/repos/jax-ml/jax/labels/P2%20(eventual)"}],"labels_url":"https://api.github.com/repos/jax-ml/jax/issues/6935/labels{/name}","locked":false,"milestone":null,"node_id":"MDU6SXNzdWU5MTcwMTg0OTU=","number":6935,"performed_via_github_app":null,"pinned_comment":null,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/jax-ml/jax/issues/6935/reactions"},"repository_url":"https://api.github.com/repos/jax-ml/jax","state":"open","state_reason":null,"sub_issues_summary":{"completed":0,"percent_completed":0,"total":0},"timeline_url":"https://api.github.com/repos/jax-ml/jax/issues/6935/timeline","title":"pswapaxes hanging for input arrays with local ndim=2","type":null,"updated_at":"2021-06-15T09:13:33Z","url":"https://api.github.com/repos/jax-ml/jax/issues/6935","user":{"avatar_url":"https://avatars.githubusercontent.com/u/20912915?v=4","events_url":"https://api.github.com/users/mganahl/events{/privacy}","followers_url":"https://api.github.com/us