)[0])\r\nx1 = device_put(data, device=devices()[1])\r\n\r\nf0 = jit(f, device=devices()[0])\r\nprint(\"f on gpu 0:\", f0(x0))\r\n\r\nf1 = jit(f, device=devices()[1])\r\nprint(\"f on gpu 1:\", f1(x1))\r\n````\r\n\r\nOn my machine, there are errors like these\r\n```\r\nf on gpu 0: 4993.7783\r\n2020-04-15 13:59:45.496271: E external/org_tensorflow/tensorflow/compiler/xla/python/local_client.cc:758] Execution of replica 0 failed: Invalid argument: executable is built for device CUDA:0 of type \"GeForce RTX 2080 Ti\"; cannot run it on device CUDA:1 of type \"Tesla P100-PCIE-16GB\"\r\nTraceback (most recent call last):\r\n  File \"test3.py\", line 22, in <module>\r\n    print(\"f on gpu 1:\", f1(x1))\r\n  File \"/usr/local/lib/python3.6/dist-packages/jax/api.py\", line 150, in f_jitted\r\n    out = xla.xla_call(flat_fun, *args_flat, device=device, backend=backend)\r\n  File \"/usr/local/lib/python3.6/dist-packages/jax/core.py\", line 592, in call_bind\r\n    outs = primitive.impl(f, *args, **params)\r\n  File \"/usr/local/lib/python3.6/dist-packages/jax/interpreters/xla.py\", line 402, in _xla_call_impl\r\n    return compiled_fun(*args)\r\n  File \"/usr/local/lib/python3.6/dist-packages/jax/interpreters/xla.py\", line 486, in _execute_compiled\r\n    out_bufs = compiled.Execute(input_bufs).destructure()\r\nRuntimeError: Invalid argument: executable is built for device CUDA:0 of type \"GeForce RTX 2080 Ti\"; cannot run it on device CUDA:1 of type \"Tesla P100-PCIE-16GB\"\r\n```\r\nThere two gpu cards in my machine.\r\n```\r\n+-----------------------------------------------------------------------------+\r\n| NVIDIA-SMI 430.26       Driver Version: 430.26       CUDA Version: 10.2     |\r\n|-------------------------------+----------------------+----------------------+\r\n| GPU  Name        Persistence-M| Bus-Id        Disp.A | Volatile Uncorr. ECC |\r\n| Fan  Temp  Perf  Pwr:Usage/Cap|         Memory-Usage | GPU-Util  Compute M. |\r\n|===============================+======================+======================|\r\n|   0  GeForce RTX 208...  On   | 00000000:3B:00.0 Off |                  N/A |\r\n|  0%   38C    P8    15W / 280W |      0MiB / 11019MiB |      0%      Default |\r\n+-------------------------------+----------------------+----------------------+\r\n|   1  Tesla P100-PCIE...  On   | 00000000:AF:00.0 Off |                    0 |\r\n| N/A   37C    P0    27W / 250W |      0MiB / 16280MiB |      0%      Default |\r\n+-------------------------------+----------------------+----------------------+\r\n                                                                               \r\n+-----------------------------------------------------------------------------+\r\n| Processes:                                                       GPU Memory |\r\n|  GPU       PID   Type   Process name                             Usage      |\r\n|=============================================================================|\r\n|  No running processes found                                                 |\r\n+-----------------------------------------------------------------------------+\r\n```\r\n\r\nCould you give me some advice?","closed_at":"2020-04-16T17:38:39Z","closed_by":{"avatar_url":"https://avatars.githubusercontent.com/u/348932?v=4","events_url":"https://api.github.com/users/hawkinsp/events{/privacy}","followers_url":"https://api.github.com/users/hawkinsp/followers","following_url":"https://api.github.com/users/hawkinsp/following{/other_user}","gists_url":"https://api.github.com/users/hawkinsp/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/hawkinsp","id":348932,"login":"hawkinsp","node_id":"MDQ6VXNlcjM0ODkzMg==","organizations_url":"https://api.github.com/users/hawkinsp/orgs","received_events_url":"https://api.github.com/users/hawkinsp/received_events","repos_url":"https://api.github.com/users/hawkinsp/repos","site_admin":false,"starred_url":"https://api.github.com/users/hawkinsp/starred{/owner}{/repo}","subscriptions_url":